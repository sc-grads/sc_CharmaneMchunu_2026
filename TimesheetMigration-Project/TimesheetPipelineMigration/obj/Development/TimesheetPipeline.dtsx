                      <externalMetadataColumns />
                    </output>
                    <output
                      refId="Package\Loop through files\Transform\Conditional Split.Outputs[Conditional Split Error Output]"
                      description="Error Output of the Conditional Split Transformation"
                      exclusionGroup="1"
