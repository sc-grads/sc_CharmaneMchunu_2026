          DTS:Description="Execute SQL Task"
          DTS:DTSID="{1FA74188-60D2-4261-8937-05BDC24B2012}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Extract"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{564628C3-12EF-4931-8F46-AF6F516D1DFE}"
              SQLTask:SqlStatementSource="SELECT EmployeeID FROM dbo.Employee WHERE EmployeeName = ? AND EmployeeSurname = ?"
              SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
