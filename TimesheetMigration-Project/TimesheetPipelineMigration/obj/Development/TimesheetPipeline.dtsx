  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\Load data"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{B4E23B80-7532-4157-B7B4-B7F1858CDEAB}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load data">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Load data\Load"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{7C6E5A82-542F-48E6-8251-9D7093D21F8E}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Load"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{564628C3-12EF-4931-8F46-AF6F516D1DFE}"
              SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;BEGIN TRY&#xA;    DECLARE @BatchID INT;&#xA;    DECLARE @TotalStagingRecords INT;&#xA;    DECLARE @InsertedCount INT = 0;&#xA;    DECLARE @LeaveInsertedCount INT = 0;&#xA;    DECLARE @UpdatedCount INT = 0;&#xA;    DECLARE @StartTime DATETIME = GETDATE();&#xA;    DECLARE @EndTime DATETIME;&#xA;    DECLARE @Context VARBINARY(128);&#xA;&#xA;    -- Nothing to do? Exit quietly, same as the script task's early return.&#xA;    SELECT @TotalStagingRecords = COUNT(*)&#xA;    FROM dbo.StagingTimesheet&#xA;    WHERE IsProcessed = 0;&#xA;&#xA;    IF @TotalStagingRecords = 0&#xA;    BEGIN&#xA;        PRINT 'No unprocessed staging records found. Exiting.';&#xA;        RETURN;&#xA;    END&#xA;&#xA;    -- Generate BatchID from SEQUENCE&#xA;    SET @BatchID = NEXT VALUE FOR dbo.BatchIDSequence;&#xA;    SET @Context = CAST(@BatchID AS VARBINARY(128));&#xA;    SET CONTEXT_INFO @Context;&#xA;&#xA;    -- LOG: Migration STARTED&#xA;    INSERT INTO dbo.AuditLog (&#xA;        BatchID, TableName, OperationType, StatusCode,&#xA;        RowsInserted, RowsUpdated, RowsDeleted,&#xA;        HostName, ApplicationName, EventDateTime&#xA;    )&#xA;    VALUES (&#xA;        @BatchID, 'Migration', 'START', 'RUNNING',&#xA;        0, 0, 0,&#xA;        HOST_NAME(), 'SSIS_ETL', GETDATE()&#xA;    );&#xA;&#xA;    BEGIN TRANSACTION;&#xA;&#xA;    -- =====================================================&#xA;    -- STEP 1: Mark the new staging records with this run's&#xA;    -- BatchID FIRST, so Timesheet can be filtered on it below.&#xA;    -- =====================================================&#xA;    UPDATE dbo.StagingTimesheet&#xA;    SET IsProcessed = 1, ProcessedDate = GETDATE(), BatchID = @BatchID&#xA;    WHERE IsProcessed = 0;&#xA;&#xA;    SET @UpdatedCount = @@ROWCOUNT;&#xA;&#xA;    -- =====================================================&#xA;    -- STEP 2: REBUILD Timesheet from ONLY this run's newly&#xA;    -- processed batch (not the full staging history).&#xA;    -- Truncate wipes whatever was loaded by the previous run.&#xA;    -- =====================================================&#xA;    TRUNCATE TABLE dbo.Timesheet;&#xA;&#xA;    INSERT INTO dbo.Timesheet (&#xA;        EmployeeID, ClientID, Date, DayOfWeek,&#xA;        Description, BillableType, Duration,&#xA;        StartTime, EndTime, Comments, CreatedDate, ModifiedDate&#xA;    )&#xA;    SELECT&#xA;        s.EmployeeID,&#xA;        c.ClientID,&#xA;        TRY_CAST(s.Date AS DATE) AS Date,&#xA;        s.DayOfWeek,&#xA;        NULLIF(s.Description, '') AS Description,&#xA;        NULLIF(s.BillableType, '') AS BillableType,&#xA;        CONVERT(VARCHAR(8), TRY_CAST(s.TotalHours AS TIME), 108) AS Duration,&#xA;        TRY_CAST(s.StartTime AS TIME) AS StartTime,&#xA;        TRY_CAST(s.EndTime AS TIME) AS EndTime,&#xA;        NULLIF(s.Comments, '') AS Comments,&#xA;        GETDATE() AS CreatedDate,&#xA;        NULL AS ModifiedDate&#xA;    FROM dbo.StagingTimesheet s&#xA;    LEFT JOIN dbo.Client c ON c.ClientName = s.Client&#xA;    WHERE s.BatchID = @BatchID&#xA;      AND s.IsProcessed = 1&#xA;      AND TRY_CAST(s.Date AS DATE) IS NOT NULL&#xA;      AND UPPER(LTRIM(RTRIM(s.DayOfWeek))) NOT IN ('SATURDAY', 'SUNDAY')&#xA;      AND NOT EXISTS (&#xA;          SELECT 1&#xA;          FROM dbo.LeaveCategory lc&#xA;          WHERE UPPER(LTRIM(RTRIM(s.Description))) = UPPER(LTRIM(RTRIM(lc.SourceText)))&#xA;            AND lc.LeaveType NOT IN ('Public Holiday', 'Family Responsibility Leave')&#xA;      );&#xA;&#xA;    SET @InsertedCount = @@ROWCOUNT;&#xA;&#xA;    -- =====================================================&#xA;    -- STEP 3: INSERT into Leave for this batch only&#xA;    -- (excludes Public Holiday / Family Responsibility Leave)&#xA;    -- =====================================================&#xA;    INSERT INTO dbo.[Leave] (&#xA;        EmployeeID, LeaveType, StartDate, EndDate, LeaveDays,&#xA;        Comments, CreatedDate, ModifiedDate&#xA;    )&#xA;    SELECT&#xA;        s.EmployeeID,&#xA;        lc.LeaveType,&#xA;        TRY_CAST(s.Date AS DATE) AS StartDate,&#xA;        TRY_CAST(s.Date AS DATE) AS EndDate,&#xA;        CASE&#xA;            WHEN TRY_CAST(s.TotalHours AS DECIMAL(10,2)) IS NOT NULL&#xA;            THEN TRY_CAST(s.TotalHours AS DECIMAL(10,2))&#xA;            ELSE 1&#xA;        END AS LeaveDays,&#xA;        NULLIF(s.Comments, '') AS Comments,&#xA;        GETDATE() AS CreatedDate,&#xA;        NULL AS ModifiedDate&#xA;    FROM dbo.StagingTimesheet s&#xA;    INNER JOIN dbo.LeaveCategory lc&#xA;        ON UPPER(LTRIM(RTRIM(s.Description))) = UPPER(LTRIM(RTRIM(lc.SourceText)))&#xA;    WHERE s.BatchID = @BatchID&#xA;      AND s.IsProcessed = 1&#xA;      AND TRY_CAST(s.Date AS DATE) IS NOT NULL&#xA;      AND lc.LeaveType NOT IN ('Public Holiday', 'Family Responsibility Leave');&#xA;&#xA;    SET @LeaveInsertedCount = @@ROWCOUNT;&#xA;&#xA;    COMMIT TRANSACTION;&#xA;&#xA;    SET @EndTime = GETDATE();&#xA;&#xA;    -- =====================================================&#xA;    -- STEP 4: LOG results (Timesheet / Leave / Staging update)&#xA;    -- =====================================================&#xA;    IF @InsertedCount &gt; 0&#xA;        INSERT INTO dbo.AuditLog (BatchID, TableName, OperationType, StatusCode, RowsInserted, RowsUpdated, RowsDeleted, HostName, ApplicationName, EventDateTime)&#xA;        VALUES (@BatchID, 'Timesheet', 'INSERT', 'SUCCESS', @InsertedCount, 0, 0, HOST_NAME(), 'SSIS_ETL', GETDATE());&#xA;&#xA;    IF @LeaveInsertedCount &gt; 0&#xA;        INSERT INTO dbo.AuditLog (BatchID, TableName, OperationType, StatusCode, RowsInserted, RowsUpdated, RowsDeleted, HostName, ApplicationName, EventDateTime)&#xA;        VALUES (@BatchID, 'Leave', 'INSERT', 'SUCCESS', @LeaveInsertedCount, 0, 0, HOST_NAME(), 'SSIS_ETL', GETDATE());&#xA;&#xA;    IF @UpdatedCount &gt; 0&#xA;        INSERT INTO dbo.AuditLog (BatchID, TableName, OperationType, StatusCode, RowsInserted, RowsUpdated, RowsDeleted, HostName, ApplicationName, EventDateTime)&#xA;        VALUES (@BatchID, 'StagingTimesheet', 'UPDATE', 'SUCCESS', 0, @UpdatedCount, 0, HOST_NAME(), 'SSIS_ETL', GETDATE());&#xA;&#xA;    -- LOG: Migration COMPLETED&#xA;    INSERT INTO dbo.AuditLog (BatchID, TableName, OperationType, StatusCode, RowsInserted, RowsUpdated, RowsDeleted, HostName, ApplicationName, EventDateTime)&#xA;    VALUES (@BatchID, 'Migration', 'COMPLETE', 'SUCCESS', @InsertedCount + @LeaveInsertedCount, @UpdatedCount, 0, HOST_NAME(), 'SSIS_ETL', GETDATE());&#xA;&#xA;    SET CONTEXT_INFO 0x00000000;&#xA;&#xA;    -- Summary result set (visible in Execute SQL Task if ResultSet = &quot;Single row&quot; and mapped to variables)&#xA;    SELECT&#xA;        @BatchID AS BatchID,&#xA;        @InsertedCount AS TimesheetRecordsInserted,&#xA;        @LeaveInsertedCount AS LeaveRecordsInserted,&#xA;        @TotalStagingRecords AS TotalRecords,&#xA;        @UpdatedCount AS StagingRecordsUpdated,&#xA;        DATEDIFF(MILLISECOND, @StartTime, @EndTime) AS ProcessingTimeMs;&#xA;&#xA;END TRY&#xA;BEGIN CATCH&#xA;    IF @@TRANCOUNT &gt; 0 ROLLBACK TRANSACTION;&#xA;&#xA;    DECLARE @ErrMsg NVARCHAR(4000) = ERROR_MESSAGE();&#xA;    DECLARE @ErrBatchID INT = ISNULL(@BatchID, -1);&#xA;&#xA;    INSERT INTO dbo.AuditLog (&#xA;        BatchID, TableName, OperationType, StatusCode,&#xA;        RowsInserted, RowsUpdated, RowsDeleted,&#xA;        HostName, ApplicationName, EventDateTime, ErrorMessage&#xA;    )&#xA;    VALUES (&#xA;        @ErrBatchID, 'Migration', 'ERROR', 'FAILED',&#xA;        0, 0, 0,&#xA;        HOST_NAME(), 'SSIS_ETL', GETDATE(), @ErrMsg&#xA;    );&#xA;&#xA;    THROW;&#xA;END CATCH" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Loop through files"
