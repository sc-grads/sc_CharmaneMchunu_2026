              <ProjectItem
                Name="ScriptMain.cs"
                Encoding="UTF8"><![CDATA[#region Namespaces
using System;
using System.Collections.Generic;
using System.Data;
using System.IO;
using System.Windows.Forms;
using Microsoft.SqlServer.Dts.Runtime;
#endregion

namespace ST_e6c80ceb23674a6c8ef0b9f3b7acae61
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        private bool boolVariable;

        public void Main()
        {
            try
            {
                // ============================================
                // STEP 1: GET ROOT FOLDER FROM PROJECT PARAMETER
                // ============================================
                string rootFolder = (string)Dts.Variables["$Project::RootFolder"].Value;

                if (!Directory.Exists(rootFolder))
                {
                    Dts.Events.FireError(
                        0,
                        "Folder Not Found",
                        $"Root folder does not exist: {rootFolder}",
                        string.Empty,
                        0);
                    Dts.TaskResult = (int)ScriptResults.Failure;
                    return;
                }

                // ============================================
                // STEP 2/3: FILE PATH ALREADY FULLY QUALIFIED
                // ============================================
                // The ForEachFileEnumerator is configured with
                // FileNameRetrievalType="0" (fully qualified), so
                // User::FilePath already contains the complete absolute
                // path to the file - no need to search for it. Passing
                // an absolute path into Directory.GetFiles as a search
                // pattern throws "Second path fragment must not be a
                // drive or UNC name", which is why the old search-based
                // approach failed.
                string fullPath = Dts.Variables["User::FilePath"].Value.ToString();

                if (!File.Exists(fullPath))
                {
                    Dts.Events.FireError(0, "File Not Found",
                        $"File not found: {fullPath}",
                        string.Empty, 0);
                    Dts.TaskResult = (int)ScriptResults.Failure;
                    return;
                }

                Dts.Events.FireInformation(0, "Processing",
                    $"Processing file: {fullPath}",
                    string.Empty, 0, ref boolVariable);

                // ============================================
                // STEP 4: EXTRACT EMPLOYEE NAME FROM FOLDER NAME
                // ============================================
                string folderName = Path.GetFileName(Path.GetDirectoryName(fullPath));
                string employeeName = folderName;

                // Remove "Timesheet" suffix if present
                if (employeeName.EndsWith("Timesheet", StringComparison.OrdinalIgnoreCase) && employeeName.Length > 9)
                {
                    employeeName = employeeName.Substring(0, employeeName.Length - 9);
                }

                // ============================================
                // STEP 5: EMPLOYEE ID LOOKUP (business logic – can stay hard‑coded)
                // ============================================
                var employeeMap = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase)
                {
                    // Full names
                    {"Buhle", 1001},
                    {"Charmane", 1002},
                    {"Jabulane", 1003},
                    {"Kayden", 1004},
                    {"Lwazisile", 1005},
                    {"Rushil", 1006},
                    {"Shriya", 1007},
                    {"Teolan", 1008},
                    // Folder names with 's'
                    {"Buhles", 1001},
                    {"Charmanes", 1002},
                    {"Jabulanes", 1003},
                    {"Kaydens", 1004},
                    {"Lwazis", 1005},
                    {"Rushils", 1006},
                    {"Shriyas", 1007},
                    {"Teolans", 1008},
                    // Short names / variations
                    {"Lwazi", 1005}
                };

                int employeeID = 9999; // default for unknown
                if (employeeMap.ContainsKey(employeeName))
                {
                    employeeID = employeeMap[employeeName];
                }

                // ============================================
                // STEP 6: EXTRACT MONTH FROM FILE NAME
                // ============================================
                string fileNameOnly = Path.GetFileNameWithoutExtension(fullPath);
                string month = "";

                if (fileNameOnly.Contains("March") || fileNameOnly.Contains("Mar"))
                    month = "Mar";
                else if (fileNameOnly.Contains("April") || fileNameOnly.Contains("Apr"))
                    month = "Apr";
                else if (fileNameOnly.Contains("May"))
                    month = "May";
                else
                {
                    Dts.Events.FireError(0, "Month Not Found",
                        $"Could not extract month from: {fileNameOnly}",
                        string.Empty, 0);
                    Dts.TaskResult = (int)ScriptResults.Failure;
                    return;
                }

                // ============================================
                // STEP 7: BUILD SHEET NAME (with $)
                // ============================================
                string sheetNameTimesheet = month + "$";

                // ============================================
                // STEP 8: WRITE TO SSIS VARIABLES
                // ============================================
                Dts.Variables["User::FullFilePath"].Value = fullPath;
                Dts.Variables["User::EmployeeName"].Value = employeeName;
                Dts.Variables["User::EmployeeID"].Value = employeeID;
                Dts.Variables["User::Month"].Value = month;
                Dts.Variables["User::SheetName"].Value = sheetNameTimesheet;
                Dts.Variables["User::SheetNameTimesheet"].Value = sheetNameTimesheet;

                // ============================================
                // STEP 9: LOGGING
                // ============================================
                Dts.Events.FireInformation(0, "Extract Info",
                    $"Employee: {employeeName} (ID: {employeeID}) | Month: {month} | Sheet: {sheetNameTimesheet} | File: {fullPath}",
                    string.Empty, 0, ref boolVariable);

                Dts.TaskResult = (int)ScriptResults.Success;
            }
            catch (Exception ex)
            {
                Dts.Events.FireError(0, "Script Error",
                    $"Error: {ex.Message}",
                    string.Empty, 0);
                Dts.TaskResult = (int)ScriptResults.Failure;
            }
        }

        #region ScriptResults declaration
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion
    }
}]]></ProjectItem>
