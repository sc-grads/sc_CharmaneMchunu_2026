          DTS:LogicalAnd="True"
          DTS:ObjectName="Constraint"
          DTS:To="Package\Schema\Tables" />
      </DTS:PrecedenceConstraints>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Trigger"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{7B79E0CE-33C4-40E9-9B44-F9CC9E1ABCF1}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="Trigger">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Trigger\Trigger"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{C9053FC4-3838-4C76-82E2-0DA052E161A9}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Trigger"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{6F89F51A-3C39-45A0-A2E9-0FD1C838B189}"
              SQLTask:SqlStatementSource="USE TimesheetCMDB;&#xA;GO&#xA;&#xA;-- ============================================================&#xA;-- 1. Add ModifiedDate to LeaveCategory (&quot;leave type&quot; table)&#xA;--    Employee, Timesheet, and Leave already have this column.&#xA;-- ============================================================&#xA;IF NOT EXISTS (&#xA;    SELECT 1 FROM sys.columns&#xA;    WHERE object_id = OBJECT_ID('dbo.LeaveCategory') AND name = 'ModifiedDate'&#xA;)&#xA;    ALTER TABLE dbo.LeaveCategory ADD ModifiedDate DATETIME NULL;&#xA;GO&#xA;&#xA;-- ============================================================&#xA;-- 2. TRIGGER: Employee&#xA;-- ============================================================&#xA;DROP TRIGGER IF EXISTS dbo.trg_Employee_Audit;&#xA;GO&#xA;CREATE TRIGGER dbo.trg_Employee_Audit&#xA;ON dbo.Employee&#xA;AFTER UPDATE&#xA;AS&#xA;BEGIN&#xA;    SET NOCOUNT ON;&#xA;&#xA;    DECLARE @BatchID INT;&#xA;    DECLARE @ContextInfo VARBINARY(128) = CONTEXT_INFO();&#xA;    IF @ContextInfo IS NOT NULL AND @ContextInfo != 0x00000000&#xA;        SET @BatchID = CONVERT(INT, @ContextInfo);&#xA;    IF @BatchID IS NULL OR @BatchID = 0&#xA;        SET @BatchID = -1;&#xA;&#xA;    -- Stamp ModifiedDate on the rows that changed&#xA;    UPDATE e&#xA;    SET ModifiedDate = GETDATE()&#xA;    FROM dbo.Employee e&#xA;    INNER JOIN inserted i ON e.EmployeeID = i.EmployeeID;&#xA;&#xA;    BEGIN TRY&#xA;        INSERT INTO dbo.AuditLog (BatchID, TableName, OperationType, StatusCode, RowsUpdated, HostName, ApplicationName, EventDateTime)&#xA;        SELECT @BatchID, 'Employee', 'UPDATE', 'SUCCESS', COUNT(*), HOST_NAME(), APP_NAME(), GETDATE()&#xA;        FROM inserted;&#xA;    END TRY&#xA;    BEGIN CATCH&#xA;        INSERT INTO dbo.AuditLog (BatchID, TableName, OperationType, StatusCode, HostName, ApplicationName, EventDateTime, ErrorMessage)&#xA;        VALUES (@BatchID, 'Employee', 'TRIGGER_ERROR', 'FAILED', HOST_NAME(), APP_NAME(), GETDATE(), ERROR_MESSAGE());&#xA;    END CATCH&#xA;END;&#xA;GO&#xA;&#xA;-- ============================================================&#xA;-- 3. TRIGGER: Timesheet (replaces the old trg_Timesheet_Audit,&#xA;--    which never set ModifiedDate)&#xA;-- ============================================================&#xA;DROP TRIGGER IF EXISTS dbo.trg_Timesheet_Audit;&#xA;GO&#xA;CREATE TRIGGER dbo.trg_Timesheet_Audit&#xA;ON dbo.Timesheet&#xA;AFTER UPDATE&#xA;AS&#xA;BEGIN&#xA;    SET NOCOUNT ON;&#xA;&#xA;    DECLARE @BatchID INT;&#xA;    DECLARE @ContextInfo VARBINARY(128) = CONTEXT_INFO();&#xA;    IF @ContextInfo IS NOT NULL AND @ContextInfo != 0x00000000&#xA;        SET @BatchID = CONVERT(INT, @ContextInfo);&#xA;    IF @BatchID IS NULL OR @BatchID = 0&#xA;        SET @BatchID = -1;&#xA;&#xA;    UPDATE t&#xA;    SET ModifiedDate = GETDATE()&#xA;    FROM dbo.Timesheet t&#xA;    INNER JOIN inserted i ON t.TimesheetID = i.TimesheetID;&#xA;&#xA;    BEGIN TRY&#xA;        INSERT INTO dbo.AuditLog (BatchID, TableName, OperationType, StatusCode, RowsUpdated, HostName, ApplicationName, EventDateTime)&#xA;        SELECT @BatchID, 'Timesheet', 'UPDATE', 'SUCCESS', COUNT(*), HOST_NAME(), APP_NAME(), GETDATE()&#xA;        FROM inserted;&#xA;    END TRY&#xA;    BEGIN CATCH&#xA;        INSERT INTO dbo.AuditLog (BatchID, TableName, OperationType, StatusCode, HostName, ApplicationName, EventDateTime, ErrorMessage)&#xA;        VALUES (@BatchID, 'Timesheet', 'TRIGGER_ERROR', 'FAILED', HOST_NAME(), APP_NAME(), GETDATE(), ERROR_MESSAGE());&#xA;    END CATCH&#xA;END;&#xA;GO&#xA;&#xA;-- ============================================================&#xA;-- 4. TRIGGER: Leave (bracketed [Leave] - reserved keyword)&#xA;-- ============================================================&#xA;DROP TRIGGER IF EXISTS dbo.trg_Leave_Audit;&#xA;GO&#xA;CREATE TRIGGER dbo.trg_Leave_Audit&#xA;ON dbo.[Leave]&#xA;AFTER UPDATE&#xA;AS&#xA;BEGIN&#xA;    SET NOCOUNT ON;&#xA;&#xA;    DECLARE @BatchID INT;&#xA;    DECLARE @ContextInfo VARBINARY(128) = CONTEXT_INFO();&#xA;    IF @ContextInfo IS NOT NULL AND @ContextInfo != 0x00000000&#xA;        SET @BatchID = CONVERT(INT, @ContextInfo);&#xA;    IF @BatchID IS NULL OR @BatchID = 0&#xA;        SET @BatchID = -1;&#xA;&#xA;    UPDATE l&#xA;    SET ModifiedDate = GETDATE()&#xA;    FROM dbo.[Leave] l&#xA;    INNER JOIN inserted i ON l.LeaveID = i.LeaveID;&#xA;&#xA;    BEGIN TRY&#xA;        INSERT INTO dbo.AuditLog (BatchID, TableName, OperationType, StatusCode, RowsUpdated, HostName, ApplicationName, EventDateTime)&#xA;        SELECT @BatchID, 'Leave', 'UPDATE', 'SUCCESS', COUNT(*), HOST_NAME(), APP_NAME(), GETDATE()&#xA;        FROM inserted;&#xA;    END TRY&#xA;    BEGIN CATCH&#xA;        INSERT INTO dbo.AuditLog (BatchID, TableName, OperationType, StatusCode, HostName, ApplicationName, EventDateTime, ErrorMessage)&#xA;        VALUES (@BatchID, 'Leave', 'TRIGGER_ERROR', 'FAILED', HOST_NAME(), APP_NAME(), GETDATE(), ERROR_MESSAGE());&#xA;    END CATCH&#xA;END;&#xA;GO&#xA;&#xA;-- ============================================================&#xA;-- 5. TRIGGER: LeaveCategory (&quot;leave type&quot; table)&#xA;-- ============================================================&#xA;DROP TRIGGER IF EXISTS dbo.trg_LeaveCategory_Audit;&#xA;GO&#xA;CREATE TRIGGER dbo.trg_LeaveCategory_Audit&#xA;ON dbo.LeaveCategory&#xA;AFTER UPDATE&#xA;AS&#xA;BEGIN&#xA;    SET NOCOUNT ON;&#xA;&#xA;    DECLARE @BatchID INT;&#xA;    DECLARE @ContextInfo VARBINARY(128) = CONTEXT_INFO();&#xA;    IF @ContextInfo IS NOT NULL AND @ContextInfo != 0x00000000&#xA;        SET @BatchID = CONVERT(INT, @ContextInfo);&#xA;    IF @BatchID IS NULL OR @BatchID = 0&#xA;        SET @BatchID = -1;&#xA;&#xA;    UPDATE lc&#xA;    SET ModifiedDate = GETDATE()&#xA;    FROM dbo.LeaveCategory lc&#xA;    INNER JOIN inserted i ON lc.LeaveCategoryID = i.LeaveCategoryID;&#xA;&#xA;    BEGIN TRY&#xA;        INSERT INTO dbo.AuditLog (BatchID, TableName, OperationType, StatusCode, RowsUpdated, HostName, ApplicationName, EventDateTime)&#xA;        SELECT @BatchID, 'LeaveCategory', 'UPDATE', 'SUCCESS', COUNT(*), HOST_NAME(), APP_NAME(), GETDATE()&#xA;        FROM inserted;&#xA;    END TRY&#xA;    BEGIN CATCH&#xA;        INSERT INTO dbo.AuditLog (BatchID, TableName, OperationType, StatusCode, HostName, ApplicationName, EventDateTime, ErrorMessage)&#xA;        VALUES (@BatchID, 'LeaveCategory', 'TRIGGER_ERROR', 'FAILED', HOST_NAME(), APP_NAME(), GETDATE(), ERROR_MESSAGE());&#xA;    END CATCH&#xA;END;&#xA;GO&#xA;&#xA;-- ============================================================&#xA;-- 6. Verify&#xA;-- ============================================================&#xA;SELECT t.name AS TriggerName, OBJECT_NAME(t.parent_id) AS TableName,&#xA;       CASE WHEN t.is_disabled = 0 THEN 'ACTIVE' ELSE 'DISABLED' END AS Status&#xA;FROM sys.triggers t&#xA;WHERE t.parent_class = 0 AND t.name LIKE 'trg_%_Audit'&#xA;ORDER BY TableName;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
    </DTS:Executable>
  </DTS:Executables>
