              <ProjectItem
                Name="ScriptMain.cs"
                Encoding="UTF8"><![CDATA[#region Namespaces
using System;
using System.Data;
using System.Data.SqlClient;
using Microsoft.SqlServer.Dts.Runtime;
#endregion

namespace ST_600f1acf7343499592cd3b896fc8f94f
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        private bool fireAgain = false;

        public void Main()
        {
            try
            {
                Dts.Events.FireInformation(0, "Move Data",
                    "Starting ETL migration...", "", 0, ref fireAgain);

                string connectionString = BuildFreshConnectionString();

                using (SqlConnection conn = new SqlConnection(connectionString))
                {
                    conn.Open();

                    int stagingCount = GetStagingCount(conn);

                    if (stagingCount == 0)
                    {
                        Dts.TaskResult = (int)ScriptResults.Success;
                        return;
                    }

                    string sql = @"
                        DECLARE @BatchID INT;
                        DECLARE @TotalStagingRecords INT;
                        DECLARE @InsertedCount INT = 0;
                        DECLARE @LeaveInsertedCount INT = 0;
                        DECLARE @DeletedTimesheetCount INT = 0;
                        DECLARE @DeletedLeaveCount INT = 0;
                        DECLARE @UpdatedCount INT = 0;
                        DECLARE @StartTime DATETIME = GETDATE();
                        DECLARE @EndTime DATETIME;
                        DECLARE @Context VARBINARY(128);

                        -- Get total records to process
                        SELECT @TotalStagingRecords = COUNT(*) 
                        FROM dbo.StagingTimesheet 
                        WHERE IsProcessed = 0;

                        -- Generate BatchID from a SQL Server SEQUENCE object
                        -- (concurrency-safe, no read of AuditLog required)
                        SET @BatchID = NEXT VALUE FOR dbo.BatchIDSequence;

                        SET @Context = CAST(@BatchID AS VARBINARY(128));
                        SET CONTEXT_INFO @Context;

                        -- LOG: Migration STARTED
                        INSERT INTO dbo.AuditLog (
                            BatchID,
                            TableName,
                            OperationType,
                            StatusCode,
                            RowsInserted,
                            RowsUpdated,
                            RowsDeleted,
                            HostName,
                            ApplicationName,
                            EventDateTime
                        )
                        VALUES (
                            @BatchID,
                            'Migration',
                            'START',
                            'RUNNING',
                            0,
                            0,
                            0,
                            HOST_NAME(),
                            'SSIS_ETL',
                            GETDATE()
                        );

                        -- =====================================================
                        -- STEP 1: DELETE existing data (for full refresh)
                        -- =====================================================
                        DELETE FROM dbo.Timesheet;
                        SET @DeletedTimesheetCount = @@ROWCOUNT;
                        DBCC CHECKIDENT ('dbo.Timesheet', RESEED, 0);

                        DELETE FROM dbo.[Leave];
                        SET @DeletedLeaveCount = @@ROWCOUNT;
                        DBCC CHECKIDENT ('dbo.[Leave]', RESEED, 0);

                        -- =====================================================
                        -- STEP 2: INSERT into Timesheet (non-leave records only)
                        -- =====================================================
                        INSERT INTO dbo.Timesheet (
                            EmployeeID, ClientID, Date, DayOfWeek,
                            Description, BillableType, Duration, 
                            StartTime, EndTime, Comments, CreatedDate, ModifiedDate
                        )
                        SELECT 
                            s.EmployeeID,
                            c.ClientID,
                            TRY_CAST(s.Date AS DATE) AS Date,
                            s.DayOfWeek,
                            NULLIF(s.Description, '') AS Description,
                            NULLIF(s.BillableType, '') AS BillableType,
                            NULLIF(s.TotalHours, '') AS Duration,
                            TRY_CAST(s.StartTime AS TIME) AS StartTime,
                            TRY_CAST(s.EndTime AS TIME) AS EndTime,
                            NULLIF(s.Comments, '') AS Comments,
                            GETDATE() AS CreatedDate,
                            NULL AS ModifiedDate
                        FROM dbo.StagingTimesheet s
                        LEFT JOIN dbo.Client c ON c.ClientName = s.Client
                        WHERE s.IsProcessed = 0
                          AND TRY_CAST(s.Date AS DATE) IS NOT NULL
                          -- Exclude weekend rows from Timesheet
                          AND UPPER(LTRIM(RTRIM(s.DayOfWeek))) NOT IN ('SATURDAY', 'SUNDAY')
                          -- Exclude leave records from Timesheet
                          AND NOT EXISTS (
                              SELECT 1 
                              FROM dbo.LeaveCategory lc
                              WHERE UPPER(LTRIM(RTRIM(s.Description))) = UPPER(LTRIM(RTRIM(lc.SourceText)))
                                AND lc.LeaveType NOT IN ('Public Holiday', 'Family Responsibility Leave')
                          );

                        SET @InsertedCount = @@ROWCOUNT;

                        -- =====================================================
                        -- STEP 3: INSERT into Leave (using LeaveCategory lookup)
                        -- EXCLUDES: Public Holiday and Family Responsibility Leave
                        -- =====================================================
                        INSERT INTO dbo.[Leave] (
                            EmployeeID, LeaveType, StartDate, EndDate, LeaveDays,
                            Comments, CreatedDate, ModifiedDate
                        )
                        SELECT 
                            s.EmployeeID,
                            lc.LeaveType,
                            TRY_CAST(s.Date AS DATE) AS StartDate,
                            TRY_CAST(s.Date AS DATE) AS EndDate,
                            CASE 
                                WHEN TRY_CAST(s.TotalHours AS DECIMAL(10,2)) IS NOT NULL 
                                THEN TRY_CAST(s.TotalHours AS DECIMAL(10,2))
                                ELSE 1 
                            END AS LeaveDays,
                            NULLIF(s.Comments, '') AS Comments,
                            GETDATE() AS CreatedDate,
                            NULL AS ModifiedDate
                        FROM dbo.StagingTimesheet s
                        INNER JOIN dbo.LeaveCategory lc
                            ON UPPER(LTRIM(RTRIM(s.Description))) = UPPER(LTRIM(RTRIM(lc.SourceText)))
                        WHERE s.IsProcessed = 0
                          AND TRY_CAST(s.Date AS DATE) IS NOT NULL
                          -- EXCLUDE Public Holiday and Family Responsibility Leave
                          AND lc.LeaveType NOT IN ('Public Holiday', 'Family Responsibility Leave');

                        SET @LeaveInsertedCount = @@ROWCOUNT;

                        -- =====================================================
                        -- STEP 4: Mark staging records as processed
                        -- =====================================================
                        UPDATE dbo.StagingTimesheet
                        SET IsProcessed = 1, ProcessedDate = GETDATE(), BatchID = @BatchID
                        WHERE IsProcessed = 0;

                        SET @UpdatedCount = @@ROWCOUNT;

                        SET @EndTime = GETDATE();

                        -- =====================================================
                        -- STEP 5: LOG: Timesheet INSERT result
                        -- =====================================================
                        IF @InsertedCount > 0
                        BEGIN
                            INSERT INTO dbo.AuditLog (
                                BatchID,
                                TableName,
                                OperationType,
                                StatusCode,
                                RowsInserted,
                                RowsUpdated,
                                RowsDeleted,
                                HostName,
                                ApplicationName,
                                EventDateTime
                            )
                            VALUES (
                                @BatchID,
                                'Timesheet',
                                'INSERT',
                                'SUCCESS',
                                @InsertedCount,
                                0,
                                0,
                                HOST_NAME(),
                                'SSIS_ETL',
                                GETDATE()
                            );
                        END

                        -- =====================================================
                        -- STEP 6: LOG: Leave INSERT result
                        -- =====================================================
                        IF @LeaveInsertedCount > 0
                        BEGIN
                            INSERT INTO dbo.AuditLog (
                                BatchID,
                                TableName,
                                OperationType,
                                StatusCode,
                                RowsInserted,
                                RowsUpdated,
                                RowsDeleted,
                                HostName,
                                ApplicationName,
                                EventDateTime
                            )
                            VALUES (
                                @BatchID,
                                'Leave',
                                'INSERT',
                                'SUCCESS',
                                @LeaveInsertedCount,
                                0,
                                0,
                                HOST_NAME(),
                                'SSIS_ETL',
                                GETDATE()
                            );
                        END

                        -- =====================================================
                        -- STEP 7: LOG: Staging UPDATE result
                        -- =====================================================
                        IF @UpdatedCount > 0
                        BEGIN
                            INSERT INTO dbo.AuditLog (
                                BatchID,
                                TableName,
                                OperationType,
                                StatusCode,
                                RowsInserted,
                                RowsUpdated,
                                RowsDeleted,
                                HostName,
                                ApplicationName,
                                EventDateTime
                            )
                            VALUES (
                                @BatchID,
                                'StagingTimesheet',
                                'UPDATE',
                                'SUCCESS',
                                0,
                                @UpdatedCount,
                                0,
                                HOST_NAME(),
                                'SSIS_ETL',
                                GETDATE()
                            );
                        END

                        -- =====================================================
                        -- STEP 8: LOG: Migration COMPLETED
                        -- =====================================================
                        INSERT INTO dbo.AuditLog (
                            BatchID,
                            TableName,
                            OperationType,
                            StatusCode,
                            RowsInserted,
                            RowsUpdated,
                            RowsDeleted,
                            HostName,
                            ApplicationName,
                            EventDateTime
                        )
                        VALUES (
                            @BatchID,
                            'Migration',
                            'COMPLETE',
                            'SUCCESS',
                            @InsertedCount + @LeaveInsertedCount,
                            @UpdatedCount,
                            @DeletedTimesheetCount + @DeletedLeaveCount,
                            HOST_NAME(),
                            'SSIS_ETL',
                            GETDATE()
                        );

                        SET CONTEXT_INFO 0x00000000;

                        -- =====================================================
                        -- STEP 9: Return summary
                        -- =====================================================
                        SELECT 
                            @BatchID AS BatchID,
                            @InsertedCount AS TimesheetRecordsInserted,
                            @LeaveInsertedCount AS LeaveRecordsInserted,
                            @TotalStagingRecords AS TotalRecords,
                            @UpdatedCount AS StagingRecordsUpdated,
                            @DeletedTimesheetCount + @DeletedLeaveCount AS RecordsDeleted,
                            DATEDIFF(MILLISECOND, @StartTime, @EndTime) AS ProcessingTimeMs;
                    ";

                    using (SqlCommand cmd = new SqlCommand(sql, conn))
                    {
                        cmd.CommandTimeout = 600;
                        using (SqlDataReader reader = cmd.ExecuteReader())
                        {
                            if (reader.Read())
                            {
                                int batchID = Convert.ToInt32(reader["BatchID"]);
                                int timesheetRecords = Convert.ToInt32(reader["TimesheetRecordsInserted"]);
                                int leaveRecords = Convert.ToInt32(reader["LeaveRecordsInserted"]);
                                int totalRecords = Convert.ToInt32(reader["TotalRecords"]);
                                int updatedRecords = Convert.ToInt32(reader["StagingRecordsUpdated"]);
                                int deletedRecords = Convert.ToInt32(reader["RecordsDeleted"]);
                                int processingTime = Convert.ToInt32(reader["ProcessingTimeMs"]);

                                Dts.Events.FireInformation(0, "Move Data",
                                    string.Format("BatchID: {0} | Inserted: {1} (Timesheet: {2} | Leave: {3}) | Updated: {4} | Deleted: {5} | Processed: {6} | Duration: {7}ms",
                                        batchID, timesheetRecords + leaveRecords, timesheetRecords, leaveRecords,
                                        updatedRecords, deletedRecords, totalRecords, processingTime), "", 0, ref fireAgain);
                            }
                        }
                    }
                }

                Dts.TaskResult = (int)ScriptResults.Success;
            }
            catch (SqlException sqlEx)
            {
                Dts.Events.FireError(0, "Move Data",
                    string.Format("SQL Error: {0}", sqlEx.Message), "", 0);
                LogErrorToAudit(sqlEx.Message);
                Dts.TaskResult = (int)ScriptResults.Failure;
            }
            catch (Exception ex)
            {
                Dts.Events.FireError(0, "Move Data",
                    string.Format("Error: {0}", ex.Message), "", 0);
                LogErrorToAudit(ex.Message);
                Dts.TaskResult = (int)ScriptResults.Failure;
            }
        }

        #region Helper Methods

        private string BuildFreshConnectionString()
        {
            if (!Dts.Connections.Contains("LocalHost.TimesheetDB"))
            {
                throw new Exception("Connection manager 'LocalHost.TimesheetDB' not found on this Script Task. " +
                    "Add it under the task's Connections, or this will silently try the wrong server (e.g. localhost instead of the ngrok tunnel).");
            }

            ConnectionManager cm = Dts.Connections["LocalHost.TimesheetDB"];
            object rawConnection = cm.AcquireConnection(Dts.Transaction);
            string connString = cm.ConnectionString;
            cm.ReleaseConnection(rawConnection);

            if (string.IsNullOrEmpty(connString))
            {
                throw new Exception("Connection manager 'LocalHost.TimesheetDB' returned an empty connection string.");
            }

            return CleanConnectionString(connString);
        }

        private string CleanConnectionString(string connString)
        {
            if (string.IsNullOrEmpty(connString)) return connString;

            string[] removeKeywords = { "Provider=", "Auto Translate=", "Persist Security Info=", "OLE DB Services=" };
            foreach (string keyword in removeKeywords)
            {
                if (connString.Contains(keyword))
                {
                    string[] parts = connString.Split(';');
                    var cleanParts = new System.Collections.Generic.List<string>();
                    foreach (string part in parts)
                    {
                        if (!part.Trim().StartsWith(keyword, StringComparison.OrdinalIgnoreCase))
                        {
                            cleanParts.Add(part);
                        }
                    }
                    connString = string.Join(";", cleanParts);
                }
            }

            if (!connString.Contains("Data Source="))
                connString = "Data Source=localhost;" + connString;
            if (!connString.Contains("Integrated Security="))
                connString += ";Integrated Security=SSPI";
            if (!connString.Contains("Initial Catalog="))
                connString += ";Initial Catalog=TimesheetDB";
            if (!connString.Contains("Connection Reset="))
                connString += ";Connection Reset=True";
            if (!connString.Contains("Pooling="))
                connString += ";Pooling=False";

            return connString;
        }

        private int GetStagingCount(SqlConnection conn)
        {
            using (SqlCommand cmd = new SqlCommand(
                "SELECT COUNT(*) FROM dbo.StagingTimesheet WHERE IsProcessed = 0", conn))
            {
                return Convert.ToInt32(cmd.ExecuteScalar());
            }
        }

        private void LogErrorToAudit(string errorMessage)
        {
            try
            {
                string connectionString = BuildFreshConnectionString();
                using (SqlConnection conn = new SqlConnection(connectionString))
                {
                    conn.Open();
                    string sql = @"
                        INSERT INTO dbo.AuditLog (
                            BatchID,
                            TableName,
                            OperationType,
                            StatusCode,
                            RowsInserted,
                            RowsUpdated,
                            RowsDeleted,
                            HostName,
                            ApplicationName,
                            EventDateTime,
                            ErrorMessage
                        )
                        VALUES (
                            -1,
                            'Migration',
                            'ERROR',
                            'FAILED',
                            0,
                            0,
                            0,
                            HOST_NAME(),
                            'SSIS_ETL',
                            GETDATE(),
                            @ErrorMessage
                        )";

                    using (SqlCommand cmd = new SqlCommand(sql, conn))
                    {
                        cmd.Parameters.AddWithValue("@ErrorMessage", errorMessage);
                        cmd.ExecuteNonQuery();
                    }
                }
            }
            catch
            {
                // Silent fail
            }
        }

        #endregion

        enum ScriptResults
        {
            Success = DTSExecResult.Success,
            Failure = DTSExecResult.Failure
        }
    }
}]]></ProjectItem>
