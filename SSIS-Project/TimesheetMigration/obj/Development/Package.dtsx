    <DTS:Executable
      DTS:refId="Package\Schema"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{AFA50E9A-635A-4BF3-9C38-AACC2C4346FB}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="Schema">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Schema\Database"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{02A3DB39-0413-427A-97EE-7C5F83CFCD35}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Database"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{2ACE0658-D1BA-4A1E-AE84-396F9A84D84A}"
              SQLTask:SqlStatementSource="-- =============================================&#xA;-- CREATE DATABASE IF NOT EXISTS&#xA;-- =============================================&#xA;IF NOT EXISTS (SELECT * FROM sys.databases WHERE name = 'TimesheetDB')&#xA;BEGIN&#xA;    CREATE DATABASE TimesheetDB;&#xA;    PRINT 'Database TimesheetDB created successfully.';&#xA;END&#xA;ELSE&#xA;BEGIN&#xA;    PRINT 'Database TimesheetDB already exists.';&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Schema\Tables"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{2CF0AFA2-3661-4115-9422-C1F20DEAA3DD}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Tables"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{AECD8F54-0CC4-4511-B5F2-DFF0FE5B8104}"
              SQLTask:SqlStatementSource="USE TimesheetDB;&#xA;GO&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM sys.tables WHERE name = 'Employee')&#xA;BEGIN&#xA;    CREATE TABLE dbo.Employee (&#xA;        EmployeeID INT IDENTITY(1001,1) PRIMARY KEY,&#xA;        EmployeeName NVARCHAR(100) NOT NULL,&#xA;        EmployeeSurname NVARCHAR(100) NOT NULL,&#xA;        IsActive BIT DEFAULT 1,&#xA;        CreatedDate DATETIME DEFAULT GETDATE(),&#xA;        ModifiedDate DATETIME NULL&#xA;    );&#xA;    PRINT 'Employee table created';&#xA;END&#xA;ELSE&#xA;    PRINT 'Employee table already exists';&#xA;GO&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM sys.tables WHERE name = 'Client')&#xA;BEGIN&#xA;    CREATE TABLE dbo.Client (&#xA;        ClientID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        ClientName NVARCHAR(200) NOT NULL,&#xA;        ClientCode NVARCHAR(50),&#xA;        IsActive BIT DEFAULT 1,&#xA;        CreatedDate DATETIME DEFAULT GETDATE(),&#xA;        ModifiedDate DATETIME NULL&#xA;    );&#xA;    PRINT 'Client table created';&#xA;END&#xA;ELSE&#xA;    PRINT 'Client table already exists';&#xA;GO&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM sys.tables WHERE name = 'StagingTimesheet')&#xA;BEGIN&#xA;    CREATE TABLE dbo.StagingTimesheet (&#xA;        StagingID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        EmployeeID INT NOT NULL,&#xA;        Date NVARCHAR(255),&#xA;        DayOfWeek NVARCHAR(255),&#xA;        Client NVARCHAR(255),&#xA;        ProjectName NVARCHAR(255),&#xA;        Description NVARCHAR(MAX),&#xA;        BillableType NVARCHAR(255),&#xA;        Comments NVARCHAR(MAX),&#xA;        TotalHours NVARCHAR(255),&#xA;        StartTime NVARCHAR(255),&#xA;        EndTime NVARCHAR(255),&#xA;        IsLeave NVARCHAR(255),&#xA;        LeaveType NVARCHAR(255),&#xA;        Month NVARCHAR(255),&#xA;        SourceFile NVARCHAR(255),&#xA;        LoadDate DATETIME DEFAULT GETDATE(),&#xA;        IsProcessed BIT DEFAULT 0,&#xA;        ProcessedDate DATETIME NULL,&#xA;        BatchID INT NULL&#xA;    );&#xA;    PRINT 'StagingTimesheet table created';&#xA;END&#xA;ELSE&#xA;    PRINT 'StagingTimesheet table already exists';&#xA;GO&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM sys.tables WHERE name = 'Timesheet')&#xA;BEGIN&#xA;    CREATE TABLE dbo.Timesheet (&#xA;        TimesheetID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        EmployeeID INT NOT NULL,&#xA;        ClientID INT NULL,&#xA;        Date DATE NOT NULL,&#xA;        DayOfWeek NVARCHAR(50) NULL,&#xA;        Description NVARCHAR(2000) NULL,&#xA;        BillableType NVARCHAR(50) NULL,&#xA;        Duration NVARCHAR(20) NULL,&#xA;        StartTime TIME NULL,&#xA;        EndTime TIME NULL,&#xA;        Comments NVARCHAR(2000) NULL,&#xA;        CreatedDate DATETIME DEFAULT GETDATE(),&#xA;        ModifiedDate DATETIME NULL,&#xA;&#xA;        CONSTRAINT FK_Timesheet_Employee&#xA;            FOREIGN KEY (EmployeeID)&#xA;            REFERENCES dbo.Employee(EmployeeID),&#xA;&#xA;        CONSTRAINT FK_Timesheet_Client&#xA;            FOREIGN KEY (ClientID)&#xA;            REFERENCES dbo.Client(ClientID)&#xA;    );&#xA;    PRINT 'Timesheet table created with Duration column';&#xA;END&#xA;ELSE&#xA;    PRINT 'Timesheet table already exists';&#xA;GO&#xA;&#xA;-- NOTE: Leave is a reserved T-SQL keyword, so the table must always be&#xA;-- bracketed as dbo.[Leave] anywhere it's used as an identifier&#xA;-- (CREATE TABLE, INSERT, DELETE, index ON clauses, etc.).&#xA;IF NOT EXISTS (SELECT 1 FROM sys.tables WHERE name = 'Leave')&#xA;BEGIN&#xA;    CREATE TABLE dbo.[Leave] (&#xA;        LeaveID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        EmployeeID INT NOT NULL,&#xA;        LeaveType NVARCHAR(50) NOT NULL,&#xA;        StartDate DATE NOT NULL,&#xA;        EndDate DATE NOT NULL,&#xA;        LeaveDays DECIMAL(10,2) NOT NULL,&#xA;        Comments NVARCHAR(500),&#xA;        CreatedDate DATETIME DEFAULT GETDATE(),&#xA;        ModifiedDate DATETIME NULL,&#xA;&#xA;        CONSTRAINT FK_Leave_Employee&#xA;            FOREIGN KEY (EmployeeID)&#xA;            REFERENCES dbo.Employee(EmployeeID)&#xA;    );&#xA;    PRINT 'Leave table created';&#xA;END&#xA;ELSE&#xA;    PRINT 'Leave table already exists';&#xA;GO&#xA;&#xA;-- Lookup table used by Load Data to derive LeaveType from the Description&#xA;-- column in StagingTimesheet, instead of hardcoded LIKE pattern matching.&#xA;-- Add a new row here whenever a new leave description appears in the&#xA;-- Excel source data -- no script/code change needed.&#xA;IF NOT EXISTS (SELECT 1 FROM sys.tables WHERE name = 'LeaveCategory')&#xA;BEGIN&#xA;    CREATE TABLE dbo.LeaveCategory (&#xA;        LeaveCategoryID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        SourceText      NVARCHAR(200) NOT NULL,   -- exact text as it appears in StagingTimesheet.Description&#xA;        LeaveType       NVARCHAR(50)  NOT NULL,   -- normalized value stored in dbo.[Leave].LeaveType&#xA;        CreatedDate     DATETIME NOT NULL DEFAULT GETDATE()&#xA;    );&#xA;    PRINT 'LeaveCategory table created';&#xA;END&#xA;ELSE&#xA;    PRINT 'LeaveCategory table already exists';&#xA;GO&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dbo.LeaveCategory WHERE SourceText = 'Annual Leave')&#xA;BEGIN&#xA;    INSERT INTO dbo.LeaveCategory (SourceText, LeaveType) VALUES&#xA;        ('Annual Leave',                 'Annual Leave'),&#xA;        ('Sick leave',                   'Sick Leave'),&#xA;        ('Study Leave',                  'Study Leave'),&#xA;        ('Family Responsibility Leave',  'Family Responsibility Leave'),&#xA;        ('Birthday leave',               'Birthday Leave'),&#xA;        ('Public Holiday',               'Public Holiday'),&#xA;        ('Sick Leave - half day',        'Sick Leave - half day'),&#xA;        ('Annual Leave - half day',      'Annual Leave - half day');&#xA;    PRINT 'LeaveCategory populated';&#xA;END&#xA;ELSE&#xA;    PRINT 'LeaveCategory already populated';&#xA;GO&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM sys.tables WHERE name = 'AuditStatusCode')&#xA;BEGIN&#xA;    CREATE TABLE dbo.AuditStatusCode (&#xA;        StatusID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        StatusCode NVARCHAR(20) UNIQUE NOT NULL,&#xA;        StatusName NVARCHAR(50) NOT NULL,&#xA;        Description NVARCHAR(200),&#xA;        IsSuccess BIT DEFAULT 0,&#xA;        IsError BIT DEFAULT 0,&#xA;        IsActive BIT DEFAULT 1&#xA;    );&#xA;    PRINT 'AuditStatusCode table created';&#xA;END&#xA;ELSE&#xA;    PRINT 'AuditStatusCode table already exists';&#xA;GO&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dbo.AuditStatusCode WHERE StatusCode = 'SUCCESS')&#xA;BEGIN&#xA;    INSERT INTO dbo.AuditStatusCode (StatusCode, StatusName, Description, IsSuccess, IsError)&#xA;    VALUES&#xA;        ('SUCCESS', 'Success', 'Operation completed successfully', 1, 0),&#xA;        ('FAILED', 'Failed', 'Operation failed', 0, 1),&#xA;        ('RUNNING', 'Running', 'Operation is in progress', 0, 0),&#xA;        ('WARNING', 'Warning', 'Operation completed with warnings', 0, 0),&#xA;        ('SKIPPED', 'Skipped', 'Operation was skipped', 0, 0);&#xA;    PRINT 'AuditStatusCode populated';&#xA;END&#xA;ELSE&#xA;    PRINT 'AuditStatusCode already populated';&#xA;GO&#xA;&#xA;-- ============================================&#xA;-- AUDITLOG TABLE (safe, non-destructive)&#xA;-- ============================================&#xA;IF NOT EXISTS (SELECT 1 FROM sys.tables WHERE name = 'AuditLog')&#xA;BEGIN&#xA;    CREATE TABLE dbo.AuditLog (&#xA;        AuditID BIGINT IDENTITY(1,1) PRIMARY KEY,&#xA;        BatchID INT NOT NULL,&#xA;        TableName NVARCHAR(128) NOT NULL,&#xA;        OperationType NVARCHAR(20) NOT NULL,  -- INSERT, UPDATE, DELETE, START, COMPLETE, ERROR&#xA;        StatusCode NVARCHAR(20) NOT NULL DEFAULT 'SUCCESS',  -- SUCCESS, FAILED, WARNING, RUNNING&#xA;        RowsInserted INT DEFAULT 0,&#xA;        RowsUpdated INT DEFAULT 0,&#xA;        RowsDeleted INT DEFAULT 0,&#xA;        HostName NVARCHAR(255) NULL,&#xA;        ApplicationName NVARCHAR(255) NULL,&#xA;        EventDateTime DATETIME NOT NULL DEFAULT GETDATE(),&#xA;        ErrorMessage NVARCHAR(MAX) NULL&#xA;    );&#xA;    PRINT 'AuditLog table created';&#xA;END&#xA;ELSE&#xA;BEGIN&#xA;    PRINT 'AuditLog table already exists. Checking for missing columns...';&#xA;&#xA;    IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('dbo.AuditLog') AND name = 'RowsInserted')&#xA;        ALTER TABLE dbo.AuditLog ADD RowsInserted INT DEFAULT 0;&#xA;&#xA;    IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('dbo.AuditLog') AND name = 'RowsUpdated')&#xA;        ALTER TABLE dbo.AuditLog ADD RowsUpdated INT DEFAULT 0;&#xA;&#xA;    IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('dbo.AuditLog') AND name = 'RowsDeleted')&#xA;        ALTER TABLE dbo.AuditLog ADD RowsDeleted INT DEFAULT 0;&#xA;&#xA;    IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('dbo.AuditLog') AND name = 'HostName')&#xA;        ALTER TABLE dbo.AuditLog ADD HostName NVARCHAR(255) NULL;&#xA;&#xA;    IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('dbo.AuditLog') AND name = 'ApplicationName')&#xA;        ALTER TABLE dbo.AuditLog ADD ApplicationName NVARCHAR(255) NULL;&#xA;&#xA;    IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('dbo.AuditLog') AND name = 'ErrorMessage')&#xA;        ALTER TABLE dbo.AuditLog ADD ErrorMessage NVARCHAR(MAX) NULL;&#xA;&#xA;    PRINT 'AuditLog table structure verified';&#xA;END&#xA;GO&#xA;&#xA;-- Recreate indexes for AuditLog&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name = 'IX_AuditLog_BatchID' AND object_id = OBJECT_ID('AuditLog'))&#xA;    CREATE NONCLUSTERED INDEX IX_AuditLog_BatchID ON dbo.AuditLog(BatchID);&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name = 'IX_AuditLog_EventDateTime' AND object_id = OBJECT_ID('AuditLog'))&#xA;    CREATE NONCLUSTERED INDEX IX_AuditLog_EventDateTime ON dbo.AuditLog(EventDateTime);&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name = 'IX_AuditLog_TableName' AND object_id = OBJECT_ID('AuditLog'))&#xA;    CREATE NONCLUSTERED INDEX IX_AuditLog_TableName ON dbo.AuditLog(TableName);&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name = 'IX_AuditLog_StatusCode' AND object_id = OBJECT_ID('AuditLog'))&#xA;    CREATE NONCLUSTERED INDEX IX_AuditLog_StatusCode ON dbo.AuditLog(StatusCode);&#xA;GO&#xA;&#xA;-- ============================================&#xA;-- BATCHID SEQUENCE&#xA;-- ============================================&#xA;-- Replaces MAX(BatchID)+1 logic with a proper SQL Server SEQUENCE object.&#xA;-- Guarantees unique, gap-tolerant, concurrency-safe BatchID values without&#xA;-- needing to read from AuditLog first.&#xA;IF NOT EXISTS (SELECT 1 FROM sys.sequences WHERE name = 'BatchIDSequence')&#xA;BEGIN&#xA;    CREATE SEQUENCE dbo.BatchIDSequence&#xA;        AS INT&#xA;        START WITH 1&#xA;        INCREMENT BY 1&#xA;        NO CYCLE;&#xA;    PRINT 'BatchIDSequence created';&#xA;END&#xA;ELSE&#xA;    PRINT 'BatchIDSequence already exists';&#xA;GO&#xA;&#xA;-- ============================================&#xA;-- INSERT CLIENT DATA&#xA;-- ============================================&#xA;IF NOT EXISTS (SELECT 1 FROM dbo.Client WHERE ClientName = 'Internal Sambe')&#xA;BEGIN&#xA;    INSERT INTO dbo.Client (ClientName, ClientCode, IsActive)&#xA;    VALUES&#xA;        ('Internal Sambe', 'INT001', 1),&#xA;        ('ADVTech', 'ADV001', 1),&#xA;        ('AFA Sasfin', 'AFA001', 1),&#xA;        ('Artist Proof Studio', 'ART001', 1),&#xA;        ('Assimil8', 'ASS001', 1),&#xA;        ('Base 3', 'BAS001', 1),&#xA;        ('Blue Legacy', 'BLU001', 1),&#xA;        ('C. Steinweg', 'CST001', 1),&#xA;        ('Conekt – Aurum', 'CON001', 1),&#xA;        ('Conekt – Clientele', 'CON002', 1),&#xA;        ('Conekt – Internal Meeting', 'CON003', 1),&#xA;        ('Conekt – Meridian', 'CON004', 1),&#xA;        ('Conekt – Winning Business', 'CON005', 1),&#xA;        ('Conekt AGSA SharePoint', 'CON006', 1),&#xA;        ('Dentons', 'DEN001', 1),&#xA;        ('Discovery', 'DIS001', 1),&#xA;        ('Discovery Bank', 'DIS002', 1),&#xA;        ('Discovery CRES', 'DIS003', 1),&#xA;        ('Discovery CSI', 'DIS004', 1),&#xA;        ('Discovery Health', 'DIS005', 1),&#xA;        ('Discovery Information Governance and Security', 'DIS006', 1),&#xA;        ('Discovery Innovation Lab', 'DIS007', 1),&#xA;        ('Discovery People', 'DIS008', 1),&#xA;        ('Discovery Skills', 'DIS009', 1),&#xA;        ('Discovery Vitality', 'DIS010', 1),&#xA;        ('Gyro', 'GYR001', 1),&#xA;        ('KFC Digistics', 'KFC001', 1),&#xA;        ('Life Healthcare', 'LIF001', 1),&#xA;        ('Medi-Charge', 'MED001', 1),&#xA;        ('MICA Build', 'MIC001', 1),&#xA;        ('Michelin', 'MIE001', 1),&#xA;        ('Mistro Foods', 'MIS001', 1),&#xA;        ('OK Furnitures', 'OKF001', 1),&#xA;        ('Olympic Paints', 'OLY001', 1),&#xA;        ('RMB', 'RMB001', 1),&#xA;        ('RMB CM Data Warehouse support', 'RMB002', 1),&#xA;        ('RMB CORE NRTI', 'RMB003', 1),&#xA;        ('RMB Tumelo', 'RMB004', 1),&#xA;        ('Sachar Mobile', 'SAC001', 1),&#xA;        ('Sanlam', 'SAN001', 1),&#xA;        ('SBV', 'SBV001', 1),&#xA;        ('Sibanya', 'SIB001', 1),&#xA;        ('Transport Holdings', 'TRA001', 1);&#xA;    PRINT 'Clients inserted';&#xA;END&#xA;ELSE&#xA;    PRINT 'Clients already exist';&#xA;GO&#xA;&#xA;-- ============================================&#xA;-- INSERT EMPLOYEE DATA&#xA;-- ============================================&#xA;IF NOT EXISTS (SELECT 1 FROM dbo.Employee WHERE EmployeeName = 'Buhle' AND EmployeeSurname = 'Mukhuba')&#xA;BEGIN&#xA;    INSERT INTO dbo.Employee (EmployeeName, EmployeeSurname, IsActive)&#xA;    VALUES&#xA;        ('Buhle', 'Mukhuba', 1),&#xA;        ('Charmane', 'Mchunu', 1),&#xA;        ('Jabulane', 'Poulo', 1),&#xA;        ('Kayden', 'Padayachee', 1),&#xA;        ('Lwazisile', 'Mhlambi', 1),&#xA;        ('Rushil', 'Jivan', 1),&#xA;        ('Shriya', 'Hariparsad', 1),&#xA;        ('Teolan', 'Govender', 1);&#xA;    PRINT 'Employees inserted';&#xA;END&#xA;ELSE&#xA;    PRINT 'Employees already exist';&#xA;GO&#xA;&#xA;-- ============================================&#xA;-- CREATE REMAINING INDEXES&#xA;-- ============================================&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name = 'IX_StagingTimesheet_IsProcessed' AND object_id = OBJECT_ID('StagingTimesheet'))&#xA;    CREATE NONCLUSTERED INDEX IX_StagingTimesheet_IsProcessed ON dbo.StagingTimesheet(IsProcessed);&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name = 'IX_Timesheet_EmployeeID' AND object_id = OBJECT_ID('Timesheet'))&#xA;    CREATE NONCLUSTERED INDEX IX_Timesheet_EmployeeID ON dbo.Timesheet(EmployeeID);&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name = 'IX_Timesheet_Date' AND object_id = OBJECT_ID('Timesheet'))&#xA;    CREATE NONCLUSTERED INDEX IX_Timesheet_Date ON dbo.Timesheet(Date);&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name = 'IX_Timesheet_ClientID' AND object_id = OBJECT_ID('Timesheet'))&#xA;    CREATE NONCLUSTERED INDEX IX_Timesheet_ClientID ON dbo.Timesheet(ClientID);&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name = 'IX_Leave_EmployeeID' AND object_id = OBJECT_ID('dbo.Leave'))&#xA;    CREATE NONCLUSTERED INDEX IX_Leave_EmployeeID ON dbo.[Leave](EmployeeID);&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name = 'IX_LeaveCategory_SourceText' AND object_id = OBJECT_ID('LeaveCategory'))&#xA;    CREATE UNIQUE NONCLUSTERED INDEX IX_LeaveCategory_SourceText ON dbo.LeaveCategory(SourceText);&#xA;&#xA;PRINT 'All indexes created';&#xA;GO&#xA;&#xA;-- ============================================&#xA;-- FINAL VERIFICATION&#xA;-- ============================================&#xA;PRINT '';&#xA;PRINT '========================================';&#xA;PRINT 'DATABASE SETUP COMPLETE';&#xA;PRINT '========================================';&#xA;PRINT '';&#xA;&#xA;SELECT&#xA;    'AuditLog' AS TableName,&#xA;    COUNT(*) AS RecordCount&#xA;FROM dbo.AuditLog&#xA;UNION ALL&#xA;SELECT&#xA;    'Employee',&#xA;    COUNT(*)&#xA;FROM dbo.Employee&#xA;UNION ALL&#xA;SELECT&#xA;    'Client',&#xA;    COUNT(*)&#xA;FROM dbo.Client&#xA;UNION ALL&#xA;SELECT&#xA;    'StagingTimesheet',&#xA;    COUNT(*)&#xA;FROM dbo.StagingTimesheet&#xA;UNION ALL&#xA;SELECT&#xA;    'Timesheet',&#xA;    COUNT(*)&#xA;FROM dbo.Timesheet&#xA;UNION ALL&#xA;SELECT&#xA;    'Leave',&#xA;    COUNT(*)&#xA;FROM dbo.[Leave]&#xA;UNION ALL&#xA;SELECT&#xA;    'LeaveCategory',&#xA;    COUNT(*)&#xA;FROM dbo.LeaveCategory&#xA;UNION ALL&#xA;SELECT&#xA;    'AuditStatusCode',&#xA;    COUNT(*)&#xA;FROM dbo.AuditStatusCode;&#xA;&#xA;PRINT '';&#xA;PRINT '========================================';&#xA;PRINT 'ALL TABLES CREATED SUCCESSFULLY';&#xA;PRINT '========================================';&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
      <DTS:PrecedenceConstraints>
        <DTS:PrecedenceConstraint
          DTS:refId="Package\Schema.PrecedenceConstraints[Constraint]"
          DTS:CreationName=""
          DTS:DTSID="{E7013ED5-679B-49BA-AE70-74A48801932E}"
          DTS:From="Package\Schema\Database"
          DTS:LogicalAnd="True"
          DTS:ObjectName="Constraint"
          DTS:To="Package\Schema\Tables" />
      </DTS:PrecedenceConstraints>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Trigger"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{7B79E0CE-33C4-40E9-9B44-F9CC9E1ABCF1}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="Trigger">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Trigger\Trigger"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{C9053FC4-3838-4C76-82E2-0DA052E161A9}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Trigger"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{AECD8F54-0CC4-4511-B5F2-DFF0FE5B8104}"
              SQLTask:SqlStatementSource="USE TimesheetDB;&#xA;GO&#xA;&#xA;-- ============================================================&#xA;-- 1. Add ModifiedDate to LeaveCategory (&quot;leave type&quot; table)&#xA;--    Employee, Timesheet, and Leave already have this column.&#xA;-- ============================================================&#xA;IF NOT EXISTS (&#xA;    SELECT 1 FROM sys.columns&#xA;    WHERE object_id = OBJECT_ID('dbo.LeaveCategory') AND name = 'ModifiedDate'&#xA;)&#xA;    ALTER TABLE dbo.LeaveCategory ADD ModifiedDate DATETIME NULL;&#xA;GO&#xA;&#xA;-- ============================================================&#xA;-- 2. TRIGGER: Employee&#xA;-- ============================================================&#xA;DROP TRIGGER IF EXISTS dbo.trg_Employee_Audit;&#xA;GO&#xA;CREATE TRIGGER dbo.trg_Employee_Audit&#xA;ON dbo.Employee&#xA;AFTER UPDATE&#xA;AS&#xA;BEGIN&#xA;    SET NOCOUNT ON;&#xA;&#xA;    DECLARE @BatchID INT;&#xA;    DECLARE @ContextInfo VARBINARY(128) = CONTEXT_INFO();&#xA;    IF @ContextInfo IS NOT NULL AND @ContextInfo != 0x00000000&#xA;        SET @BatchID = CONVERT(INT, @ContextInfo);&#xA;    IF @BatchID IS NULL OR @BatchID = 0&#xA;        SET @BatchID = -1;&#xA;&#xA;    -- Stamp ModifiedDate on the rows that changed&#xA;    UPDATE e&#xA;    SET ModifiedDate = GETDATE()&#xA;    FROM dbo.Employee e&#xA;    INNER JOIN inserted i ON e.EmployeeID = i.EmployeeID;&#xA;&#xA;    BEGIN TRY&#xA;        INSERT INTO dbo.AuditLog (BatchID, TableName, OperationType, StatusCode, RowsUpdated, HostName, ApplicationName, EventDateTime)&#xA;        SELECT @BatchID, 'Employee', 'UPDATE', 'SUCCESS', COUNT(*), HOST_NAME(), APP_NAME(), GETDATE()&#xA;        FROM inserted;&#xA;    END TRY&#xA;    BEGIN CATCH&#xA;        INSERT INTO dbo.AuditLog (BatchID, TableName, OperationType, StatusCode, HostName, ApplicationName, EventDateTime, ErrorMessage)&#xA;        VALUES (@BatchID, 'Employee', 'TRIGGER_ERROR', 'FAILED', HOST_NAME(), APP_NAME(), GETDATE(), ERROR_MESSAGE());&#xA;    END CATCH&#xA;END;&#xA;GO&#xA;&#xA;-- ============================================================&#xA;-- 3. TRIGGER: Timesheet (replaces the old trg_Timesheet_Audit,&#xA;--    which never set ModifiedDate)&#xA;-- ============================================================&#xA;DROP TRIGGER IF EXISTS dbo.trg_Timesheet_Audit;&#xA;GO&#xA;CREATE TRIGGER dbo.trg_Timesheet_Audit&#xA;ON dbo.Timesheet&#xA;AFTER UPDATE&#xA;AS&#xA;BEGIN&#xA;    SET NOCOUNT ON;&#xA;&#xA;    DECLARE @BatchID INT;&#xA;    DECLARE @ContextInfo VARBINARY(128) = CONTEXT_INFO();&#xA;    IF @ContextInfo IS NOT NULL AND @ContextInfo != 0x00000000&#xA;        SET @BatchID = CONVERT(INT, @ContextInfo);&#xA;    IF @BatchID IS NULL OR @BatchID = 0&#xA;        SET @BatchID = -1;&#xA;&#xA;    UPDATE t&#xA;    SET ModifiedDate = GETDATE()&#xA;    FROM dbo.Timesheet t&#xA;    INNER JOIN inserted i ON t.TimesheetID = i.TimesheetID;&#xA;&#xA;    BEGIN TRY&#xA;        INSERT INTO dbo.AuditLog (BatchID, TableName, OperationType, StatusCode, RowsUpdated, HostName, ApplicationName, EventDateTime)&#xA;        SELECT @BatchID, 'Timesheet', 'UPDATE', 'SUCCESS', COUNT(*), HOST_NAME(), APP_NAME(), GETDATE()&#xA;        FROM inserted;&#xA;    END TRY&#xA;    BEGIN CATCH&#xA;        INSERT INTO dbo.AuditLog (BatchID, TableName, OperationType, StatusCode, HostName, ApplicationName, EventDateTime, ErrorMessage)&#xA;        VALUES (@BatchID, 'Timesheet', 'TRIGGER_ERROR', 'FAILED', HOST_NAME(), APP_NAME(), GETDATE(), ERROR_MESSAGE());&#xA;    END CATCH&#xA;END;&#xA;GO&#xA;&#xA;-- ============================================================&#xA;-- 4. TRIGGER: Leave (bracketed [Leave] - reserved keyword)&#xA;-- ============================================================&#xA;DROP TRIGGER IF EXISTS dbo.trg_Leave_Audit;&#xA;GO&#xA;CREATE TRIGGER dbo.trg_Leave_Audit&#xA;ON dbo.[Leave]&#xA;AFTER UPDATE&#xA;AS&#xA;BEGIN&#xA;    SET NOCOUNT ON;&#xA;&#xA;    DECLARE @BatchID INT;&#xA;    DECLARE @ContextInfo VARBINARY(128) = CONTEXT_INFO();&#xA;    IF @ContextInfo IS NOT NULL AND @ContextInfo != 0x00000000&#xA;        SET @BatchID = CONVERT(INT, @ContextInfo);&#xA;    IF @BatchID IS NULL OR @BatchID = 0&#xA;        SET @BatchID = -1;&#xA;&#xA;    UPDATE l&#xA;    SET ModifiedDate = GETDATE()&#xA;    FROM dbo.[Leave] l&#xA;    INNER JOIN inserted i ON l.LeaveID = i.LeaveID;&#xA;&#xA;    BEGIN TRY&#xA;        INSERT INTO dbo.AuditLog (BatchID, TableName, OperationType, StatusCode, RowsUpdated, HostName, ApplicationName, EventDateTime)&#xA;        SELECT @BatchID, 'Leave', 'UPDATE', 'SUCCESS', COUNT(*), HOST_NAME(), APP_NAME(), GETDATE()&#xA;        FROM inserted;&#xA;    END TRY&#xA;    BEGIN CATCH&#xA;        INSERT INTO dbo.AuditLog (BatchID, TableName, OperationType, StatusCode, HostName, ApplicationName, EventDateTime, ErrorMessage)&#xA;        VALUES (@BatchID, 'Leave', 'TRIGGER_ERROR', 'FAILED', HOST_NAME(), APP_NAME(), GETDATE(), ERROR_MESSAGE());&#xA;    END CATCH&#xA;END;&#xA;GO&#xA;&#xA;-- ============================================================&#xA;-- 5. TRIGGER: LeaveCategory (&quot;leave type&quot; table)&#xA;-- ============================================================&#xA;DROP TRIGGER IF EXISTS dbo.trg_LeaveCategory_Audit;&#xA;GO&#xA;CREATE TRIGGER dbo.trg_LeaveCategory_Audit&#xA;ON dbo.LeaveCategory&#xA;AFTER UPDATE&#xA;AS&#xA;BEGIN&#xA;    SET NOCOUNT ON;&#xA;&#xA;    DECLARE @BatchID INT;&#xA;    DECLARE @ContextInfo VARBINARY(128) = CONTEXT_INFO();&#xA;    IF @ContextInfo IS NOT NULL AND @ContextInfo != 0x00000000&#xA;        SET @BatchID = CONVERT(INT, @ContextInfo);&#xA;    IF @BatchID IS NULL OR @BatchID = 0&#xA;        SET @BatchID = -1;&#xA;&#xA;    UPDATE lc&#xA;    SET ModifiedDate = GETDATE()&#xA;    FROM dbo.LeaveCategory lc&#xA;    INNER JOIN inserted i ON lc.LeaveCategoryID = i.LeaveCategoryID;&#xA;&#xA;    BEGIN TRY&#xA;        INSERT INTO dbo.AuditLog (BatchID, TableName, OperationType, StatusCode, RowsUpdated, HostName, ApplicationName, EventDateTime)&#xA;        SELECT @BatchID, 'LeaveCategory', 'UPDATE', 'SUCCESS', COUNT(*), HOST_NAME(), APP_NAME(), GETDATE()&#xA;        FROM inserted;&#xA;    END TRY&#xA;    BEGIN CATCH&#xA;        INSERT INTO dbo.AuditLog (BatchID, TableName, OperationType, StatusCode, HostName, ApplicationName, EventDateTime, ErrorMessage)&#xA;        VALUES (@BatchID, 'LeaveCategory', 'TRIGGER_ERROR', 'FAILED', HOST_NAME(), APP_NAME(), GETDATE(), ERROR_MESSAGE());&#xA;    END CATCH&#xA;END;&#xA;GO&#xA;&#xA;-- ============================================================&#xA;-- 6. Verify&#xA;-- ============================================================&#xA;SELECT t.name AS TriggerName, OBJECT_NAME(t.parent_id) AS TableName,&#xA;       CASE WHEN t.is_disabled = 0 THEN 'ACTIVE' ELSE 'DISABLED' END AS Status&#xA;FROM sys.triggers t&#xA;WHERE t.parent_class = 0 AND t.name LIKE 'trg_%_Audit'&#xA;ORDER BY TableName;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
    </DTS:Executable>
  </DTS:Executables>
