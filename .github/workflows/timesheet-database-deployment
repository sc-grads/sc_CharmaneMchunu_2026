name: Timesheet Database Deployment

on:
  workflow_dispatch:
    inputs:
      target_pc:
        description: 'Select Target Machine'
        required: true
        default: 'cm-pc'
        type: choice
        options:
          - 'cm-pc'

  push:
    branches:
      - main
    paths:
      - 'Projects 2026/TimesheetDataMigration/**'

jobs:
  set-matrix:
    runs-on: ubuntu-latest
    outputs:
      targets: ${{ steps.select.outputs.matrix }}
    steps:
      - id: select
        run: |
          if [ "${{ github.event_name }}" = "push" ]; then
            echo 'matrix=["cm-pc"]' >> $GITHUB_OUTPUT
          else
            echo 'matrix=["${{ github.event.inputs.target_pc }}"]' >> $GITHUB_OUTPUT
          fi

  deploy:
    needs: set-matrix
    strategy:
      matrix:
        target: ${{ fromJson(needs.set-matrix.outputs.targets) }}
    uses: ./.github/workflows/deploy-timesheet-template.yml
    with:
      database: TimesheetDB
      runner_label: runner-${{ matrix.target }}
      timesheet_folder_path: 'C:\sc_CharmaneMchunu_2026\Projects 2026\TimesheetDataMigration\Timesheets'
    secrets:
      sql_username: ${{ secrets.SQL_USERNAME }}
      sql_password: ${{ secrets.SQL_PASSWORD }}
