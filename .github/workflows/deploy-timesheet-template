name: Test Reusable Timesheet Deploy

on:
  workflow_call:
    inputs:
      database:
        required: true
        type: string
      runner_label:
        required: true
        type: string
      timesheet_folder_path:
        required: true
        type: string
    secrets:
      sql_username:
        required: true
      sql_password:
        required: true

jobs:
  deploy:
    name: Deploy Timesheet Database
    # This forces GitHub to use the specific person's computer
    runs-on: ["self-hosted", "${{ inputs.runner_label }}"]

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Validate Configuration
        shell: powershell
        run: |
          if ([string]::IsNullOrWhiteSpace("${{ secrets.sql_username }}")) { throw "SQL_USERNAME is not configured" }
          if ([string]::IsNullOrWhiteSpace("${{ secrets.sql_password }}")) { throw "SQL_PASSWORD is not configured" }

      - name: 1. Initialize SSISDB Catalog
        shell: powershell
        run: |
          $server = "localhost"
          $user   = "${{ secrets.sql_username }}"
          $pass   = "${{ secrets.sql_password }}"

          $setupSql = @"
          SET NOCOUNT ON;
          IF (SELECT value_in_use FROM sys.configurations WHERE name = 'clr enabled') = 0
          BEGIN
              EXEC sp_configure 'clr enabled', 1;
              RECONFIGURE;
          END

          IF NOT EXISTS (SELECT * FROM sys.databases WHERE name = 'SSISDB')
          BEGIN
              EXEC [master].[dbo].[xp_instance_regwrite] N'HKEY_LOCAL_MACHINE', N'SOFTWARE\Microsoft\MSSQLServer\SSISDB', N'ServerRequiresEncryption', REG_DWORD, 1;
              DECLARE @catalog_password NVARCHAR(128) = N'Password@123';
              EXEC [catalog].[create_catalog] @password = @catalog_password;
          END
          "@
          sqlcmd -b -S $server -U $user -P $pass -d "master" -Q $setupSql

      - name: 2. Run Database Deployment Scripts
        shell: powershell
        run: |
          $server = "localhost"
          $user   = "${{ secrets.sql_username }}"
          $pass   = "${{ secrets.sql_password }}"
          $db     = "${{ inputs.database }}"
          $base   = "Projects 2026\TimesheetDataMigration"

          # Creates the database (if missing), all tables, indexes, seed data,
          # and the audit triggers. The script itself switches context via
          # "USE TimesheetDB", so this runs starting from master.
          sqlcmd -b -S $server -U $user -P $pass -d "master" -i "$base\deploy-timesheetdb.sql"

          # Alters spRunTimesheetMigration into the version that kicks off the
          # RunTimesheetMigration SQL Agent job (used when triggered from CI).
          sqlcmd -b -S $server -U $user -P $pass -d $db -i "$base\spRunTimesheetMigration.sql"

      - name: 3. Deploy ISPAC and Set Folder Path Parameter
        shell: powershell
        run: |
          $server       = "localhost"
          $user         = "${{ secrets.sql_username }}"
          $pass         = "${{ secrets.sql_password }}"
          $folderPath   = "${{ inputs.timesheet_folder_path }}"
          $catalogFolder  = "TimesheetDataPipeline"
          $projectName    = "TimesheetsMigrationSSIS"

          $ispacPath = "$env:GITHUB_WORKSPACE\Projects 2026\TimesheetDataMigration\TimesheetsMigrationSSIS\bin\Development\$projectName.ispac"
          if (-not (Test-Path $ispacPath)) {
            throw "Could not find ispac at $ispacPath"
          }

          # ISDeploymentWizard.exe does not support these CLI flags and crashes
          # in a non-interactive session, so we deploy via the SSIS management
          # assembly instead (works headless on self-hosted runners).
          $dllPath = Get-ChildItem -Path "C:\Program Files\Microsoft SQL Server" -Filter "Microsoft.SqlServer.Management.IntegrationServices.dll" -Recurse -ErrorAction SilentlyContinue | Select-Object -First 1
          if ($null -eq $dllPath) { throw "Could not find Microsoft.SqlServer.Management.IntegrationServices.dll" }
          Add-Type -Path $dllPath.FullName

          $connStr = "Data Source=$server;User ID=$user;Password=$pass;"
          $sqlConn = New-Object System.Data.SqlClient.SqlConnection $connStr
          $ssisServer = New-Object Microsoft.SqlServer.Management.IntegrationServices.IntegrationServices $sqlConn
          $catalog = $ssisServer.Catalogs["SSISDB"]

          $folder = $catalog.Folders[$catalogFolder]
          if ($null -eq $folder) {
            $folder = New-Object Microsoft.SqlServer.Management.IntegrationServices.CatalogFolder($catalog, $catalogFolder, "Timesheet pipeline deployments")
            $folder.Create()
          }

          $projectBytes = [System.IO.File]::ReadAllBytes($ispacPath)
          $folder.DeployProject($projectName, $projectBytes)

          # Re-fetch and set the machine-specific folder path used by the
          # Foreach Loop Container (bound via @[$Project::TimesheetFilesFolder]).
          $folder.Alter()
          $project = $folder.Projects[$projectName]
          $project.SetParameterValue("TimesheetFilesFolder", $folderPath)
          $project.Alter()

      - name: 4. Provision RunTimesheetMigration Job
        shell: powershell
        run: |
          $server = "localhost"
          $user   = "${{ secrets.sql_username }}"
          $pass   = "${{ secrets.sql_password }}"
          $db     = "${{ inputs.database }}"
          $jobScriptPath = "$env:GITHUB_WORKSPACE\provision_migration_job.sql"

          # spRunTimesheetMigration.sql overwrote the entry-point proc to just
          # call sp_start_job('RunTimesheetMigration'), but that job never
          # existed on any machine -- so the call fails silently and staging
          # data never lands in Timesheet/Leave. This recreates the job with
          # the original migration logic as its step.
          $provisionJobSql = @"
          USE [msdb];
          IF EXISTS (SELECT job_id FROM msdb.dbo.sysjobs WHERE name = N'RunTimesheetMigration')
              EXEC msdb.dbo.sp_delete_job @job_name = N'RunTimesheetMigration', @delete_unused_schedule = 1;

          DECLARE @jobId BINARY(16);
          EXEC msdb.dbo.sp_add_job @job_name = N'RunTimesheetMigration', @enabled = 1, @job_id = @jobId OUTPUT;

          EXEC msdb.dbo.sp_add_jobstep @job_id = @jobId, @step_name = N'Migrate Staging to Timesheet and Leave',
              @subsystem = N'TSQL',
              @database_name = N'$db',
              @command = N'
          SET NOCOUNT ON;
          DECLARE @BatchID INT, @InsertedTimesheet INT = 0, @InsertedLeave INT = 0, @UpdatedStaging INT = 0, @DeletedTimesheet INT = 0, @DeletedLeave INT = 0, @ErrorMsg NVARCHAR(MAX), @LockResult INT;
          IF NOT EXISTS (SELECT 1 FROM dbo.StagingTimesheet WHERE IsProcessed = 0) RETURN;
          EXEC @LockResult = sp_getapplock @Resource = ''TimesheetMigrationLock'', @LockMode = ''Exclusive'', @LockOwner = ''Session'', @LockTimeout = 0;
          IF @LockResult < 0 RETURN;
          BEGIN TRY
              SET @BatchID = NEXT VALUE FOR dbo.BatchIDSequence;
              INSERT INTO dbo.AuditLog (BatchID, TableName, OperationType, StatusCode, RowsInserted, RowsUpdated, RowsDeleted, HostName, ApplicationName, EventDateTime)
              VALUES (@BatchID, ''Migration'', ''START'', ''RUNNING'', 0, 0, 0, HOST_NAME(), ''SQLAgentJob'', GETDATE());
              DELETE FROM dbo.Timesheet; SET @DeletedTimesheet = @@ROWCOUNT;
              DELETE FROM dbo.[Leave]; SET @DeletedLeave = @@ROWCOUNT;
              INSERT INTO dbo.Timesheet (EmployeeID, ClientID, Date, DayOfWeek, Description, BillableType, Duration, StartTime, EndTime, Comments, CreatedDate, ModifiedDate)
              SELECT DISTINCT s.EmployeeID, c.ClientID, TRY_CAST(s.Date AS DATE), s.DayOfWeek, NULLIF(s.Description,''''), NULLIF(s.BillableType,''''), NULLIF(s.TotalHours,''''), TRY_CAST(s.StartTime AS TIME), TRY_CAST(s.EndTime AS TIME), NULLIF(s.Comments,''''), GETDATE(), NULL
              FROM dbo.StagingTimesheet s
              LEFT JOIN dbo.Client c ON c.ClientName = s.Client
              WHERE s.IsProcessed = 0 AND TRY_CAST(s.Date AS DATE) IS NOT NULL
                AND UPPER(LTRIM(RTRIM(s.DayOfWeek))) NOT IN (''''SATURDAY'''',''''SUNDAY'''')
                AND NOT EXISTS (SELECT 1 FROM dbo.LeaveCategory lc WHERE UPPER(LTRIM(RTRIM(s.Description))) = UPPER(LTRIM(RTRIM(lc.SourceText))) AND lc.LeaveType NOT IN (''''Public Holiday'''',''''Family Responsibility Leave''''));
              SET @InsertedTimesheet = @@ROWCOUNT;
              INSERT INTO dbo.[Leave] (EmployeeID, LeaveType, StartDate, EndDate, LeaveDays, Comments, CreatedDate, ModifiedDate)
              SELECT DISTINCT s.EmployeeID, lc.LeaveType, TRY_CAST(s.Date AS DATE), TRY_CAST(s.Date AS DATE), COALESCE(TRY_CAST(s.TotalHours AS DECIMAL(10,2)),1), NULLIF(s.Comments,''''), GETDATE(), NULL
              FROM dbo.StagingTimesheet s
              INNER JOIN dbo.LeaveCategory lc ON UPPER(LTRIM(RTRIM(s.Description))) = UPPER(LTRIM(RTRIM(lc.SourceText)))
              WHERE s.IsProcessed = 0 AND TRY_CAST(s.Date AS DATE) IS NOT NULL AND lc.LeaveType NOT IN (''''Public Holiday'''',''''Family Responsibility Leave'''');
              SET @InsertedLeave = @@ROWCOUNT;
              UPDATE dbo.StagingTimesheet SET IsProcessed = 1, ProcessedDate = GETDATE(), BatchID = @BatchID WHERE IsProcessed = 0;
              SET @UpdatedStaging = @@ROWCOUNT;
              INSERT INTO dbo.AuditLog (BatchID, TableName, OperationType, StatusCode, RowsInserted, RowsUpdated, RowsDeleted, HostName, ApplicationName, EventDateTime)
              VALUES (@BatchID, ''Migration'', ''COMPLETE'', ''SUCCESS'', @InsertedTimesheet + @InsertedLeave, @UpdatedStaging, @DeletedTimesheet + @DeletedLeave, HOST_NAME(), ''SQLAgentJob'', GETDATE());
              EXEC sp_releaseapplock @Resource = ''TimesheetMigrationLock'', @LockOwner = ''Session'';
          END TRY
          BEGIN CATCH
              SET @ErrorMsg = ERROR_MESSAGE();
              INSERT INTO dbo.AuditLog (BatchID, TableName, OperationType, StatusCode, RowsInserted, RowsUpdated, RowsDeleted, HostName, ApplicationName, EventDateTime, ErrorMessage)
              VALUES (@BatchID, ''Migration'', ''ERROR'', ''FAILED'', 0, 0, 0, HOST_NAME(), ''SQLAgentJob'', GETDATE(), @ErrorMsg);
              EXEC sp_releaseapplock @Resource = ''TimesheetMigrationLock'', @LockOwner = ''Session'';
          END CATCH',
              @retry_attempts = 0;

          EXEC msdb.dbo.sp_add_jobserver @job_id = @jobId, @server_name = N'(local)';
          "@

          Set-Content -Path $jobScriptPath -Value $provisionJobSql -Force
          sqlcmd -b -S $server -U $user -P $pass -d "msdb" -i $jobScriptPath

      - name: 5. Provision Scheduled SQL Agent Job
        shell: powershell
        run: |
          $server = "localhost"
          $user   = "${{ secrets.sql_username }}"
          $pass   = "${{ secrets.sql_password }}"
          $jobScriptPath = "$env:GITHUB_WORKSPACE\provision_job.sql"

          $provisionJobSql = @"
          USE [msdb];
          IF EXISTS (SELECT job_id FROM msdb.dbo.sysjobs WHERE name = N'RunTimesheetDataPipeline')
              EXEC msdb.dbo.sp_delete_job @job_name = N'RunTimesheetDataPipeline', @delete_unused_schedule = 1;

          DECLARE @jobId BINARY(16);
          EXEC msdb.dbo.sp_add_job @job_name = N'RunTimesheetDataPipeline', @enabled = 1, @job_id = @jobId OUTPUT;

          EXEC msdb.dbo.sp_add_jobstep @job_id = @jobId, @step_name = N'Run Integrated Package Process',
              @subsystem = N'SSIS',
              @command = N'/ISSERVER ""\SSISDB\TimesheetDataPipeline\TimesheetsMigrationSSIS\ImportTimesheets.dtsx"" /SERVER "."',
              @retry_attempts = 0;

          EXEC msdb.dbo.sp_add_jobschedule @job_id = @jobId, @name = N'Timesheet_30Sec_Interval', @enabled = 1,
              @freq_type = 4, @freq_interval = 1, @freq_subday_type = 2, @freq_subday_interval = 30;

          EXEC msdb.dbo.sp_add_jobserver @job_id = @jobId, @server_name = N'(local)';
          "@

          Set-Content -Path $jobScriptPath -Value $provisionJobSql -Force
          sqlcmd -b -S $server -U $user -P $pass -d "msdb" -i $jobScriptPath

      - name: 6. Trigger and Verify Migration
        shell: powershell
        run: |
          $server = "localhost"
          $user   = "${{ secrets.sql_username }}"
          $pass   = "${{ secrets.sql_password }}"
          $db     = "${{ inputs.database }}"

          Write-Host "Triggering spRunTimesheetMigration..."
          sqlcmd -b -S $server -U $user -P $pass -d $db -Q "EXEC dbo.spRunTimesheetMigration;"

          # sp_start_job is async, so poll sysjobactivity until the job's
          # most recent run has a stop_execution_date (i.e. it finished).
          $maxAttempts = 30
          $delaySeconds = 2
          $attempt = 0
          $completed = $false

          Write-Host "Waiting for RunTimesheetMigration job to complete..."
          while ($attempt -lt $maxAttempts -and -not $completed) {
            Start-Sleep -Seconds $delaySeconds
            $stopDate = sqlcmd -b -S $server -U $user -P $pass -d "msdb" -h -1 -W -Q "SET NOCOUNT ON; SELECT TOP 1 ISNULL(CONVERT(VARCHAR, sja.stop_execution_date, 121), '') FROM msdb.dbo.sysjobactivity sja JOIN msdb.dbo.sysjobs sj ON sja.job_id = sj.job_id WHERE sj.name = N'RunTimesheetMigration' AND sja.start_execution_date IS NOT NULL ORDER BY sja.start_execution_date DESC;"
            if ($stopDate -and $stopDate.Trim() -ne "") {
              $completed = $true
            }
            $attempt++
          }

          if (-not $completed) {
            throw "RunTimesheetMigration job did not complete within $($maxAttempts * $delaySeconds) seconds. Check SQL Server Agent job history on this machine."
          }

          Write-Host "Job finished. Checking AuditLog for the migration result..."
          $result = sqlcmd -b -S $server -U $user -P $pass -d $db -h -1 -W -s "|" -Q "SET NOCOUNT ON; SELECT TOP 1 BatchID, StatusCode, RowsInserted, RowsUpdated, RowsDeleted, ISNULL(ErrorMessage, '') FROM dbo.AuditLog WHERE TableName = 'Migration' AND OperationType = 'COMPLETE' ORDER BY AuditID DESC;"

          Write-Host "Latest migration result: $result"

          if ([string]::IsNullOrWhiteSpace($result)) {
            throw "No COMPLETE migration record found in AuditLog. The job may have failed before finishing -- check AuditLog for OperationType = 'ERROR'."
          }
          if ($result -match "FAILED") {
            throw "Migration reported StatusCode = FAILED. See AuditLog.ErrorMessage for details: $result"
          }

          Write-Host "Migration verified successfully."
