  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\Audit Database"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{8C21481C-3536-4ACA-9A51-6589997C6446}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Audit Database"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{16A86C43-4830-43D4-A266-FC379859D21C}"
          SQLTask:SqlStatementSource="-- ================================================================&#xA;-- CREATE AUDIT DATABASE AND TABLES&#xA;-- ================================================================&#xA;&#xA;-- Create database if not exists&#xA;IF NOT EXISTS (SELECT 1 FROM sys.databases WHERE name = 'Audittable')&#xA;BEGIN&#xA;    CREATE DATABASE Audittable;&#xA;    PRINT '✅ Audittable database created';&#xA;END&#xA;ELSE&#xA;    PRINT 'ℹ️ Audittable database already exists';&#xA;GO&#xA;&#xA;USE Audittable;&#xA;GO&#xA;&#xA;-- Drop existing tables (clean start)&#xA;IF EXISTS (SELECT 1 FROM sys.tables WHERE name = 'DataLineage') DROP TABLE DataLineage;&#xA;IF EXISTS (SELECT 1 FROM sys.tables WHERE name = 'DetailedMigrationErrors') DROP TABLE DetailedMigrationErrors;&#xA;IF EXISTS (SELECT 1 FROM sys.tables WHERE name = 'DeletedObjectsArchive') DROP TABLE DeletedObjectsArchive;&#xA;IF EXISTS (SELECT 1 FROM sys.tables WHERE name = 'AuditSummary') DROP TABLE AuditSummary;&#xA;IF EXISTS (SELECT 1 FROM sys.tables WHERE name = 'TimesheetAuditLog') DROP TABLE TimesheetAuditLog;&#xA;IF EXISTS (SELECT 1 FROM sys.tables WHERE name = 'MigrationBatchHistory') DROP TABLE MigrationBatchHistory;&#xA;&#xA;PRINT '✅ Cleaned up existing tables';&#xA;&#xA;-- Create MigrationBatchHistory&#xA;CREATE TABLE MigrationBatchHistory (&#xA;    BatchID INT IDENTITY(1,1) PRIMARY KEY,&#xA;    BatchGUID UNIQUEIDENTIFIER DEFAULT NEWID() NOT NULL,&#xA;    MigrationName NVARCHAR(200) NOT NULL,&#xA;    StartDateTime DATETIME2 NOT NULL DEFAULT GETUTCDATE(),&#xA;    EndDateTime DATETIME2 NULL,&#xA;    Status NVARCHAR(20) NOT NULL DEFAULT 'Running',&#xA;    TotalRecordsProcessed INT DEFAULT 0,&#xA;    TotalRecordsInserted INT DEFAULT 0,&#xA;    TotalRecordsUpdated INT DEFAULT 0,&#xA;    TotalRecordsDeleted INT DEFAULT 0,&#xA;    TotalRecordsFailed INT DEFAULT 0,&#xA;    ErrorMessage NVARCHAR(MAX) NULL,&#xA;    CreatedBy NVARCHAR(100) NULL&#xA;);&#xA;PRINT '✅ MigrationBatchHistory created';&#xA;&#xA;-- Create TimesheetAuditLog&#xA;CREATE TABLE TimesheetAuditLog (&#xA;    AuditID BIGINT IDENTITY(1,1) PRIMARY KEY,&#xA;    EventID UNIQUEIDENTIFIER DEFAULT NEWID() NOT NULL,&#xA;    EventType NVARCHAR(50) NOT NULL,&#xA;    DatabaseName NVARCHAR(128) NOT NULL,&#xA;    SchemaName NVARCHAR(128) NOT NULL,&#xA;    TableName NVARCHAR(128) NOT NULL,&#xA;    TableID INT NULL,&#xA;    OperationType NVARCHAR(20) NOT NULL,&#xA;    RecordID NVARCHAR(255) NULL,&#xA;    BeforeData NVARCHAR(MAX) NULL,&#xA;    AfterData NVARCHAR(MAX) NULL,&#xA;    ChangedColumns NVARCHAR(MAX) NULL,&#xA;    AffectedRows INT DEFAULT 1,&#xA;    ExecutingUser NVARCHAR(255) NOT NULL,&#xA;    HostName NVARCHAR(255) NULL,&#xA;    ApplicationName NVARCHAR(255) NULL,&#xA;    TransactionID UNIQUEIDENTIFIER NULL,&#xA;    BatchID INT NULL,&#xA;    EventDateTime DATETIME2 NOT NULL DEFAULT GETUTCDATE(),&#xA;    SessionID INT NULL,&#xA;    SPID INT NULL,&#xA;    CommandText NVARCHAR(MAX) NULL,&#xA;    ObjectDefinition NVARCHAR(MAX) NULL,&#xA;    IsDeletedObject BIT DEFAULT 0,&#xA;    RecoveredFromStorage BIT DEFAULT 0,&#xA;    ErrorMessage NVARCHAR(MAX) NULL,&#xA;    Status NVARCHAR(20) DEFAULT 'Success'&#xA;);&#xA;PRINT '✅ TimesheetAuditLog created';&#xA;&#xA;-- Create DeletedObjectsArchive&#xA;CREATE TABLE DeletedObjectsArchive (&#xA;    ArchiveID BIGINT IDENTITY(1,1) PRIMARY KEY,&#xA;    ObjectName NVARCHAR(255) NOT NULL,&#xA;    SchemaName NVARCHAR(128) NOT NULL,&#xA;    ObjectType NVARCHAR(50) NOT NULL,&#xA;    ObjectDefinition NVARCHAR(MAX) NULL,&#xA;    CreationDate DATETIME2 NULL,&#xA;    DeletionDate DATETIME2 NOT NULL DEFAULT GETUTCDATE(),&#xA;    DeletedBy NVARCHAR(255) NOT NULL,&#xA;    DropCommand NVARCHAR(MAX) NULL,&#xA;    ObjectID INT NULL,&#xA;    TableDataSnapshot NVARCHAR(MAX) NULL,&#xA;    RowCountBeforeDelete INT NULL,&#xA;    RecoveryStatus NVARCHAR(20) DEFAULT 'Pending'&#xA;);&#xA;PRINT '✅ DeletedObjectsArchive created';&#xA;&#xA;-- Create DetailedMigrationErrors&#xA;CREATE TABLE DetailedMigrationErrors (&#xA;    ErrorID BIGINT IDENTITY(1,1) PRIMARY KEY,&#xA;    BatchID INT NULL,&#xA;    AuditID BIGINT NULL,&#xA;    SourceTableName NVARCHAR(128) NOT NULL,&#xA;    TargetTableName NVARCHAR(128) NOT NULL,&#xA;    RecordID NVARCHAR(100) NULL,&#xA;    OperationType NVARCHAR(10) NULL,&#xA;    ErrorNumber INT NULL,&#xA;    ErrorSeverity INT NULL,&#xA;    ErrorState INT NULL,&#xA;    ErrorLine INT NULL,&#xA;    ErrorProcedure NVARCHAR(128) NULL,&#xA;    ErrorMessage NVARCHAR(MAX) NOT NULL,&#xA;    StackTrace NVARCHAR(MAX) NULL,&#xA;    AdditionalContext NVARCHAR(MAX) NULL,&#xA;    ErrorDateTime DATETIME2 NOT NULL DEFAULT GETUTCDATE(),&#xA;    Resolved BIT DEFAULT 0,&#xA;    ResolutionNotes NVARCHAR(MAX) NULL,&#xA;    ResolvedDateTime DATETIME2 NULL&#xA;);&#xA;PRINT '✅ DetailedMigrationErrors created';&#xA;&#xA;-- Create DataLineage&#xA;CREATE TABLE DataLineage (&#xA;    LineageID BIGINT IDENTITY(1,1) PRIMARY KEY,&#xA;    BatchID INT NOT NULL,&#xA;    SourceTableName NVARCHAR(128) NOT NULL,&#xA;    TargetTableName NVARCHAR(128) NOT NULL,&#xA;    SourceRecordID NVARCHAR(100) NOT NULL,&#xA;    TargetRecordID NVARCHAR(100) NULL,&#xA;    OperationType NVARCHAR(10) NOT NULL,&#xA;    AuditID BIGINT NULL,&#xA;    LineageDateTime DATETIME2 NOT NULL DEFAULT GETUTCDATE()&#xA;);&#xA;PRINT '✅ DataLineage created';&#xA;&#xA;-- Create AuditSummary&#xA;CREATE TABLE AuditSummary (&#xA;    SummaryDate DATE NOT NULL,&#xA;    EventType NVARCHAR(50) NOT NULL,&#xA;    TableName NVARCHAR(128) NOT NULL,&#xA;    EventCount INT NOT NULL DEFAULT 0,&#xA;    LastEventDateTime DATETIME2 NULL,&#xA;    PRIMARY KEY (SummaryDate, EventType, TableName)&#xA;);&#xA;PRINT '✅ AuditSummary created';&#xA;&#xA;-- Create indexes&#xA;CREATE NONCLUSTERED INDEX IX_TimesheetAuditLog_TableName ON TimesheetAuditLog(TableName) INCLUDE (EventDateTime, OperationType);&#xA;CREATE NONCLUSTERED INDEX IX_TimesheetAuditLog_EventDateTime ON TimesheetAuditLog(EventDateTime) INCLUDE (TableName, EventType);&#xA;CREATE NONCLUSTERED INDEX IX_TimesheetAuditLog_BatchID ON TimesheetAuditLog(BatchID);&#xA;CREATE NONCLUSTERED INDEX IX_MigrationBatchHistory_Status ON MigrationBatchHistory(Status);&#xA;CREATE NONCLUSTERED INDEX IX_MigrationBatchHistory_StartDateTime ON MigrationBatchHistory(StartDateTime);&#xA;CREATE NONCLUSTERED INDEX IX_DetailedMigrationErrors_BatchID ON DetailedMigrationErrors(BatchID);&#xA;CREATE NONCLUSTERED INDEX IX_DataLineage_SourceRecordID ON DataLineage(SourceRecordID);&#xA;CREATE NONCLUSTERED INDEX IX_DataLineage_BatchID ON DataLineage(BatchID);&#xA;&#xA;PRINT '✅ All indexes created';&#xA;PRINT '=========================================';&#xA;PRINT '✅ Audit database setup complete!';&#xA;PRINT '=========================================';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Audit Stored Porcedures"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{E67C3EE6-C453-4D71-8EBD-41AB7B86A451}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Audit Stored Porcedures"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{16A86C43-4830-43D4-A266-FC379859D21C}"
          SQLTask:SqlStatementSource="-- ================================================================&#xA;-- CREATE STORED PROCEDURES&#xA;-- ================================================================&#xA;&#xA;USE Audittable;&#xA;GO&#xA;&#xA;-- Drop existing procedures&#xA;IF OBJECT_ID('dbo.StartMigrationBatch', 'P') IS NOT NULL DROP PROCEDURE dbo.StartMigrationBatch;&#xA;IF OBJECT_ID('dbo.CompleteMigrationBatch', 'P') IS NOT NULL DROP PROCEDURE dbo.CompleteMigrationBatch;&#xA;IF OBJECT_ID('dbo.LogMigrationOperation', 'P') IS NOT NULL DROP PROCEDURE dbo.LogMigrationOperation;&#xA;IF OBJECT_ID('dbo.GetBatchSummary', 'P') IS NOT NULL DROP PROCEDURE dbo.GetBatchSummary;&#xA;&#xA;PRINT '✅ Dropped existing procedures';&#xA;&#xA;GO&#xA;&#xA;-- StartMigrationBatch&#xA;CREATE PROCEDURE dbo.StartMigrationBatch&#xA;    @MigrationName NVARCHAR(200),&#xA;    @CreatedBy NVARCHAR(100) = NULL,&#xA;    @BatchID INT OUTPUT&#xA;AS&#xA;BEGIN&#xA;    SET NOCOUNT ON;&#xA;    &#xA;    INSERT INTO dbo.MigrationBatchHistory (&#xA;        MigrationName, StartDateTime, Status, CreatedBy&#xA;    ) VALUES (&#xA;        @MigrationName, GETUTCDATE(), 'Running', @CreatedBy&#xA;    );&#xA;    &#xA;    SET @BatchID = SCOPE_IDENTITY();&#xA;    &#xA;    DECLARE @Context VARBINARY(128);&#xA;    SET @Context = CAST(@BatchID AS VARBINARY(128));&#xA;    SET CONTEXT_INFO @Context;&#xA;    &#xA;    INSERT INTO dbo.TimesheetAuditLog (&#xA;        EventType, DatabaseName, SchemaName, TableName,&#xA;        OperationType, RecordID, ExecutingUser, CommandText,&#xA;        EventDateTime, BatchID, Status&#xA;    ) VALUES (&#xA;        'BATCH_START', 'Audittable', 'dbo', 'MigrationBatchHistory',&#xA;        'START', '0', @CreatedBy, 'Migration started: ' + @MigrationName,&#xA;        GETUTCDATE(), @BatchID, 'Success'&#xA;    );&#xA;    &#xA;    PRINT '✅ Batch started with ID: ' + CAST(@BatchID AS NVARCHAR(10));&#xA;END;&#xA;GO&#xA;&#xA;-- CompleteMigrationBatch&#xA;CREATE PROCEDURE dbo.CompleteMigrationBatch&#xA;    @BatchID INT,&#xA;    @Status NVARCHAR(20) = 'Completed',&#xA;    @ErrorMessage NVARCHAR(MAX) = NULL&#xA;AS&#xA;BEGIN&#xA;    SET NOCOUNT ON;&#xA;    &#xA;    UPDATE dbo.MigrationBatchHistory&#xA;    SET EndDateTime = GETUTCDATE(),&#xA;        Status = @Status,&#xA;        ErrorMessage = @ErrorMessage&#xA;    WHERE BatchID = @BatchID;&#xA;    &#xA;    INSERT INTO dbo.TimesheetAuditLog (&#xA;        EventType, DatabaseName, SchemaName, TableName,&#xA;        OperationType, RecordID, ExecutingUser, CommandText,&#xA;        EventDateTime, BatchID, Status&#xA;    ) VALUES (&#xA;        'BATCH_COMPLETE', 'Audittable', 'dbo', 'MigrationBatchHistory',&#xA;        @Status, '0', SYSTEM_USER, &#xA;        'Migration completed with status: ' + @Status,&#xA;        GETUTCDATE(), @BatchID, &#xA;        CASE WHEN @Status = 'Completed' THEN 'Success' ELSE 'Failed' END&#xA;    );&#xA;    &#xA;    SET CONTEXT_INFO 0x00000000;&#xA;    &#xA;    PRINT '✅ Batch ' + CAST(@BatchID AS NVARCHAR(10)) + ' completed with status: ' + @Status;&#xA;END;&#xA;GO&#xA;&#xA;-- LogMigrationOperation&#xA;CREATE PROCEDURE dbo.LogMigrationOperation&#xA;    @BatchID INT,&#xA;    @SourceTableName NVARCHAR(128),&#xA;    @TargetTableName NVARCHAR(128),&#xA;    @OperationType NVARCHAR(10),&#xA;    @RecordID NVARCHAR(255),&#xA;    @BeforeData NVARCHAR(MAX) = NULL,&#xA;    @AfterData NVARCHAR(MAX) = NULL,&#xA;    @ChangedColumns NVARCHAR(MAX) = NULL,&#xA;    @Status NVARCHAR(20) = 'Success',&#xA;    @ErrorMessage NVARCHAR(MAX) = NULL,&#xA;    @AffectedRows INT = 1,&#xA;    @AuditID BIGINT OUTPUT&#xA;AS&#xA;BEGIN&#xA;    SET NOCOUNT ON;&#xA;    &#xA;    INSERT INTO dbo.TimesheetAuditLog (&#xA;        BatchID, DatabaseName, SchemaName, TableName,&#xA;        OperationType, RecordID, BeforeData, AfterData,&#xA;        ChangedColumns, Status, EventDateTime,&#xA;        AffectedRows, ErrorMessage, ExecutingUser&#xA;    ) VALUES (&#xA;        @BatchID, 'TimesheetDB', 'dbo', @SourceTableName,&#xA;        @OperationType, @RecordID, @BeforeData, @AfterData,&#xA;        @ChangedColumns, @Status, GETUTCDATE(),&#xA;        @AffectedRows, @ErrorMessage, SYSTEM_USER&#xA;    );&#xA;    &#xA;    SET @AuditID = SCOPE_IDENTITY();&#xA;    &#xA;    UPDATE dbo.MigrationBatchHistory&#xA;    SET TotalRecordsProcessed = TotalRecordsProcessed + 1,&#xA;        TotalRecordsInserted = TotalRecordsInserted + &#xA;            CASE WHEN @OperationType = 'INSERT' AND @Status = 'Success' THEN 1 ELSE 0 END,&#xA;        TotalRecordsUpdated = TotalRecordsUpdated + &#xA;            CASE WHEN @OperationType = 'UPDATE' AND @Status = 'Success' THEN 1 ELSE 0 END,&#xA;        TotalRecordsDeleted = TotalRecordsDeleted + &#xA;            CASE WHEN @OperationType = 'DELETE' AND @Status = 'Success' THEN 1 ELSE 0 END,&#xA;        TotalRecordsFailed = TotalRecordsFailed + &#xA;            CASE WHEN @Status != 'Success' THEN 1 ELSE 0 END&#xA;    WHERE BatchID = @BatchID;&#xA;END;&#xA;GO&#xA;&#xA;-- GetBatchSummary&#xA;CREATE PROCEDURE dbo.GetBatchSummary&#xA;    @BatchID INT&#xA;AS&#xA;BEGIN&#xA;    SET NOCOUNT ON;&#xA;    &#xA;    SELECT &#xA;        b.BatchID,&#xA;        b.BatchGUID,&#xA;        b.MigrationName,&#xA;        b.StartDateTime,&#xA;        b.EndDateTime,&#xA;        b.Status,&#xA;        b.TotalRecordsProcessed,&#xA;        b.TotalRecordsInserted,&#xA;        b.TotalRecordsUpdated,&#xA;        b.TotalRecordsDeleted,&#xA;        b.TotalRecordsFailed,&#xA;        b.ErrorMessage,&#xA;        b.CreatedBy,&#xA;        DATEDIFF(SECOND, b.StartDateTime, b.EndDateTime) AS DurationSeconds&#xA;    FROM dbo.MigrationBatchHistory b&#xA;    WHERE b.BatchID = @BatchID;&#xA;END;&#xA;GO&#xA;&#xA;PRINT '=========================================';&#xA;PRINT '✅ All stored procedures created successfully!';&#xA;PRINT '=========================================';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
