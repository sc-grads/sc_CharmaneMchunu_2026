          <ProjectItem
            Name="ScriptMain.cs"
            Encoding="UTF8"><![CDATA[#region Namespaces
using System;
using System.Data;
using System.Data.SqlClient;
using Microsoft.SqlServer.Dts.Runtime;
#endregion

namespace ST_StartAuditBatch
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        private bool fireAgain = false;

        public void Main()
        {
            try
            {
                Dts.Events.FireInformation(0, "Start Audit",
                    "🚀 Starting audit batch for TimesheetsMigrationSSIS...", "", 0, ref fireAgain);

                // Get connection string with proper format
                string auditConnString = GetConnectionString();

                if (string.IsNullOrEmpty(auditConnString))
                {
                    throw new Exception("Cannot get connection string. Please configure AuditConnection.");
                }

                // Get variables
                string migrationName = Dts.Variables["User::MigrationName"].Value?.ToString();

                if (string.IsNullOrEmpty(migrationName))
                {
                    migrationName = $"Timesheet_Import_{DateTime.Now:yyyyMMdd_HHmmss}";
                    Dts.Variables["User::MigrationName"].Value = migrationName;
                    Dts.Events.FireInformation(0, "Start Audit",
                        $"📋 Auto-generated Migration Name: {migrationName}", "", 0, ref fireAgain);
                }

                int batchID = 0;

                // Use SqlConnection with proper connection string
                using (SqlConnection conn = new SqlConnection(auditConnString))
                {
                    Dts.Events.FireInformation(0, "Start Audit",
                        "🔌 Opening connection to database...", "", 0, ref fireAgain);
                    conn.Open();
                    Dts.Events.FireInformation(0, "Start Audit",
                        "✅ Connection opened successfully", "", 0, ref fireAgain);

                    // Check if database exists
                    if (!DatabaseExists(conn))
                    {
                        Dts.Events.FireInformation(0, "Start Audit",
                            "📦 Audittable database not found. Creating it...", "", 0, ref fireAgain);
                        CreateAuditDatabase(conn);
                    }

                    // Check if stored procedures exist
                    if (!StoredProcedureExists(conn, "StartMigrationBatch"))
                    {
                        Dts.Events.FireInformation(0, "Start Audit",
                            "📦 Stored procedures not found. Creating them...", "", 0, ref fireAgain);
                        CreateStoredProcedures(conn);
                    }

                    // Start migration batch - pass application name
                    using (SqlCommand cmd = new SqlCommand("dbo.StartMigrationBatch", conn))
                    {
                        cmd.CommandType = CommandType.StoredProcedure;
                        cmd.CommandTimeout = 120;

                        // Add application name to migration name
                        string fullMigrationName = $"TimesheetsMigrationSSIS - {migrationName}";
                        cmd.Parameters.AddWithValue("@MigrationName", fullMigrationName);
                        cmd.Parameters.AddWithValue("@CreatedBy", Environment.UserName);

                        SqlParameter outputParam = new SqlParameter("@BatchID", SqlDbType.Int)
                        {
                            Direction = ParameterDirection.Output
                        };
                        cmd.Parameters.Add(outputParam);

                        cmd.ExecuteNonQuery();
                        batchID = Convert.ToInt32(outputParam.Value);
                    }

                    // Set context info for triggers
                    SetBatchContext(conn, batchID);
                }

                // Store BatchID
                Dts.Variables["User::BatchID"].Value = batchID;
                Dts.Variables["User::PackageStatus"].Value = "Running";

                Dts.Events.FireInformation(0, "Start Audit",
                    $"✅ Batch started successfully with ID: {batchID} for TimesheetsMigrationSSIS", "", 0, ref fireAgain);

                Dts.TaskResult = (int)ScriptResults.Success;
            }
            catch (SqlException sqlEx)
            {
                Dts.Events.FireError(0, "Start Audit",
                    $"❌ SQL Error: {sqlEx.Message} (Number: {sqlEx.Number})", "", 0);

                try
                {
                    Dts.Variables["User::ErrorMessage"].Value = sqlEx.Message;
                    Dts.Variables["User::PackageStatus"].Value = "Failed";
                }
                catch { }

                Dts.TaskResult = (int)ScriptResults.Failure;
            }
            catch (Exception ex)
            {
                Dts.Events.FireError(0, "Start Audit",
                    $"❌ Failed to start audit: {ex.Message}", "", 0);

                try
                {
                    Dts.Variables["User::ErrorMessage"].Value = ex.Message;
                    Dts.Variables["User::PackageStatus"].Value = "Failed";
                }
                catch { }

                Dts.TaskResult = (int)ScriptResults.Failure;
            }
        }

        private string GetConnectionString()
        {
            try
            {
                // Check both possible connection names
                string[] possibleNames = { "AuditConnection", "LocalHostAuditable" };

                foreach (string connName in possibleNames)
                {
                    if (Dts.Connections.Contains(connName))
                    {
                        Dts.Events.FireInformation(0, "GetConnectionString",
                            $"🔍 Found connection: {connName}", "", 0, ref fireAgain);

                        ConnectionManager cm = Dts.Connections[connName];
                        string connectionString = cm.ConnectionString;

                        // Remove Provider= if present (not supported by SqlConnection)
                        if (!string.IsNullOrEmpty(connectionString))
                        {
                            // Remove Provider= part
                            if (connectionString.Contains("Provider="))
                            {
                                string[] parts = connectionString.Split(';');
                                string cleanString = "";
                                foreach (string part in parts)
                                {
                                    if (!part.Trim().StartsWith("Provider=", StringComparison.OrdinalIgnoreCase))
                                    {
                                        cleanString += part + ";";
                                    }
                                }
                                connectionString = cleanString.TrimEnd(';');
                            }

                            // Ensure Data Source is present
                            if (!connectionString.Contains("Data Source="))
                            {
                                connectionString = "Data Source=localhost;" + connectionString;
                            }

                            // Ensure Integrated Security is present
                            if (!connectionString.Contains("Integrated Security="))
                            {
                                connectionString += ";Integrated Security=SSPI";
                            }

                            // Add Application Name
                            if (!connectionString.Contains("Application Name="))
                            {
                                connectionString += ";Application Name=TimesheetsMigrationSSIS";
                            }

                            return connectionString;
                        }
                    }
                }

                // Fallback connection string with Application Name
                string fallback = "Data Source=localhost;Initial Catalog=Audittable;Integrated Security=SSPI;Application Name=TimesheetsMigrationSSIS;";
                Dts.Events.FireWarning(0, "GetConnectionString",
                    $"⚠️ Using fallback connection", "", 0);
                return fallback;
            }
            catch (Exception ex)
            {
                Dts.Events.FireWarning(0, "GetConnectionString",
                    $"⚠️ Error getting connection: {ex.Message}", "", 0);

                // Final fallback with Application Name
                return "Data Source=localhost;Initial Catalog=Audittable;Integrated Security=SSPI;Application Name=TimesheetsMigrationSSIS;";
            }
        }

        private bool DatabaseExists(SqlConnection conn)
        {
            try
            {
                using (SqlCommand cmd = new SqlCommand(
                    "SELECT 1 FROM sys.databases WHERE name = 'Audittable'", conn))
                {
                    return cmd.ExecuteScalar() != null;
                }
            }
            catch
            {
                return false;
            }
        }

        private bool StoredProcedureExists(SqlConnection conn, string procName)
        {
            try
            {
                using (SqlCommand cmd = new SqlCommand(
                    "SELECT 1 FROM Audittable.sys.procedures WHERE name = @ProcName", conn))
                {
                    cmd.Parameters.AddWithValue("@ProcName", procName);
                    return cmd.ExecuteScalar() != null;
                }
            }
            catch
            {
                return false;
            }
        }

        private void CreateAuditDatabase(SqlConnection conn)
        {
            try
            {
                using (SqlCommand cmd = new SqlCommand(
                    "CREATE DATABASE Audittable", conn))
                {
                    cmd.ExecuteNonQuery();
                    Dts.Events.FireInformation(0, "CreateAuditDatabase",
                        "✅ Audittable database created successfully!", "", 0, ref fireAgain);
                }
            }
            catch (Exception ex)
            {
                Dts.Events.FireWarning(0, "CreateAuditDatabase",
                    $"⚠️ Failed to create database: {ex.Message}", "", 0);
            }
        }

        private void CreateStoredProcedures(SqlConnection conn)
        {
            try
            {
                string sql = @"
                USE Audittable;
                GO

                IF OBJECT_ID('dbo.StartMigrationBatch', 'P') IS NOT NULL DROP PROCEDURE dbo.StartMigrationBatch;
                IF OBJECT_ID('dbo.CompleteMigrationBatch', 'P') IS NOT NULL DROP PROCEDURE dbo.CompleteMigrationBatch;
                IF OBJECT_ID('dbo.LogMigrationOperation', 'P') IS NOT NULL DROP PROCEDURE dbo.LogMigrationOperation;
                IF OBJECT_ID('dbo.GetBatchSummary', 'P') IS NOT NULL DROP PROCEDURE dbo.GetBatchSummary;
                GO

                CREATE PROCEDURE dbo.StartMigrationBatch
                    @MigrationName NVARCHAR(200),
                    @CreatedBy NVARCHAR(100) = NULL,
                    @BatchID INT OUTPUT
                AS
                BEGIN
                    SET NOCOUNT ON;
                    
                    INSERT INTO dbo.MigrationBatchHistory (
                        MigrationName, StartDateTime, Status, CreatedBy
                    ) VALUES (
                        @MigrationName, GETUTCDATE(), 'Running', @CreatedBy
                    );
                    
                    SET @BatchID = SCOPE_IDENTITY();
                    
                    DECLARE @Context VARBINARY(128);
                    SET @Context = CAST(@BatchID AS VARBINARY(128));
                    SET CONTEXT_INFO @Context;
                    
                    INSERT INTO dbo.TimesheetAuditLog (
                        EventType, DatabaseName, SchemaName, TableName,
                        OperationType, RecordID, ExecutingUser, CommandText,
                        EventDateTime, BatchID, Status
                    ) VALUES (
                        'BATCH_START', 'Audittable', 'dbo', 'MigrationBatchHistory',
                        'START', '0', @CreatedBy, 'Migration started: ' + @MigrationName,
                        GETUTCDATE(), @BatchID, 'Success'
                    );
                END;
                GO

                CREATE PROCEDURE dbo.CompleteMigrationBatch
                    @BatchID INT,
                    @Status NVARCHAR(20) = 'Completed',
                    @ErrorMessage NVARCHAR(MAX) = NULL
                AS
                BEGIN
                    SET NOCOUNT ON;
                    
                    UPDATE dbo.MigrationBatchHistory
                    SET EndDateTime = GETUTCDATE(),
                        Status = @Status,
                        ErrorMessage = @ErrorMessage
                    WHERE BatchID = @BatchID;
                    
                    INSERT INTO dbo.TimesheetAuditLog (
                        EventType, DatabaseName, SchemaName, TableName,
                        OperationType, RecordID, ExecutingUser, CommandText,
                        EventDateTime, BatchID, Status
                    ) VALUES (
                        'BATCH_COMPLETE', 'Audittable', 'dbo', 'MigrationBatchHistory',
                        @Status, '0', SYSTEM_USER, 
                        'Migration completed with status: ' + @Status,
                        GETUTCDATE(), @BatchID, 
                        CASE WHEN @Status = 'Completed' THEN 'Success' ELSE 'Failed' END
                    );
                    
                    SET CONTEXT_INFO 0x00000000;
                END;
                GO

                CREATE PROCEDURE dbo.LogMigrationOperation
                    @BatchID INT,
                    @SourceTableName NVARCHAR(128),
                    @TargetTableName NVARCHAR(128),
                    @OperationType NVARCHAR(10),
                    @RecordID NVARCHAR(255),
                    @BeforeData NVARCHAR(MAX) = NULL,
                    @AfterData NVARCHAR(MAX) = NULL,
                    @ChangedColumns NVARCHAR(MAX) = NULL,
                    @Status NVARCHAR(20) = 'Success',
                    @ErrorMessage NVARCHAR(MAX) = NULL,
                    @AffectedRows INT = 1,
                    @AuditID BIGINT OUTPUT
                AS
                BEGIN
                    SET NOCOUNT ON;
                    
                    INSERT INTO dbo.TimesheetAuditLog (
                        BatchID, DatabaseName, SchemaName, TableName,
                        OperationType, RecordID, BeforeData, AfterData,
                        ChangedColumns, Status, EventDateTime,
                        AffectedRows, ErrorMessage, ExecutingUser
                    ) VALUES (
                        @BatchID, 'TimesheetDB', 'dbo', @SourceTableName,
                        @OperationType, @RecordID, @BeforeData, @AfterData,
                        @ChangedColumns, @Status, GETUTCDATE(),
                        @AffectedRows, @ErrorMessage, SYSTEM_USER
                    );
                    
                    SET @AuditID = SCOPE_IDENTITY();
                    
                    UPDATE dbo.MigrationBatchHistory
                    SET TotalRecordsProcessed = TotalRecordsProcessed + 1,
                        TotalRecordsInserted = TotalRecordsInserted + 
                            CASE WHEN @OperationType = 'INSERT' AND @Status = 'Success' THEN 1 ELSE 0 END,
                        TotalRecordsUpdated = TotalRecordsUpdated + 
                            CASE WHEN @OperationType = 'UPDATE' AND @Status = 'Success' THEN 1 ELSE 0 END,
                        TotalRecordsDeleted = TotalRecordsDeleted + 
                            CASE WHEN @OperationType = 'DELETE' AND @Status = 'Success' THEN 1 ELSE 0 END,
                        TotalRecordsFailed = TotalRecordsFailed + 
                            CASE WHEN @Status != 'Success' THEN 1 ELSE 0 END
                    WHERE BatchID = @BatchID;
                END;
                GO

                CREATE PROCEDURE dbo.GetBatchSummary
                    @BatchID INT
                AS
                BEGIN
                    SET NOCOUNT ON;
                    
                    SELECT 
                        b.BatchID,
                        b.BatchGUID,
                        b.MigrationName,
                        b.StartDateTime,
                        b.EndDateTime,
                        b.Status,
                        b.TotalRecordsProcessed,
                        b.TotalRecordsInserted,
                        b.TotalRecordsUpdated,
                        b.TotalRecordsDeleted,
                        b.TotalRecordsFailed,
                        b.ErrorMessage,
                        b.CreatedBy,
                        DATEDIFF(SECOND, b.StartDateTime, b.EndDateTime) AS DurationSeconds
                    FROM dbo.MigrationBatchHistory b
                    WHERE b.BatchID = @BatchID;
                END;
                GO";

                using (SqlCommand cmd = new SqlCommand(sql, conn))
                {
                    cmd.CommandTimeout = 300;
                    cmd.ExecuteNonQuery();
                    Dts.Events.FireInformation(0, "CreateStoredProcedures",
                        "✅ Stored procedures created successfully!", "", 0, ref fireAgain);
                }
            }
            catch (Exception ex)
            {
                Dts.Events.FireWarning(0, "CreateStoredProcedures",
                    $"⚠️ Failed to create stored procedures: {ex.Message}", "", 0);
            }
        }

        private void SetBatchContext(SqlConnection conn, int batchID)
        {
            try
            {
                using (SqlCommand cmd = new SqlCommand("SET CONTEXT_INFO = @BatchID", conn))
                {
                    byte[] contextValue = BitConverter.GetBytes(batchID);
                    cmd.Parameters.AddWithValue("@BatchID", contextValue);
                    cmd.ExecuteNonQuery();
                }
            }
            catch (Exception ex)
            {
                Dts.Events.FireWarning(0, "Set Context",
                    $"⚠️ Failed to set context: {ex.Message}", "", 0);
            }
        }

        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
    }
}]]></ProjectItem>
