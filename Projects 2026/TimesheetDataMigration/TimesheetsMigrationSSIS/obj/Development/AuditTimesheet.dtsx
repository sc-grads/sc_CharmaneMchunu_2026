          <ProjectItem
            Name="ScriptMain.cs"
            Encoding="UTF8"><![CDATA[#region Namespaces
using System;
using System.Data;
using System.Data.SqlClient;
using Microsoft.SqlServer.Dts.Runtime;
using System.Text;
#endregion

namespace ST_CompleteAuditBatch
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        private bool fireAgain = false;

        public void Main()
        {
            try
            {
                Dts.Events.FireInformation(0, "Complete Audit",
                    "📊 Completing audit batch for TimesheetsMigrationSSIS...", "", 0, ref fireAgain);

                // Get connection string
                string auditConnString = GetConnectionString();
                int batchID = (int)Dts.Variables["User::BatchID"].Value;
                int importResult = (int)Dts.Variables["User::ImportResult"].Value;

                if (batchID == 0)
                {
                    throw new Exception("BatchID is 0. Start Audit Batch must run first!");
                }

                string status = "Completed";
                string errorMessage = null;

                // Check import result
                if (importResult != 0)
                {
                    status = "Failed";
                    errorMessage = $"ImportTimesheets package failed with code: {importResult}";

                    Dts.Variables["User::PackageStatus"].Value = "Failed";
                    Dts.Variables["User::ErrorMessage"].Value = errorMessage;

                    Dts.Events.FireWarning(0, "Complete Audit",
                        $"⚠️ ImportTimesheets failed with code: {importResult}", "", 0);
                }

                using (SqlConnection conn = new SqlConnection(auditConnString))
                {
                    conn.Open();

                    using (SqlTransaction transaction = conn.BeginTransaction())
                    {
                        try
                        {
                            // Complete the batch
                            using (SqlCommand cmd = new SqlCommand("dbo.CompleteMigrationBatch", conn, transaction))
                            {
                                cmd.CommandType = CommandType.StoredProcedure;
                                cmd.CommandTimeout = 120;
                                cmd.Parameters.AddWithValue("@BatchID", batchID);
                                cmd.Parameters.AddWithValue("@Status", status);
                                cmd.Parameters.AddWithValue("@ErrorMessage", (object)errorMessage ?? DBNull.Value);
                                cmd.ExecuteNonQuery();
                            }

                            // Clear context info
                            using (SqlCommand cmd = new SqlCommand("SET CONTEXT_INFO 0x00000000", conn, transaction))
                            {
                                cmd.ExecuteNonQuery();
                            }

                            // Get final statistics
                            GetBatchStatistics(conn, transaction, batchID, status);

                            transaction.Commit();

                            Dts.Events.FireInformation(0, "Complete Audit",
                                $"✅ Batch {batchID} completed with status: {status} for TimesheetsMigrationSSIS", "", 0, ref fireAgain);
                        }
                        catch
                        {
                            transaction.Rollback();
                            throw;
                        }
                    }
                }

                Dts.TaskResult = (int)ScriptResults.Success;
            }
            catch (Exception ex)
            {
                Dts.Events.FireError(0, "Complete Audit",
                    $"❌ Failed to complete audit: {ex.Message}", "", 0);

                try
                {
                    Dts.Variables["User::ErrorMessage"].Value = ex.Message;
                    Dts.Variables["User::PackageStatus"].Value = "Failed";
                }
                catch { }

                Dts.TaskResult = (int)ScriptResults.Failure;
            }
        }

        private string GetConnectionString()
        {
            try
            {
                string[] possibleNames = { "AuditConnection", "LocalHostAuditable" };

                foreach (string connName in possibleNames)
                {
                    if (Dts.Connections.Contains(connName))
                    {
                        ConnectionManager cm = Dts.Connections[connName];
                        string connectionString = cm.ConnectionString;

                        if (!string.IsNullOrEmpty(connectionString))
                        {
                            // Remove Provider= if present
                            if (connectionString.Contains("Provider="))
                            {
                                string[] parts = connectionString.Split(';');
                                string cleanString = "";
                                foreach (string part in parts)
                                {
                                    if (!part.Trim().StartsWith("Provider=", StringComparison.OrdinalIgnoreCase))
                                    {
                                        cleanString += part + ";";
                                    }
                                }
                                connectionString = cleanString.TrimEnd(';');
                            }

                            // Add Application Name
                            if (!connectionString.Contains("Application Name="))
                            {
                                connectionString += ";Application Name=TimesheetsMigrationSSIS";
                            }

                            return connectionString;
                        }
                    }
                }

                return "Data Source=localhost;Initial Catalog=Audittable;Integrated Security=SSPI;Application Name=TimesheetsMigrationSSIS;";
            }
            catch
            {
                return "Data Source=localhost;Initial Catalog=Audittable;Integrated Security=SSPI;Application Name=TimesheetsMigrationSSIS;";
            }
        }

        private void GetBatchStatistics(SqlConnection conn, SqlTransaction transaction, int batchID, string status)
        {
            try
            {
                using (SqlCommand cmd = new SqlCommand(@"
                    SELECT 
                        TotalRecordsProcessed,
                        TotalRecordsInserted,
                        TotalRecordsUpdated,
                        TotalRecordsDeleted,
                        TotalRecordsFailed,
                        StartDateTime,
                        EndDateTime
                    FROM dbo.MigrationBatchHistory
                    WHERE BatchID = @BatchID
                ", conn, transaction))
                {
                    cmd.Parameters.AddWithValue("@BatchID", batchID);

                    using (SqlDataReader reader = cmd.ExecuteReader())
                    {
                        if (reader.Read())
                        {
                            int processed = reader.GetInt32(0);
                            int inserted = reader.GetInt32(1);
                            int updated = reader.GetInt32(2);
                            int deleted = reader.GetInt32(3);
                            int failed = reader.GetInt32(4);
                            DateTime startTime = reader.GetDateTime(5);
                            DateTime endTime = reader.GetDateTime(6);
                            TimeSpan duration = endTime - startTime;
                            string migrationName = Dts.Variables["User::MigrationName"].Value?.ToString() ?? "Unknown";

                            string separator = new string('=', 50);

                            StringBuilder stats = new StringBuilder();
                            stats.AppendLine($"📊 {separator}");
                            stats.AppendLine($"📊 FINAL AUDIT STATISTICS - TimesheetsMigrationSSIS");
                            stats.AppendLine($"📊 {separator}");
                            stats.AppendLine($"   📋 Migration: {migrationName}");
                            stats.AppendLine($"   📊 Status: {status}");
                            stats.AppendLine($"   📝 Total Processed: {processed:N0}");
                            stats.AppendLine($"   ✅ Inserted: {inserted:N0}");
                            stats.AppendLine($"   🔄 Updated: {updated:N0}");
                            stats.AppendLine($"   ❌ Deleted: {deleted:N0}");
                            stats.AppendLine($"   ⚠️ Failed: {failed:N0}");
                            stats.AppendLine($"   ⏱️ Duration: {duration.TotalMinutes:F2} minutes");

                            if (processed > 0)
                            {
                                double successRate = ((processed - failed) * 100.0) / processed;
                                stats.AppendLine($"   📈 Success Rate: {successRate:F2}%");
                            }
                            stats.AppendLine($"📊 {separator}");

                            Dts.Events.FireInformation(0, "Statistics",
                                stats.ToString(), "", 0, ref fireAgain);
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Dts.Events.FireWarning(0, "Statistics",
                    $"⚠️ Failed to get statistics: {ex.Message}", "", 0);
            }
        }

        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
    }
}]]></ProjectItem>
