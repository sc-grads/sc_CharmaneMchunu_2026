    <DTS:Executable
      DTS:refId="Package\Triggers"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{FFA137BF-D2F4-4DAF-A224-B9AC97AFC1D3}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="Triggers">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Triggers\Execute SQL Task"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{52436C4E-F48E-4282-AA7A-9E5171F4A977}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Execute SQL Task"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{162FBE0A-C9D2-4D5C-B10A-713428FCAD7D}"
              SQLTask:SqlStatementSource="USE TimesheetDB;&#xA;GO&#xA;&#xA;IF EXISTS (SELECT 1 FROM sys.foreign_keys WHERE name = 'FK_DataMovementAudit_Batch')&#xA;    ALTER TABLE dbo.DataMovementAudit DROP CONSTRAINT FK_DataMovementAudit_Batch;&#xA;&#xA;IF EXISTS (SELECT 1 FROM sys.foreign_keys WHERE name = 'FK_MigrationErrors_Batch')&#xA;    ALTER TABLE dbo.MigrationErrors DROP CONSTRAINT FK_MigrationErrors_Batch;&#xA;&#xA;PRINT '✅ Foreign key constraints dropped';&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Triggers\Trigger"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{AB4B37B5-05A1-446F-AADD-1BA2E7BDD947}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Trigger"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{162FBE0A-C9D2-4D5C-B10A-713428FCAD7D}"
              SQLTask:SqlStatementSource="USE TimesheetDB;&#xA;GO&#xA;&#xA;-- ================================================================&#xA;-- 1. FIXED: StagingTimesheet Update Audit Trigger&#xA;-- ================================================================&#xA;DROP TRIGGER IF EXISTS dbo.trg_StagingTimesheet_UpdateAudit;&#xA;GO&#xA;&#xA;CREATE TRIGGER dbo.trg_StagingTimesheet_UpdateAudit&#xA;ON dbo.StagingTimesheet&#xA;AFTER UPDATE&#xA;AS&#xA;BEGIN&#xA;    SET NOCOUNT ON;&#xA;    &#xA;    -- Try to get BatchID from context info (set by Script Task)&#xA;    DECLARE @BatchID INT = CAST(CONTEXT_INFO() AS INT);&#xA;    &#xA;    -- If context info is NULL or 0, try to get the latest running batch&#xA;    IF @BatchID IS NULL OR @BatchID = 0&#xA;    BEGIN&#xA;        SELECT TOP 1 @BatchID = BatchID&#xA;        FROM dbo.MigrationBatch&#xA;        WHERE StatusCode = 'RUNNING'&#xA;        ORDER BY StartDateTime DESC;&#xA;    END&#xA;    &#xA;    -- If still no batch, use the latest completed batch&#xA;    IF @BatchID IS NULL OR @BatchID = 0&#xA;    BEGIN&#xA;        SELECT TOP 1 @BatchID = BatchID&#xA;        FROM dbo.MigrationBatch&#xA;        ORDER BY StartDateTime DESC;&#xA;    END&#xA;    &#xA;    -- Ultimate fallback&#xA;    IF @BatchID IS NULL SET @BatchID = 0;&#xA;    &#xA;    DECLARE @RecordID NVARCHAR(255);&#xA;    DECLARE @BeforeData NVARCHAR(MAX);&#xA;    DECLARE @AfterData NVARCHAR(MAX);&#xA;    DECLARE @AuditID BIGINT;&#xA;    &#xA;    BEGIN TRY&#xA;        -- Only log when IsProcessed changes from 0 to 1&#xA;        IF UPDATE(IsProcessed)&#xA;        BEGIN&#xA;            INSERT INTO dbo.DataMovementAudit (&#xA;                BatchID,&#xA;                TableName,&#xA;                OperationType,&#xA;                RecordID,&#xA;                BeforeData,&#xA;                AfterData,&#xA;                ChangedColumns,&#xA;                AffectedRows,&#xA;                StatusCode,&#xA;                ExecutingUser,&#xA;                HostName,&#xA;                ApplicationName,&#xA;                EventDateTime&#xA;            )&#xA;            SELECT &#xA;                @BatchID,&#xA;                'StagingTimesheet',&#xA;                'UPDATE',&#xA;                CAST(d.StagingID AS NVARCHAR(255)),&#xA;                'Processed: ' + CAST(d.IsProcessed AS NVARCHAR(5)),&#xA;                'Processed: ' + CAST(i.IsProcessed AS NVARCHAR(5)),&#xA;                '[&quot;IsProcessed&quot;]',&#xA;                1,&#xA;                'SUCCESS',&#xA;                SYSTEM_USER,&#xA;                HOST_NAME(),&#xA;                APP_NAME(),&#xA;                GETUTCDATE()&#xA;            FROM deleted d&#xA;            INNER JOIN inserted i ON d.StagingID = i.StagingID&#xA;            WHERE d.IsProcessed = 0 AND i.IsProcessed = 1;&#xA;        END&#xA;    END TRY&#xA;    BEGIN CATCH&#xA;        -- Silent fail - don't break the transaction&#xA;        DECLARE @ErrMsg NVARCHAR(MAX) = ERROR_MESSAGE();&#xA;        DECLARE @ErrNum INT = ERROR_NUMBER();&#xA;        &#xA;        -- Log to MigrationErrors if exists&#xA;        IF EXISTS (SELECT 1 FROM sys.tables WHERE name = 'MigrationErrors')&#xA;        BEGIN&#xA;            INSERT INTO dbo.MigrationErrors (&#xA;                BatchID, TableName, RecordID, OperationType,&#xA;                ErrorCode, ErrorMessage, ErrorDateTime&#xA;            ) VALUES (&#xA;                @BatchID, 'StagingTimesheet', 'ERROR', 'TRIGGER',&#xA;                @ErrNum, @ErrMsg, GETUTCDATE()&#xA;            );&#xA;        END&#xA;    END CATCH&#xA;END;&#xA;GO&#xA;&#xA;PRINT '✅ trg_StagingTimesheet_UpdateAudit created';&#xA;GO&#xA;&#xA;-- ================================================================&#xA;-- 2. FIXED: TimesheetEntry Audit Trigger (Unified BatchID)&#xA;-- ================================================================&#xA;DROP TRIGGER IF EXISTS dbo.trg_TimesheetEntry_Audit;&#xA;GO&#xA;&#xA;CREATE TRIGGER dbo.trg_TimesheetEntry_Audit&#xA;ON dbo.TimesheetEntry&#xA;AFTER INSERT, UPDATE, DELETE&#xA;AS&#xA;BEGIN&#xA;    SET NOCOUNT ON;&#xA;    &#xA;    -- ============================================================&#xA;    -- GET BATCHID - Unified approach&#xA;    -- ============================================================&#xA;    DECLARE @BatchID INT;&#xA;    &#xA;    -- METHOD 1: Try context info first (set by Script Task)&#xA;    SET @BatchID = CAST(CONTEXT_INFO() AS INT);&#xA;    &#xA;    -- METHOD 2: If null or 0, get latest running batch&#xA;    IF @BatchID IS NULL OR @BatchID = 0&#xA;    BEGIN&#xA;        SELECT TOP 1 @BatchID = BatchID&#xA;        FROM dbo.MigrationBatch&#xA;        WHERE StatusCode = 'RUNNING'&#xA;        ORDER BY StartDateTime DESC;&#xA;    END&#xA;    &#xA;    -- METHOD 3: If still null, get latest batch (any status)&#xA;    IF @BatchID IS NULL OR @BatchID = 0&#xA;    BEGIN&#xA;        SELECT TOP 1 @BatchID = BatchID&#xA;        FROM dbo.MigrationBatch&#xA;        ORDER BY StartDateTime DESC;&#xA;    END&#xA;    &#xA;    -- METHOD 4: Ultimate fallback&#xA;    IF @BatchID IS NULL OR @BatchID = 0&#xA;    BEGIN&#xA;        -- Create a default batch&#xA;        INSERT INTO dbo.MigrationBatch (&#xA;            BatchName, StatusCode, CreatedBy&#xA;        ) VALUES (&#xA;            'DEFAULT_AUDIT_BATCH_' + CONVERT(NVARCHAR(20), GETDATE(), 112),&#xA;            'RUNNING',&#xA;            'TRIGGER'&#xA;        );&#xA;        SET @BatchID = SCOPE_IDENTITY();&#xA;    END&#xA;    &#xA;    -- ============================================================&#xA;    -- INSERT AUDIT&#xA;    -- ============================================================&#xA;    IF EXISTS (SELECT 1 FROM inserted) AND NOT EXISTS (SELECT 1 FROM deleted)&#xA;    BEGIN&#xA;        INSERT INTO dbo.DataMovementAudit (&#xA;            BatchID, TableName, OperationType, RecordID,&#xA;            AfterData, AffectedRows, StatusCode,&#xA;            ExecutingUser, HostName, ApplicationName, EventDateTime&#xA;        )&#xA;        SELECT&#xA;            @BatchID,&#xA;            'TimesheetEntry',&#xA;            'INSERT',&#xA;            CAST(i.EntryID AS NVARCHAR(255)),&#xA;            CONCAT(&#xA;                'EmployeeID:', i.EmployeeID,&#xA;                ', Client:', ISNULL(i.Client,''),&#xA;                ', Project:', ISNULL(i.ProjectName,''),&#xA;                ', Hours:', ISNULL(i.TotalHours,0)&#xA;            ),&#xA;            1,&#xA;            'SUCCESS',&#xA;            SYSTEM_USER, HOST_NAME(), APP_NAME(),&#xA;            GETUTCDATE()&#xA;        FROM inserted i;&#xA;    END&#xA;    &#xA;    -- ============================================================&#xA;    -- UPDATE AUDIT&#xA;    -- ============================================================&#xA;    IF EXISTS (SELECT 1 FROM inserted) AND EXISTS (SELECT 1 FROM deleted)&#xA;    BEGIN&#xA;        INSERT INTO dbo.DataMovementAudit (&#xA;            BatchID, TableName, OperationType, RecordID,&#xA;            BeforeData, AfterData, ChangedColumns, AffectedRows,&#xA;            StatusCode, ExecutingUser, HostName, ApplicationName, EventDateTime&#xA;        )&#xA;        SELECT&#xA;            @BatchID,&#xA;            'TimesheetEntry',&#xA;            'UPDATE',&#xA;            CAST(i.EntryID AS NVARCHAR(255)),&#xA;            CONCAT(&#xA;                'Old Client:', d.Client,&#xA;                ', Old Hours:', d.TotalHours&#xA;            ),&#xA;            CONCAT(&#xA;                'New Client:', i.Client,&#xA;                ', New Hours:', i.TotalHours&#xA;            ),&#xA;            '[&quot;Client&quot;,&quot;TotalHours&quot;]',&#xA;            1,&#xA;            'SUCCESS',&#xA;            SYSTEM_USER, HOST_NAME(), APP_NAME(),&#xA;            GETUTCDATE()&#xA;        FROM inserted i&#xA;        INNER JOIN deleted d ON i.EntryID = d.EntryID;&#xA;    END&#xA;    &#xA;    -- ============================================================&#xA;    -- DELETE AUDIT&#xA;    -- ============================================================&#xA;    IF NOT EXISTS (SELECT 1 FROM inserted) AND EXISTS (SELECT 1 FROM deleted)&#xA;    BEGIN&#xA;        INSERT INTO dbo.DataMovementAudit (&#xA;            BatchID, TableName, OperationType, RecordID,&#xA;            BeforeData, AffectedRows, StatusCode,&#xA;            ExecutingUser, HostName, ApplicationName, EventDateTime&#xA;        )&#xA;        SELECT&#xA;            @BatchID,&#xA;            'TimesheetEntry',&#xA;            'DELETE',&#xA;            CAST(d.EntryID AS NVARCHAR(255)),&#xA;            CONCAT(&#xA;                'Deleted Client:', d.Client,&#xA;                ', Hours:', d.TotalHours&#xA;            ),&#xA;            1,&#xA;            'SUCCESS',&#xA;            SYSTEM_USER, HOST_NAME(), APP_NAME(),&#xA;            GETUTCDATE()&#xA;        FROM deleted d;&#xA;    END&#xA;END;&#xA;GO&#xA;&#xA;PRINT '✅ trg_TimesheetEntry_Audit created';&#xA;GO&#xA;&#xA;-- ================================================================&#xA;-- 3. FIXED: Leave Audit Trigger&#xA;-- ================================================================&#xA;DROP TRIGGER IF EXISTS dbo.trg_Leave_Audit;&#xA;GO&#xA;&#xA;CREATE TRIGGER dbo.trg_Leave_Audit&#xA;ON dbo.Leave&#xA;AFTER INSERT, UPDATE, DELETE&#xA;AS&#xA;BEGIN&#xA;    SET NOCOUNT ON;&#xA;    &#xA;    -- Unified BatchID approach&#xA;    DECLARE @BatchID INT = CAST(CONTEXT_INFO() AS INT);&#xA;    &#xA;    IF @BatchID IS NULL OR @BatchID = 0&#xA;    BEGIN&#xA;        SELECT TOP 1 @BatchID = BatchID&#xA;        FROM dbo.MigrationBatch&#xA;        WHERE StatusCode = 'RUNNING'&#xA;        ORDER BY StartDateTime DESC;&#xA;    END&#xA;    &#xA;    IF @BatchID IS NULL OR @BatchID = 0&#xA;    BEGIN&#xA;        SELECT TOP 1 @BatchID = BatchID&#xA;        FROM dbo.MigrationBatch&#xA;        ORDER BY StartDateTime DESC;&#xA;    END&#xA;    &#xA;    IF @BatchID IS NULL SET @BatchID = 0;&#xA;    &#xA;    -- INSERT&#xA;    IF EXISTS (SELECT 1 FROM inserted) AND NOT EXISTS (SELECT 1 FROM deleted)&#xA;    BEGIN&#xA;        INSERT INTO dbo.DataMovementAudit (&#xA;            BatchID, TableName, OperationType, RecordID,&#xA;            AfterData, AffectedRows, StatusCode,&#xA;            ExecutingUser, HostName, ApplicationName, EventDateTime&#xA;        )&#xA;        SELECT&#xA;            @BatchID,&#xA;            'Leave',&#xA;            'INSERT',&#xA;            CAST(i.LeaveID AS NVARCHAR(255)),&#xA;            CONCAT(&#xA;                'EmployeeID:', i.EmployeeID,&#xA;                ', LeaveType:', i.LeaveType,&#xA;                ', Days:', i.LeaveDays&#xA;            ),&#xA;            1,&#xA;            'SUCCESS',&#xA;            SYSTEM_USER, HOST_NAME(), APP_NAME(),&#xA;            GETUTCDATE()&#xA;        FROM inserted i;&#xA;    END&#xA;    &#xA;    -- UPDATE&#xA;    IF EXISTS (SELECT 1 FROM inserted) AND EXISTS (SELECT 1 FROM deleted)&#xA;    BEGIN&#xA;        INSERT INTO dbo.DataMovementAudit (&#xA;            BatchID, TableName, OperationType, RecordID,&#xA;            BeforeData, AfterData, ChangedColumns, AffectedRows,&#xA;            StatusCode, ExecutingUser, HostName, ApplicationName, EventDateTime&#xA;        )&#xA;        SELECT&#xA;            @BatchID,&#xA;            'Leave',&#xA;            'UPDATE',&#xA;            CAST(i.LeaveID AS NVARCHAR(255)),&#xA;            CONCAT(&#xA;                'Old Type:', d.LeaveType,&#xA;                ', Old Days:', d.LeaveDays&#xA;            ),&#xA;            CONCAT(&#xA;                'New Type:', i.LeaveType,&#xA;                ', New Days:', i.LeaveDays&#xA;            ),&#xA;            '[&quot;LeaveType&quot;,&quot;LeaveDays&quot;]',&#xA;            1,&#xA;            'SUCCESS',&#xA;            SYSTEM_USER, HOST_NAME(), APP_NAME(),&#xA;            GETUTCDATE()&#xA;        FROM inserted i&#xA;        INNER JOIN deleted d ON i.LeaveID = d.LeaveID;&#xA;    END&#xA;    &#xA;    -- DELETE&#xA;    IF NOT EXISTS (SELECT 1 FROM inserted) AND EXISTS (SELECT 1 FROM deleted)&#xA;    BEGIN&#xA;        INSERT INTO dbo.DataMovementAudit (&#xA;            BatchID, TableName, OperationType, RecordID,&#xA;            BeforeData, AffectedRows, StatusCode,&#xA;            ExecutingUser, HostName, ApplicationName, EventDateTime&#xA;        )&#xA;        SELECT&#xA;            @BatchID,&#xA;            'Leave',&#xA;            'DELETE',&#xA;            CAST(d.LeaveID AS NVARCHAR(255)),&#xA;            CONCAT(&#xA;                'Deleted Type:', d.LeaveType,&#xA;                ', Days:', d.LeaveDays&#xA;            ),&#xA;            1,&#xA;            'SUCCESS',&#xA;            SYSTEM_USER, HOST_NAME(), APP_NAME(),&#xA;            GETUTCDATE()&#xA;        FROM deleted d;&#xA;    END&#xA;END;&#xA;GO&#xA;&#xA;PRINT '✅ trg_Leave_Audit created';&#xA;GO&#xA;&#xA;-- ================================================================&#xA;-- VERIFY TRIGGERS&#xA;-- ================================================================&#xA;SELECT &#xA;    t.name AS TriggerName,&#xA;    OBJECT_NAME(t.parent_id) AS TableName,&#xA;    CASE WHEN t.is_disabled = 0 THEN '✅ ACTIVE' ELSE '❌ DISABLED' END AS Status&#xA;FROM sys.triggers t&#xA;WHERE t.parent_class = 0&#xA;    AND t.name LIKE 'trg_%'&#xA;ORDER BY TableName, TriggerName;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
