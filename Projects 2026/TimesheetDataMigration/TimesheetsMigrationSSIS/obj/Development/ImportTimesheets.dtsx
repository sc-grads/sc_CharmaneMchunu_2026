  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\Create Database n Tables"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{37497F3A-FBBE-4F31-9799-49DDA6F11CE6}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="Create Database n Tables">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Create Database n Tables\Create Database"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Creates TimesheetDB database"
          DTS:DTSID="{44D02495-27B6-4F7C-BD49-B0BD7618BC05}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Create Database"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{C1FC2EBB-68B4-4BE8-9C60-9A21F0C6C7E0}"
              SQLTask:SqlStatementSource="-- =============================================&#xA;-- CREATE DATABASE IF NOT EXISTS&#xA;-- =============================================&#xA;IF NOT EXISTS (SELECT * FROM sys.databases WHERE name = 'TimesheetDB')&#xA;BEGIN&#xA;    CREATE DATABASE TimesheetDB;&#xA;    PRINT 'Database TimesheetDB created successfully.';&#xA;END&#xA;ELSE&#xA;BEGIN&#xA;    PRINT 'Database TimesheetDB already exists.';&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Create Database n Tables\Create Tables"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{675AEBA2-DF89-47E3-81CC-D5D7034B4483}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Create Tables"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{162FBE0A-C9D2-4D5C-B10A-713428FCAD7D}"
              SQLTask:SqlStatementSource="USE TimesheetDB;&#xA;GO&#xA;&#xA;-- ================================================================&#xA;-- NON-DESTRUCTIVE CREATE TABLES&#xA;-- ================================================================&#xA;&#xA;-- 1. EmployeeDetails&#xA;IF NOT EXISTS (SELECT 1 FROM sys.tables WHERE name = 'EmployeeDetails')&#xA;BEGIN&#xA;    CREATE TABLE dbo.EmployeeDetails (&#xA;        EmployeeID INT IDENTITY(1001,1) PRIMARY KEY,&#xA;        EmployeeName NVARCHAR(100) NOT NULL,&#xA;        EmployeeSurname NVARCHAR(100) NOT NULL,&#xA;        EmployeeCode NVARCHAR(20) UNIQUE,&#xA;        IsActive BIT DEFAULT 1,&#xA;        CreatedDate DATETIME DEFAULT GETDATE(),&#xA;        ModifiedDate DATETIME NULL&#xA;    );&#xA;    PRINT '✅ EmployeeDetails created';&#xA;END&#xA;ELSE&#xA;    PRINT 'ℹ️ EmployeeDetails already exists';&#xA;GO&#xA;&#xA;-- 2. StagingTimesheet&#xA;IF NOT EXISTS (SELECT 1 FROM sys.tables WHERE name = 'StagingTimesheet')&#xA;BEGIN&#xA;    CREATE TABLE dbo.StagingTimesheet (&#xA;        StagingID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        EmployeeID INT NOT NULL,&#xA;        Date NVARCHAR(255),&#xA;        DayOfWeek NVARCHAR(255),&#xA;        Client NVARCHAR(255),&#xA;        ProjectName NVARCHAR(255),&#xA;        Description NVARCHAR(MAX),&#xA;        BillableType NVARCHAR(255),&#xA;        Comments NVARCHAR(MAX),&#xA;        TotalHours NVARCHAR(255),&#xA;        StartTime NVARCHAR(255),&#xA;        EndTime NVARCHAR(255),&#xA;        IsLeave NVARCHAR(255),&#xA;        LeaveType NVARCHAR(255),&#xA;        Month NVARCHAR(255),&#xA;        SourceFile NVARCHAR(255),&#xA;        OvertimeHours NVARCHAR(255),&#xA;        LoadDate DATETIME DEFAULT GETDATE(),&#xA;        IsProcessed BIT DEFAULT 0,&#xA;        ProcessedDate DATETIME NULL,&#xA;        BatchID INT NULL  -- ADDED BatchID&#xA;    );&#xA;    PRINT '✅ StagingTimesheet created';&#xA;END&#xA;ELSE&#xA;    PRINT 'ℹ️ StagingTimesheet already exists';&#xA;GO&#xA;&#xA;-- 3. TimesheetEntry&#xA;IF NOT EXISTS (SELECT 1 FROM sys.tables WHERE name = 'TimesheetEntry')&#xA;BEGIN&#xA;    CREATE TABLE dbo.TimesheetEntry (&#xA;        EntryID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        EmployeeID INT NOT NULL,&#xA;        WorkDate DATE NOT NULL,&#xA;        Client NVARCHAR(200),&#xA;        ProjectName NVARCHAR(500),&#xA;        Description NVARCHAR(2000),&#xA;        BillableType NVARCHAR(50),&#xA;        TotalHours DECIMAL(10,2) NULL,&#xA;        TotalHoursOriginal NVARCHAR(20),&#xA;        StartTime TIME NULL,&#xA;        EndTime TIME NULL,&#xA;        Comments NVARCHAR(2000),&#xA;        IsLeave BIT DEFAULT 0,&#xA;        LeaveType NVARCHAR(50),&#xA;        CreatedDate DATETIME DEFAULT GETDATE(),&#xA;        ModifiedDate DATETIME NULL,&#xA;        IsDeleted BIT DEFAULT 0,&#xA;        DeletedDate DATETIME NULL&#xA;    );&#xA;    PRINT '✅ TimesheetEntry created';&#xA;END&#xA;ELSE&#xA;    PRINT 'ℹ️ TimesheetEntry already exists';&#xA;GO&#xA;&#xA;-- 4. Leave&#xA;IF NOT EXISTS (SELECT 1 FROM sys.tables WHERE name = 'Leave')&#xA;BEGIN&#xA;    CREATE TABLE dbo.Leave (&#xA;        LeaveID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        EmployeeID INT NOT NULL,&#xA;        LeaveType NVARCHAR(50) NOT NULL,&#xA;        StartDate DATE NOT NULL,&#xA;        EndDate DATE NOT NULL,&#xA;        LeaveDays DECIMAL(10,2) NOT NULL,&#xA;        Comments NVARCHAR(500),&#xA;        IsApproved BIT DEFAULT 0,&#xA;        ApprovedDate DATETIME NULL,&#xA;        CreatedDate DATETIME DEFAULT GETDATE(),&#xA;        ModifiedDate DATETIME NULL&#xA;    );&#xA;    PRINT '✅ Leave created';&#xA;END&#xA;ELSE&#xA;    PRINT 'ℹ️ Leave already exists';&#xA;GO&#xA;&#xA;-- 5. AuditStatusCodes&#xA;IF NOT EXISTS (SELECT 1 FROM sys.tables WHERE name = 'AuditStatusCodes')&#xA;BEGIN&#xA;    CREATE TABLE dbo.AuditStatusCodes (&#xA;        StatusID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        StatusCode NVARCHAR(20) UNIQUE NOT NULL,&#xA;        StatusName NVARCHAR(50) NOT NULL,&#xA;        Description NVARCHAR(200),&#xA;        IsSuccess BIT DEFAULT 0,&#xA;        IsError BIT DEFAULT 0,&#xA;        IsActive BIT DEFAULT 1&#xA;    );&#xA;&#xA;    INSERT INTO dbo.AuditStatusCodes (StatusCode, StatusName, Description, IsSuccess, IsError)&#xA;    VALUES &#xA;    ('SUCCESS', 'Success', 'Operation completed successfully', 1, 0),&#xA;    ('FAILED', 'Failed', 'Operation failed', 0, 1),&#xA;    ('RUNNING', 'Running', 'Operation is in progress', 0, 0),&#xA;    ('WARNING', 'Warning', 'Operation completed with warnings', 0, 0),&#xA;    ('SKIPPED', 'Skipped', 'Operation was skipped', 0, 0);&#xA;    &#xA;    PRINT '✅ AuditStatusCodes created and populated';&#xA;END&#xA;ELSE&#xA;    PRINT 'ℹ️ AuditStatusCodes already exists';&#xA;GO&#xA;&#xA;-- 6. MigrationBatch&#xA;IF NOT EXISTS (SELECT 1 FROM sys.tables WHERE name = 'MigrationBatch')&#xA;BEGIN&#xA;    CREATE TABLE dbo.MigrationBatch (&#xA;        BatchID INT IDENTITY(1,1) PRIMARY KEY,&#xA;        BatchGUID UNIQUEIDENTIFIER DEFAULT NEWID() NOT NULL,&#xA;        BatchName NVARCHAR(200) NOT NULL,&#xA;        StartDateTime DATETIME2 NOT NULL DEFAULT GETUTCDATE(),&#xA;        EndDateTime DATETIME2 NULL,&#xA;        StatusCode NVARCHAR(20) DEFAULT 'RUNNING',&#xA;        TotalRecordsProcessed INT DEFAULT 0,&#xA;        TotalRecordsInserted INT DEFAULT 0,&#xA;        TotalRecordsUpdated INT DEFAULT 0,&#xA;        TotalRecordsDeleted INT DEFAULT 0,&#xA;        TotalRecordsFailed INT DEFAULT 0,&#xA;        ErrorMessage NVARCHAR(MAX) NULL,&#xA;        CreatedBy NVARCHAR(100) NULL,&#xA;        LastErrorDateTime DATETIME2 NULL,&#xA;        ErrorCount INT DEFAULT 0&#xA;    );&#xA;    PRINT '✅ MigrationBatch created';&#xA;END&#xA;ELSE&#xA;    PRINT 'ℹ️ MigrationBatch already exists';&#xA;GO&#xA;&#xA;-- 7. DataMovementAudit (without foreign key)&#xA;IF NOT EXISTS (SELECT 1 FROM sys.tables WHERE name = 'DataMovementAudit')&#xA;BEGIN&#xA;    CREATE TABLE dbo.DataMovementAudit (&#xA;        AuditID BIGINT IDENTITY(1,1) PRIMARY KEY,&#xA;        BatchID INT NOT NULL,&#xA;        TableName NVARCHAR(128) NOT NULL,&#xA;        OperationType NVARCHAR(20) NOT NULL,&#xA;        RecordID NVARCHAR(255) NOT NULL,&#xA;        BeforeData NVARCHAR(MAX) NULL,&#xA;        AfterData NVARCHAR(MAX) NULL,&#xA;        ChangedColumns NVARCHAR(MAX) NULL,&#xA;        AffectedRows INT DEFAULT 1,&#xA;        StatusCode NVARCHAR(20) DEFAULT 'SUCCESS',&#xA;        ErrorMessage NVARCHAR(MAX) NULL,&#xA;        ExecutingUser NVARCHAR(255) NOT NULL,&#xA;        HostName NVARCHAR(255) NULL,&#xA;        ApplicationName NVARCHAR(255) NULL,&#xA;        EventDateTime DATETIME2 NOT NULL DEFAULT GETUTCDATE(),&#xA;        ProcessingTimeMs INT NULL&#xA;    );&#xA;    PRINT '✅ DataMovementAudit created';&#xA;END&#xA;ELSE&#xA;    PRINT 'ℹ️ DataMovementAudit already exists';&#xA;GO&#xA;&#xA;-- 8. MigrationErrors&#xA;IF NOT EXISTS (SELECT 1 FROM sys.tables WHERE name = 'MigrationErrors')&#xA;BEGIN&#xA;    CREATE TABLE dbo.MigrationErrors (&#xA;        ErrorID BIGINT IDENTITY(1,1) PRIMARY KEY,&#xA;        BatchID INT NOT NULL,&#xA;        AuditID BIGINT NULL,&#xA;        TableName NVARCHAR(128) NOT NULL,&#xA;        RecordID NVARCHAR(255) NULL,&#xA;        OperationType NVARCHAR(20) NULL,&#xA;        ErrorCode INT NULL,&#xA;        ErrorMessage NVARCHAR(MAX) NOT NULL,&#xA;        ErrorContext NVARCHAR(MAX) NULL,&#xA;        IsResolved BIT DEFAULT 0,&#xA;        ErrorDateTime DATETIME2 NOT NULL DEFAULT GETUTCDATE()&#xA;    );&#xA;    PRINT '✅ MigrationErrors created';&#xA;END&#xA;ELSE&#xA;    PRINT 'ℹ️ MigrationErrors already exists';&#xA;GO&#xA;&#xA;-- ================================================================&#xA;-- ADD FOREIGN KEY CONSTRAINTS (IF NOT EXISTS)&#xA;-- ================================================================&#xA;-- Note: Skip FK_DataMovementAudit_Batch and FK_MigrationErrors_Batch&#xA;-- to avoid the conflict with the Script Task&#xA;&#xA;-- Only add Employee foreign keys&#xA;IF NOT EXISTS (SELECT 1 FROM sys.foreign_keys WHERE name = 'FK_TimesheetEntry_Employee')&#xA;    ALTER TABLE dbo.TimesheetEntry &#xA;    ADD CONSTRAINT FK_TimesheetEntry_Employee &#xA;    FOREIGN KEY (EmployeeID) REFERENCES dbo.EmployeeDetails(EmployeeID);&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM sys.foreign_keys WHERE name = 'FK_Leave_Employee')&#xA;    ALTER TABLE dbo.Leave &#xA;    ADD CONSTRAINT FK_Leave_Employee &#xA;    FOREIGN KEY (EmployeeID) REFERENCES dbo.EmployeeDetails(EmployeeID);&#xA;PRINT '✅ Foreign keys verified';&#xA;GO&#xA;&#xA;-- ================================================================&#xA;-- CREATE INDEXES (IF NOT EXISTS)&#xA;-- ================================================================&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name = 'IX_StagingTimesheet_IsProcessed' AND object_id = OBJECT_ID('StagingTimesheet'))&#xA;    CREATE NONCLUSTERED INDEX IX_StagingTimesheet_IsProcessed ON dbo.StagingTimesheet(IsProcessed);&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name = 'IX_MigrationBatch_StatusCode' AND object_id = OBJECT_ID('MigrationBatch'))&#xA;    CREATE NONCLUSTERED INDEX IX_MigrationBatch_StatusCode ON dbo.MigrationBatch(StatusCode);&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name = 'IX_MigrationBatch_StartDateTime' AND object_id = OBJECT_ID('MigrationBatch'))&#xA;    CREATE NONCLUSTERED INDEX IX_MigrationBatch_StartDateTime ON dbo.MigrationBatch(StartDateTime);&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name = 'IX_TimesheetEntry_EmployeeID' AND object_id = OBJECT_ID('TimesheetEntry'))&#xA;    CREATE NONCLUSTERED INDEX IX_TimesheetEntry_EmployeeID ON dbo.TimesheetEntry(EmployeeID);&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name = 'IX_TimesheetEntry_WorkDate' AND object_id = OBJECT_ID('TimesheetEntry'))&#xA;    CREATE NONCLUSTERED INDEX IX_TimesheetEntry_WorkDate ON dbo.TimesheetEntry(WorkDate);&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM sys.indexes WHERE name = 'IX_Leave_EmployeeID' AND object_id = OBJECT_ID('Leave'))&#xA;    CREATE NONCLUSTERED INDEX IX_Leave_EmployeeID ON dbo.Leave(EmployeeID);&#xA;PRINT '✅ Indexes verified';&#xA;GO&#xA;&#xA;-- ================================================================&#xA;-- INSERT EMPLOYEES (IF NOT EXISTS)&#xA;-- ================================================================&#xA;IF NOT EXISTS (SELECT 1 FROM dbo.EmployeeDetails WHERE EmployeeCode = 'EMP001')&#xA;    INSERT INTO dbo.EmployeeDetails (EmployeeName, EmployeeSurname, EmployeeCode) VALUES ('Buhle', 'Mukhuba', 'EMP001');&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dbo.EmployeeDetails WHERE EmployeeCode = 'EMP002')&#xA;    INSERT INTO dbo.EmployeeDetails (EmployeeName, EmployeeSurname, EmployeeCode) VALUES ('Charmane', 'Mchunu', 'EMP002');&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dbo.EmployeeDetails WHERE EmployeeCode = 'EMP003')&#xA;    INSERT INTO dbo.EmployeeDetails (EmployeeName, EmployeeSurname, EmployeeCode) VALUES ('Jabulane', 'Poulo', 'EMP003');&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dbo.EmployeeDetails WHERE EmployeeCode = 'EMP004')&#xA;    INSERT INTO dbo.EmployeeDetails (EmployeeName, EmployeeSurname, EmployeeCode) VALUES ('Kayden', 'Padayachee', 'EMP004');&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dbo.EmployeeDetails WHERE EmployeeCode = 'EMP005')&#xA;    INSERT INTO dbo.EmployeeDetails (EmployeeName, EmployeeSurname, EmployeeCode) VALUES ('Lwazisile', 'Mhlambi', 'EMP005');&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dbo.EmployeeDetails WHERE EmployeeCode = 'EMP006')&#xA;    INSERT INTO dbo.EmployeeDetails (EmployeeName, EmployeeSurname, EmployeeCode) VALUES ('Rushil', 'Jivan', 'EMP006');&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dbo.EmployeeDetails WHERE EmployeeCode = 'EMP007')&#xA;    INSERT INTO dbo.EmployeeDetails (EmployeeName, EmployeeSurname, EmployeeCode) VALUES ('Shriya', 'Hariparsad', 'EMP007');&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM dbo.EmployeeDetails WHERE EmployeeCode = 'EMP008')&#xA;    INSERT INTO dbo.EmployeeDetails (EmployeeName, EmployeeSurname, EmployeeCode) VALUES ('Teolan', 'Govender', 'EMP008');&#xA;PRINT '✅ Employees verified';&#xA;GO&#xA;&#xA;PRINT '============================================================';&#xA;PRINT '✅ ALL TABLES VERIFIED/CREATED SUCCESSFULLY!';&#xA;PRINT '============================================================';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
      <DTS:PrecedenceConstraints>
        <DTS:PrecedenceConstraint
          DTS:refId="Package\Create Database n Tables.PrecedenceConstraints[Constraint]"
          DTS:CreationName=""
          DTS:DTSID="{259247BE-1C40-4F28-ABAE-9EE6126AEEB3}"
          DTS:From="Package\Create Database n Tables\Create Database"
          DTS:LogicalAnd="True"
          DTS:ObjectName="Constraint"
          DTS:To="Package\Create Database n Tables\Create Tables" />
      </DTS:PrecedenceConstraints>
    </DTS:Executable>
