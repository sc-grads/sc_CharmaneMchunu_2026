    <DTS:Executable
      DTS:refId="Package\Triggers"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Sequence Container"
      DTS:DTSID="{FFA137BF-D2F4-4DAF-A224-B9AC97AFC1D3}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="Triggers">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Triggers\Trigger"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{AB4B37B5-05A1-446F-AADD-1BA2E7BDD947}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Trigger"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{162FBE0A-C9D2-4D5C-B10A-713428FCAD7D}"
              SQLTask:SqlStatementSource="USE TimesheetDB;&#xA;GO&#xA;&#xA;DROP TRIGGER IF EXISTS dbo.trg_StagingTimesheet_UpdateAudit;&#xA;GO&#xA;&#xA;CREATE TRIGGER dbo.trg_StagingTimesheet_UpdateAudit&#xA;ON dbo.StagingTimesheet&#xA;AFTER UPDATE&#xA;AS&#xA;BEGIN&#xA;    SET NOCOUNT ON;&#xA;    &#xA;    DECLARE @BatchID INT;&#xA;    DECLARE @ContextInfo VARBINARY(128) = CONTEXT_INFO();&#xA;    &#xA;    IF @ContextInfo IS NOT NULL AND @ContextInfo != 0x00000000&#xA;    BEGIN&#xA;        SET @BatchID = CONVERT(INT, @ContextInfo);&#xA;    END&#xA;    &#xA;    IF @BatchID IS NULL OR @BatchID = 0&#xA;    BEGIN&#xA;        SELECT TOP 1 @BatchID = BatchID&#xA;        FROM dbo.AuditLog&#xA;        WHERE TableName = 'ETL_Process' &#xA;          AND OperationType = 'START'&#xA;          AND StatusCode = 'RUNNING'&#xA;        ORDER BY AuditID DESC;&#xA;    END&#xA;    &#xA;    IF @BatchID IS NULL OR @BatchID = 0&#xA;        SET @BatchID = -1;&#xA;    &#xA;    DECLARE @StartTime DATETIME = GETDATE();&#xA;    &#xA;    BEGIN TRY&#xA;        IF UPDATE(IsProcessed)&#xA;        BEGIN&#xA;            INSERT INTO dbo.AuditLog (&#xA;                BatchID, TableName, OperationType, RecordID,&#xA;                ChangedColumns, AffectedRows, StatusCode,&#xA;                ExecutingUser, HostName, ApplicationName,&#xA;                EventDateTime, ProcessingTimeMs&#xA;            )&#xA;            SELECT &#xA;                @BatchID,&#xA;                'StagingTimesheet',&#xA;                'UPDATE',&#xA;                CAST(d.StagingID AS NVARCHAR(255)),&#xA;                '[&quot;IsProcessed&quot;]',&#xA;                1,&#xA;                'SUCCESS',&#xA;                SYSTEM_USER,&#xA;                HOST_NAME(),&#xA;                APP_NAME(),&#xA;                GETDATE(),&#xA;                DATEDIFF(MILLISECOND, @StartTime, GETDATE())&#xA;            FROM deleted d&#xA;            INNER JOIN inserted i ON d.StagingID = i.StagingID&#xA;            WHERE d.IsProcessed = 0 AND i.IsProcessed = 1;&#xA;        END&#xA;    END TRY&#xA;    BEGIN CATCH&#xA;        INSERT INTO dbo.AuditLog (&#xA;            BatchID, TableName, OperationType, RecordID,&#xA;            StatusCode, ErrorMessage,&#xA;            ExecutingUser, HostName, ApplicationName,&#xA;            EventDateTime, ProcessingTimeMs&#xA;        )&#xA;        SELECT&#xA;            @BatchID,&#xA;            'StagingTimesheet',&#xA;            'TRIGGER_ERROR',&#xA;            'ERROR',&#xA;            'FAILED',&#xA;            ERROR_MESSAGE(),&#xA;            SYSTEM_USER,&#xA;            HOST_NAME(),&#xA;            APP_NAME(),&#xA;            GETDATE(),&#xA;            DATEDIFF(MILLISECOND, @StartTime, GETDATE());&#xA;    END CATCH&#xA;END;&#xA;GO&#xA;&#xA;PRINT 'trg_StagingTimesheet_UpdateAudit created';&#xA;GO&#xA;&#xA;DROP TRIGGER IF EXISTS dbo.trg_Timesheet_Audit;&#xA;GO&#xA;&#xA;CREATE TRIGGER dbo.trg_Timesheet_Audit&#xA;ON dbo.Timesheet&#xA;AFTER INSERT, UPDATE, DELETE&#xA;AS&#xA;BEGIN&#xA;    SET NOCOUNT ON;&#xA;    &#xA;    DECLARE @BatchID INT;&#xA;    DECLARE @ContextInfo VARBINARY(128) = CONTEXT_INFO();&#xA;    &#xA;    IF @ContextInfo IS NOT NULL AND @ContextInfo != 0x00000000&#xA;    BEGIN&#xA;        SET @BatchID = CONVERT(INT, @ContextInfo);&#xA;    END&#xA;    &#xA;    IF @BatchID IS NULL OR @BatchID = 0&#xA;    BEGIN&#xA;        SELECT TOP 1 @BatchID = BatchID&#xA;        FROM dbo.AuditLog&#xA;        WHERE TableName = 'ETL_Process' &#xA;          AND OperationType = 'START'&#xA;          AND StatusCode = 'RUNNING'&#xA;        ORDER BY AuditID DESC;&#xA;    END&#xA;    &#xA;    IF @BatchID IS NULL OR @BatchID = 0&#xA;        SET @BatchID = -1;&#xA;    &#xA;    DECLARE @StartTime DATETIME = GETDATE();&#xA;    &#xA;    BEGIN TRY&#xA;        IF EXISTS (SELECT 1 FROM inserted) AND NOT EXISTS (SELECT 1 FROM deleted)&#xA;        BEGIN&#xA;            INSERT INTO dbo.AuditLog (&#xA;                BatchID, TableName, OperationType, RecordID,&#xA;                ChangedColumns, AffectedRows, StatusCode,&#xA;                ExecutingUser, HostName, ApplicationName,&#xA;                EventDateTime, ProcessingTimeMs&#xA;            )&#xA;            SELECT&#xA;                @BatchID,&#xA;                'Timesheet',&#xA;                'INSERT',&#xA;                CAST(i.TimesheetID AS NVARCHAR(255)),&#xA;                NULL,&#xA;                1,&#xA;                'SUCCESS',&#xA;                SYSTEM_USER, HOST_NAME(), APP_NAME(),&#xA;                GETDATE(),&#xA;                DATEDIFF(MILLISECOND, @StartTime, GETDATE())&#xA;            FROM inserted i;&#xA;        END&#xA;        &#xA;        IF EXISTS (SELECT 1 FROM inserted) AND EXISTS (SELECT 1 FROM deleted)&#xA;        BEGIN&#xA;            INSERT INTO dbo.AuditLog (&#xA;                BatchID, TableName, OperationType, RecordID,&#xA;                ChangedColumns, AffectedRows, StatusCode,&#xA;                ExecutingUser, HostName, ApplicationName,&#xA;                EventDateTime, ProcessingTimeMs&#xA;            )&#xA;            SELECT&#xA;                @BatchID,&#xA;                'Timesheet',&#xA;                'UPDATE',&#xA;                CAST(i.TimesheetID AS NVARCHAR(255)),&#xA;                CASE &#xA;                    WHEN ISNULL(d.Description,'') &lt;&gt; ISNULL(i.Description,'') &#xA;                        AND ISNULL(d.Duration,'') &lt;&gt; ISNULL(i.Duration,'')&#xA;                    THEN '[&quot;Description&quot;,&quot;Duration&quot;]'&#xA;                    WHEN ISNULL(d.Description,'') &lt;&gt; ISNULL(i.Description,'') &#xA;                    THEN '[&quot;Description&quot;]'&#xA;                    WHEN ISNULL(d.Duration,'') &lt;&gt; ISNULL(i.Duration,'') &#xA;                    THEN '[&quot;Duration&quot;]'&#xA;                    WHEN ISNULL(d.BillableType,'') &lt;&gt; ISNULL(i.BillableType,'') &#xA;                    THEN '[&quot;BillableType&quot;]'&#xA;                    WHEN ISNULL(d.Comments,'') &lt;&gt; ISNULL(i.Comments,'') &#xA;                    THEN '[&quot;Comments&quot;]'&#xA;                    ELSE '[&quot;Unknown&quot;]'&#xA;                END AS ChangedColumns,&#xA;                1,&#xA;                'SUCCESS',&#xA;                SYSTEM_USER, HOST_NAME(), APP_NAME(),&#xA;                GETDATE(),&#xA;                DATEDIFF(MILLISECOND, @StartTime, GETDATE())&#xA;            FROM inserted i&#xA;            INNER JOIN deleted d ON i.TimesheetID = d.TimesheetID&#xA;            WHERE &#xA;                ISNULL(d.Description,'') &lt;&gt; ISNULL(i.Description,'')&#xA;                OR ISNULL(d.Duration,'') &lt;&gt; ISNULL(i.Duration,'')&#xA;                OR ISNULL(d.BillableType,'') &lt;&gt; ISNULL(i.BillableType,'')&#xA;                OR ISNULL(d.Comments,'') &lt;&gt; ISNULL(i.Comments,'');&#xA;        END&#xA;        &#xA;        IF NOT EXISTS (SELECT 1 FROM inserted) AND EXISTS (SELECT 1 FROM deleted)&#xA;        BEGIN&#xA;            INSERT INTO dbo.AuditLog (&#xA;                BatchID, TableName, OperationType, RecordID,&#xA;                ChangedColumns, AffectedRows, StatusCode,&#xA;                ExecutingUser, HostName, ApplicationName,&#xA;                EventDateTime, ProcessingTimeMs&#xA;            )&#xA;            SELECT&#xA;                @BatchID,&#xA;                'Timesheet',&#xA;                'DELETE',&#xA;                CAST(d.TimesheetID AS NVARCHAR(255)),&#xA;                NULL,&#xA;                1,&#xA;                'SUCCESS',&#xA;                SYSTEM_USER, HOST_NAME(), APP_NAME(),&#xA;                GETDATE(),&#xA;                DATEDIFF(MILLISECOND, @StartTime, GETDATE())&#xA;            FROM deleted d;&#xA;        END&#xA;    END TRY&#xA;    BEGIN CATCH&#xA;        INSERT INTO dbo.AuditLog (&#xA;            BatchID, TableName, OperationType, RecordID,&#xA;            StatusCode, ErrorMessage,&#xA;            ExecutingUser, HostName, ApplicationName,&#xA;            EventDateTime, ProcessingTimeMs&#xA;        )&#xA;        SELECT&#xA;            @BatchID,&#xA;            'Timesheet',&#xA;            'TRIGGER_ERROR',&#xA;            'ERROR',&#xA;            'FAILED',&#xA;            ERROR_MESSAGE(),&#xA;            SYSTEM_USER, HOST_NAME(), APP_NAME(),&#xA;            GETDATE(),&#xA;            DATEDIFF(MILLISECOND, @StartTime, GETDATE());&#xA;    END CATCH&#xA;END;&#xA;GO&#xA;&#xA;PRINT 'trg_Timesheet_Audit created (updated with Duration)';&#xA;GO&#xA;&#xA;DROP TRIGGER IF EXISTS dbo.trg_Leave_Audit;&#xA;GO&#xA;&#xA;CREATE TRIGGER dbo.trg_Leave_Audit&#xA;ON dbo.Leave&#xA;AFTER INSERT, UPDATE, DELETE&#xA;AS&#xA;BEGIN&#xA;    SET NOCOUNT ON;&#xA;    &#xA;    DECLARE @BatchID INT;&#xA;    DECLARE @ContextInfo VARBINARY(128) = CONTEXT_INFO();&#xA;    &#xA;    IF @ContextInfo IS NOT NULL AND @ContextInfo != 0x00000000&#xA;    BEGIN&#xA;        SET @BatchID = CONVERT(INT, @ContextInfo);&#xA;    END&#xA;    &#xA;    IF @BatchID IS NULL OR @BatchID = 0&#xA;    BEGIN&#xA;        SELECT TOP 1 @BatchID = BatchID&#xA;        FROM dbo.AuditLog&#xA;        WHERE TableName = 'ETL_Process' &#xA;          AND OperationType = 'START'&#xA;          AND StatusCode = 'RUNNING'&#xA;        ORDER BY AuditID DESC;&#xA;    END&#xA;    &#xA;    IF @BatchID IS NULL OR @BatchID = 0&#xA;        SET @BatchID = -1;&#xA;    &#xA;    DECLARE @StartTime DATETIME = GETDATE();&#xA;    &#xA;    BEGIN TRY&#xA;        IF EXISTS (SELECT 1 FROM inserted) AND NOT EXISTS (SELECT 1 FROM deleted)&#xA;        BEGIN&#xA;            INSERT INTO dbo.AuditLog (&#xA;                BatchID, TableName, OperationType, RecordID,&#xA;                ChangedColumns, AffectedRows, StatusCode,&#xA;                ExecutingUser, HostName, ApplicationName,&#xA;                EventDateTime, ProcessingTimeMs&#xA;            )&#xA;            SELECT&#xA;                @BatchID,&#xA;                'Leave',&#xA;                'INSERT',&#xA;                CAST(i.LeaveID AS NVARCHAR(255)),&#xA;                NULL,&#xA;                1,&#xA;                'SUCCESS',&#xA;                SYSTEM_USER, HOST_NAME(), APP_NAME(),&#xA;                GETDATE(),&#xA;                DATEDIFF(MILLISECOND, @StartTime, GETDATE())&#xA;            FROM inserted i;&#xA;        END&#xA;        &#xA;        IF EXISTS (SELECT 1 FROM inserted) AND EXISTS (SELECT 1 FROM deleted)&#xA;        BEGIN&#xA;            INSERT INTO dbo.AuditLog (&#xA;                BatchID, TableName, OperationType, RecordID,&#xA;                ChangedColumns, AffectedRows, StatusCode,&#xA;                ExecutingUser, HostName, ApplicationName,&#xA;                EventDateTime, ProcessingTimeMs&#xA;            )&#xA;            SELECT&#xA;                @BatchID,&#xA;                'Leave',&#xA;                'UPDATE',&#xA;                CAST(i.LeaveID AS NVARCHAR(255)),&#xA;                CASE &#xA;                    WHEN ISNULL(d.LeaveType,'') &lt;&gt; ISNULL(i.LeaveType,'') &#xA;                        AND ISNULL(d.LeaveDays,0) &lt;&gt; ISNULL(i.LeaveDays,0)&#xA;                    THEN '[&quot;LeaveType&quot;,&quot;LeaveDays&quot;]'&#xA;                    WHEN ISNULL(d.LeaveType,'') &lt;&gt; ISNULL(i.LeaveType,'') &#xA;                    THEN '[&quot;LeaveType&quot;]'&#xA;                    WHEN ISNULL(d.LeaveDays,0) &lt;&gt; ISNULL(i.LeaveDays,0) &#xA;                    THEN '[&quot;LeaveDays&quot;]'&#xA;                    ELSE '[&quot;Unknown&quot;]'&#xA;                END AS ChangedColumns,&#xA;                1,&#xA;                'SUCCESS',&#xA;                SYSTEM_USER, HOST_NAME(), APP_NAME(),&#xA;                GETDATE(),&#xA;                DATEDIFF(MILLISECOND, @StartTime, GETDATE())&#xA;            FROM inserted i&#xA;            INNER JOIN deleted d ON i.LeaveID = d.LeaveID&#xA;            WHERE &#xA;                ISNULL(d.LeaveType,'') &lt;&gt; ISNULL(i.LeaveType,'')&#xA;                OR ISNULL(d.LeaveDays,0) &lt;&gt; ISNULL(i.LeaveDays,0)&#xA;                OR ISNULL(d.StartDate,'') &lt;&gt; ISNULL(i.StartDate,'')&#xA;                OR ISNULL(d.EndDate,'') &lt;&gt; ISNULL(i.EndDate,'');&#xA;        END&#xA;        &#xA;        IF NOT EXISTS (SELECT 1 FROM inserted) AND EXISTS (SELECT 1 FROM deleted)&#xA;        BEGIN&#xA;            INSERT INTO dbo.AuditLog (&#xA;                BatchID, TableName, OperationType, RecordID,&#xA;                ChangedColumns, AffectedRows, StatusCode,&#xA;                ExecutingUser, HostName, ApplicationName,&#xA;                EventDateTime, ProcessingTimeMs&#xA;            )&#xA;            SELECT&#xA;                @BatchID,&#xA;                'Leave',&#xA;                'DELETE',&#xA;                CAST(d.LeaveID AS NVARCHAR(255)),&#xA;                NULL,&#xA;                1,&#xA;                'SUCCESS',&#xA;                SYSTEM_USER, HOST_NAME(), APP_NAME(),&#xA;                GETDATE(),&#xA;                DATEDIFF(MILLISECOND, @StartTime, GETDATE())&#xA;            FROM deleted d;&#xA;        END&#xA;    END TRY&#xA;    BEGIN CATCH&#xA;        INSERT INTO dbo.AuditLog (&#xA;            BatchID, TableName, OperationType, RecordID,&#xA;            StatusCode, ErrorMessage,&#xA;            ExecutingUser, HostName, ApplicationName,&#xA;            EventDateTime, ProcessingTimeMs&#xA;        )&#xA;        SELECT&#xA;            @BatchID,&#xA;            'Leave',&#xA;            'TRIGGER_ERROR',&#xA;            'ERROR',&#xA;            'FAILED',&#xA;            ERROR_MESSAGE(),&#xA;            SYSTEM_USER, HOST_NAME(), APP_NAME(),&#xA;            GETDATE(),&#xA;            DATEDIFF(MILLISECOND, @StartTime, GETDATE());&#xA;    END CATCH&#xA;END;&#xA;GO&#xA;&#xA;PRINT 'trg_Leave_Audit created';&#xA;GO&#xA;&#xA;PRINT '';&#xA;PRINT '========================================';&#xA;PRINT 'TRIGGER VERIFICATION';&#xA;PRINT '========================================';&#xA;&#xA;SELECT &#xA;    t.name AS TriggerName,&#xA;    OBJECT_NAME(t.parent_id) AS TableName,&#xA;    CASE &#xA;        WHEN t.is_disabled = 0 THEN 'ACTIVE' &#xA;        ELSE 'DISABLED' &#xA;    END AS Status,&#xA;    CASE &#xA;        WHEN t.is_instead_of_trigger = 1 THEN 'INSTEAD OF'&#xA;        ELSE 'AFTER' &#xA;    END AS TriggerType&#xA;FROM sys.triggers t&#xA;WHERE t.parent_class = 0&#xA;    AND t.name LIKE 'trg_%Audit%'&#xA;ORDER BY TableName, TriggerName;&#xA;&#xA;PRINT '';&#xA;PRINT '========================================';&#xA;PRINT 'ALL TRIGGERS CREATED SUCCESSFULLY';&#xA;PRINT '========================================';&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
    </DTS:Executable>
  </DTS:Executables>
