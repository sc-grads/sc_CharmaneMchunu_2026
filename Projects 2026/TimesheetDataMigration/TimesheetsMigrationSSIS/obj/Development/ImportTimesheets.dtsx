                        <arrayElement
                          dataType="System.String"><![CDATA[#region Namespaces
using System;
using System.Data;
using System.Data.OleDb;
using System.IO;
using System.Collections.Generic;
using Microsoft.SqlServer.Dts.Pipeline.Wrapper;
using Microsoft.SqlServer.Dts.Runtime.Wrapper;
#endregion

[Microsoft.SqlServer.Dts.Pipeline.SSISScriptComponentEntryPointAttribute]
public class ScriptMain : UserComponent
{
    public override void CreateNewOutputRows()
    {
        try
        {
            // ============================================
            // GET VARIABLES
            // ============================================
            string filePath = Variables.FullFilePath;
            string sheetName = Variables.SheetNameTimesheet;
            int employeeID = Variables.EmployeeID;
            string month = Variables.Month;

            // Get BatchID - if not set, default to 0
            int batchID = 0;
            try
            {
                batchID = Variables.BatchID;
            }
            catch
            {
                batchID = 0;
            }

            // ============================================
            // CONNECTION STRING FOR EXCEL
            // ============================================
            string connString = $"Provider=Microsoft.ACE.OLEDB.16.0;Data Source={filePath};Extended Properties=\"Excel 12.0 XML;HDR=YES\";";
            string query = $"SELECT * FROM [{sheetName}]";

            using (OleDbConnection conn = new OleDbConnection(connString))
            {
                conn.Open();

                using (OleDbCommand cmd = new OleDbCommand(query, conn))
                using (OleDbDataReader reader = cmd.ExecuteReader())
                {
                    int rowCount = 0;

                    while (reader.Read())
                    {
                        rowCount++;

                        // Skip first 7 rows (metadata rows 1-7)
                        if (rowCount <= 7) continue;

                        // Skip header row (row 8)
                        if (rowCount == 8) continue;

                        // ============================================
                        // CHECK IF DATE IS NULL OR EMPTY
                        // ============================================
                        object dateValue = reader[0];
                        string dateStr = "";
                        bool hasValidDate = false;

                        if (dateValue != DBNull.Value && dateValue != null)
                        {
                            if (dateValue is DateTime)
                            {
                                DateTime dt = (DateTime)dateValue;
                                dateStr = dt.ToString("yyyy-MM-dd");
                                hasValidDate = true;
                            }
                            else
                            {
                                string tempDate = dateValue.ToString().Trim();

                                if (!string.IsNullOrEmpty(tempDate) &&
                                    tempDate != "Date" &&
                                    tempDate != "NULL" &&
                                    tempDate != "Null" &&
                                    tempDate != "null" &&
                                    tempDate != "#N/A" &&
                                    tempDate.Length > 4)
                                {
                                    try
                                    {
                                        DateTime dt;

                                        if (DateTime.TryParse(tempDate, out dt))
                                        {
                                            dateStr = dt.ToString("yyyy-MM-dd");
                                            hasValidDate = true;
                                        }
                                        else
                                        {
                                            double serialNumber;
                                            if (double.TryParse(tempDate, out serialNumber) && serialNumber > 0 && serialNumber < 100000)
                                            {
                                                DateTime excelDate = DateTime.FromOADate(serialNumber);
                                                dateStr = excelDate.ToString("yyyy-MM-dd");
                                                hasValidDate = true;
                                            }
                                            else
                                            {
                                                string[] dateFormats = {
                                                    "yyyy-MM-dd", "yyyy/MM/dd", "dd-MM-yyyy", "dd/MM/yyyy",
                                                    "MM-dd-yyyy", "MM/dd/yyyy", "yyyyMMdd", "dd MMM yyyy"
                                                };

                                                if (DateTime.TryParseExact(tempDate, dateFormats,
                                                    System.Globalization.CultureInfo.InvariantCulture,
                                                    System.Globalization.DateTimeStyles.None, out dt))
                                                {
                                                    dateStr = dt.ToString("yyyy-MM-dd");
                                                    hasValidDate = true;
                                                }
                                            }
                                        }
                                    }
                                    catch
                                    {
                                        hasValidDate = false;
                                    }
                                }
                            }
                        }

                        if (!hasValidDate)
                        {
                            continue;
                        }

                        // ============================================
                        // GET VALUES FROM EXCEL
                        // ============================================
                        string dayOfWeek = reader[1] == DBNull.Value ? "" : reader[1].ToString().Trim();
                        string client = reader[2] == DBNull.Value ? "" : reader[2].ToString().Trim();
                        string projectName = reader[3] == DBNull.Value ? "" : reader[3].ToString().Trim();
                        string description = reader[4] == DBNull.Value ? "" : reader[4].ToString().Trim();
                        string billableType = reader[5] == DBNull.Value ? "" : reader[5].ToString().Trim();
                        string comments = reader[6] == DBNull.Value ? "" : reader[6].ToString().Trim();

                        // ============================================
                        // HANDLE TOTALHOURS
                        // ============================================
                        string totalHours = "";
                        object totalHoursObj = reader[7];
                        if (totalHoursObj != DBNull.Value && totalHoursObj != null)
                        {
                            if (totalHoursObj is DateTime)
                            {
                                DateTime dt = (DateTime)totalHoursObj;
                                totalHours = dt.ToString("HH:mm:ss");
                            }
                            else if (totalHoursObj is TimeSpan)
                            {
                                TimeSpan ts = (TimeSpan)totalHoursObj;
                                totalHours = ts.ToString(@"hh\:mm\:ss");
                            }
                            else
                            {
                                totalHours = totalHoursObj.ToString().Trim();
                            }
                        }

                        // ============================================
                        // HANDLE STARTTIME AND ENDTIME
                        // ============================================
                        string startTime = "";
                        object startTimeObj = reader[8];
                        if (startTimeObj != DBNull.Value && startTimeObj != null)
                        {
                            if (startTimeObj is DateTime)
                            {
                                DateTime dt = (DateTime)startTimeObj;
                                startTime = dt.ToString("HH:mm:ss");
                            }
                            else if (startTimeObj is TimeSpan)
                            {
                                TimeSpan ts = (TimeSpan)startTimeObj;
                                startTime = ts.ToString(@"hh\:mm\:ss");
                            }
                            else
                            {
                                startTime = startTimeObj.ToString().Trim();
                            }
                        }

                        string endTime = "";
                        object endTimeObj = reader[9];
                        if (endTimeObj != DBNull.Value && endTimeObj != null)
                        {
                            if (endTimeObj is DateTime)
                            {
                                DateTime dt = (DateTime)endTimeObj;
                                endTime = dt.ToString("HH:mm:ss");
                            }
                            else if (endTimeObj is TimeSpan)
                            {
                                TimeSpan ts = (TimeSpan)endTimeObj;
                                endTime = ts.ToString(@"hh\:mm\:ss");
                            }
                            else
                            {
                                endTime = endTimeObj.ToString().Trim();
                            }
                        }

                        // ============================================
                        // DETECT LEAVE TYPES
                        // ============================================
                        bool isLeave = false;
                        string leaveType = "";
                        string combinedText = (description + " " + billableType + " " + comments).ToLower();

                        if (combinedText.Contains("annual leave") || combinedText.Contains("annual"))
                        {
                            isLeave = true;
                            leaveType = "Annual Leave";
                        }
                        else if (combinedText.Contains("sick leave") || combinedText.Contains("sick"))
                        {
                            isLeave = true;
                            leaveType = "Sick Leave";
                        }
                        else if (combinedText.Contains("study leave") || combinedText.Contains("study"))
                        {
                            isLeave = true;
                            leaveType = "Study Leave";
                        }
                        else if (combinedText.Contains("birthday leave") || combinedText.Contains("birthday"))
                        {
                            isLeave = true;
                            leaveType = "Birthday Leave";
                        }
                        else if (combinedText.Contains("public holiday") || combinedText.Contains("public"))
                        {
                            isLeave = false;
                            leaveType = "";
                        }
                        else if (combinedText.Contains("leave") || combinedText.Contains("holiday"))
                        {
                            isLeave = true;
                            leaveType = "Other Leave";
                        }

                        if (!isLeave && (billableType.Contains("Public Holiday") || billableType.Contains("public")))
                        {
                            isLeave = false;
                            leaveType = "";
                        }
                        else if (!isLeave && (billableType.Contains("Leave") || billableType.Contains("Holiday")))
                        {
                            isLeave = true;
                            leaveType = "Other Leave";
                        }

                        // ============================================
                        // ADD ROW TO OUTPUT
                        // ============================================
                        ExcelDataBuffer.AddRow();

                        ExcelDataBuffer.Date = dateStr;
                        ExcelDataBuffer.DayOfWeek = dayOfWeek;
                        ExcelDataBuffer.Client = client;
                        ExcelDataBuffer.ProjectName = projectName;
                        ExcelDataBuffer.Description = description;
                        ExcelDataBuffer.BillableType = billableType;
                        ExcelDataBuffer.Comments = comments;
                        ExcelDataBuffer.TotalHours = totalHours;
                        ExcelDataBuffer.StartTime = startTime;
                        ExcelDataBuffer.EndTime = endTime;
                        ExcelDataBuffer.IsLeave = isLeave ? "Yes" : "No";
                        ExcelDataBuffer.LeaveType = leaveType;
                        ExcelDataBuffer.EmployeeID = employeeID;
                        ExcelDataBuffer.Month = month;
                        ExcelDataBuffer.SourceFile = filePath;

                        // ============================================
                        // FIXED: Pass BatchID as STRING (matches buffer property type)
                        // ============================================
                        ExcelDataBuffer.BatchID = batchID.ToString();
                    }
                }
            }
        }
        catch (Exception ex)
        {
            bool cancel = false;
            ComponentMetaData.FireError(0, "Script Component",
                $"Error: {ex.Message}",
                "", 0, out cancel);
        }
    }
}]]></arrayElement>
