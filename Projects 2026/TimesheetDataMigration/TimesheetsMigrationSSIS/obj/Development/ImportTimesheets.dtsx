    <DTS:Executable
      DTS:refId="Package\Execute SQL Task"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{8696B729-89EF-40AD-A907-58967ACEA7AD}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Execute SQL Task"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{162FBE0A-C9D2-4D5C-B10A-713428FCAD7D}"
          SQLTask:SqlStatementSource="USE TimesheetDB;&#xA;GO&#xA;&#xA;-- =============================================&#xA;-- 1. INSERT INTO TIMESHEET ENTRY (KEEP ORIGINAL TotalHours FORMAT)&#xA;-- =============================================&#xA;INSERT INTO dbo.TimesheetEntry (&#xA;    EmployeeID,&#xA;    WorkDate,&#xA;    Client,&#xA;    ProjectName,&#xA;    Description,&#xA;    BillableType,&#xA;    TotalHours,&#xA;    StartTime,&#xA;    EndTime,&#xA;    Comments,&#xA;    IsLeave,&#xA;    CreatedDate&#xA;)&#xA;SELECT &#xA;    EmployeeID,&#xA;    TRY_CAST(Date AS DATE) as WorkDate,&#xA;    Client,&#xA;    ProjectName,&#xA;    Description,&#xA;    BillableType,&#xA;    TotalHours,  -- Keep original HH:MM:SS format&#xA;    StartTime,&#xA;    EndTime,&#xA;    Comments,&#xA;    CASE WHEN IsLeave = 'Yes' THEN 1 ELSE 0 END as IsLeave,&#xA;    GETDATE() as CreatedDate&#xA;FROM dbo.StagingTimesheet&#xA;WHERE EmployeeID IS NOT NULL&#xA;  AND TRY_CAST(Date AS DATE) IS NOT NULL;&#xA;&#xA;-- =============================================&#xA;-- 2. INSERT INTO LEAVE&#xA;-- =============================================&#xA;INSERT INTO dbo.Leave (&#xA;    EmployeeID,&#xA;    LeaveType,&#xA;    StartDate,&#xA;    EndDate,&#xA;    LeaveDays,&#xA;    Comments,&#xA;    CreatedDate&#xA;)&#xA;SELECT &#xA;    EmployeeID,&#xA;    LeaveType,&#xA;    TRY_CAST(Date AS DATE) as StartDate,&#xA;    TRY_CAST(Date AS DATE) as EndDate,&#xA;    1 as LeaveDays,&#xA;    Comments,&#xA;    GETDATE() as CreatedDate&#xA;FROM dbo.StagingTimesheet&#xA;WHERE IsLeave = 'Yes'&#xA;  AND LeaveType IS NOT NULL&#xA;  AND LeaveType != ''&#xA;  AND LeaveType != 'NULL'&#xA;  AND LeaveType NOT LIKE '%Public%'&#xA;  AND LeaveType != 'Public Holiday'&#xA;  AND TRY_CAST(Date AS DATE) IS NOT NULL;&#xA;&#xA;-- =============================================&#xA;-- 3. INSERT INTO AUDIT LOG&#xA;-- =============================================&#xA;INSERT INTO dbo.AuditLog (&#xA;    ActionType,&#xA;    TableName,&#xA;    Description,&#xA;    ActionDate&#xA;)&#xA;SELECT &#xA;    'PIPELINE_COMPLETE' as ActionType,&#xA;    'TimesheetEntry' as TableName,&#xA;    'SSIS Pipeline completed. Records loaded: ' + CAST(COUNT(*) AS NVARCHAR(10)) as Description,&#xA;    GETDATE() as ActionDate&#xA;FROM dbo.TimesheetEntry&#xA;WHERE CreatedDate &gt;= DATEADD(HOUR, -24, GETDATE());&#xA;&#xA;-- =============================================&#xA;-- 4. SHOW SUMMARY&#xA;-- =============================================&#xA;SELECT &#xA;    'TimesheetEntry' as TableName,&#xA;    COUNT(*) as RecordCount&#xA;FROM TimesheetEntry&#xA;WHERE CreatedDate &gt;= DATEADD(HOUR, -24, GETDATE())&#xA;UNION ALL&#xA;SELECT &#xA;    'Leave' as TableName,&#xA;    COUNT(*) as RecordCount&#xA;FROM Leave&#xA;WHERE CreatedDate &gt;= DATEADD(HOUR, -24, GETDATE())&#xA;UNION ALL&#xA;SELECT &#xA;    'AuditLog' as TableName,&#xA;    COUNT(*) as RecordCount&#xA;FROM AuditLog&#xA;WHERE ActionDate &gt;= DATEADD(HOUR, -24, GETDATE());" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
