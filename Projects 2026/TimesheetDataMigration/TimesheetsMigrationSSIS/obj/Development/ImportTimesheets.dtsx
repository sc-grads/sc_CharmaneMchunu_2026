              <ProjectItem
                Name="ScriptMain.cs"
                Encoding="UTF8"><![CDATA[#region Namespaces
using System;
using System.Data;
using System.IO;
using System.Collections.Generic;
using Microsoft.SqlServer.Dts.Runtime;
#endregion

namespace ST_ExtractInfo
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        private bool boolVariable;

        public void Main()
        {
            try
            {
                // ============================================
                // STEP 1: GET FILE NAME FROM LOOP
                // ============================================
                string fileName = Dts.Variables["User::filePath"].Value.ToString();
                string rootFolder = Dts.Variables["User::RootFolder"].Value.ToString();

                // ============================================
                // FIX: ADD .XLSX EXTENSION IF MISSING
                // ============================================
                if (!fileName.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
                {
                    fileName = fileName + ".xlsx";
                }

                Dts.Events.FireInformation(0, "Processing",
                    $"Searching for: {fileName}",
                    string.Empty, 0, ref boolVariable);

                // ============================================
                // STEP 2: BUILD FULL FILE PATH
                // ============================================
                string fullPath = "";
                bool fileFound = false;

                foreach (string file in System.IO.Directory.GetFiles(rootFolder, fileName, System.IO.SearchOption.AllDirectories))
                {
                    fullPath = file;
                    fileFound = true;
                    break;
                }

                if (!fileFound)
                {
                    string fileNameWithoutExt = Path.GetFileNameWithoutExtension(fileName);
                    foreach (string file in System.IO.Directory.GetFiles(rootFolder, fileNameWithoutExt + ".*", System.IO.SearchOption.AllDirectories))
                    {
                        fullPath = file;
                        fileFound = true;
                        break;
                    }
                }

                if (!fileFound)
                {
                    Dts.Events.FireError(0, "File Not Found",
                        $"File not found: {fileName}",
                        string.Empty, 0);
                    Dts.TaskResult = (int)ScriptResults.Failure;
                    return;
                }

                // ============================================
                // STEP 3: EXTRACT EMPLOYEE NAME FROM FOLDER
                // ============================================
                string folderName = Path.GetFileName(Path.GetDirectoryName(fullPath));
                string employeeName = folderName;

                // Remove "Timesheet" suffix if present
                if (employeeName.EndsWith("Timesheet") && employeeName.Length > 9)
                {
                    employeeName = employeeName.Substring(0, employeeName.Length - 9);
                }

                // ============================================
                // STEP 4: MAP EMPLOYEE NAME TO EMPLOYEE ID
                // ============================================
                var employeeMap = new Dictionary<string, int>()
                {
                    // Full names
                    {"Buhle", 1001},
                    {"Charmane", 1002},
                    {"Jabulane", 1003},
                    {"Kayden", 1004},
                    {"Lwazisile", 1005},
                    {"Rushil", 1006},
                    {"Shriya", 1007},
                    {"Teolan", 1008},
                    
                    // Folder names with 's'
                    {"Buhles", 1001},
                    {"Charmanes", 1002},
                    {"Jabulanes", 1003},
                    {"Kaydens", 1004},
                    {"Lwazis", 1005},
                    {"Rushils", 1006},
                    {"Shriyas", 1007},
                    {"Teolans", 1008},
                    
                    // Short names / variations
                    {"Lwazi", 1005}
                };

                int employeeID = 9999; // Default for unknown employees
                if (employeeMap.ContainsKey(employeeName))
                {
                    employeeID = employeeMap[employeeName];
                }

                // ============================================
                // STEP 5: EXTRACT MONTH FROM FILE NAME
                // ============================================
                string month = "";
                string fileNameOnly = Path.GetFileNameWithoutExtension(fullPath);

                if (fileNameOnly.Contains("March") || fileNameOnly.Contains("Mar"))
                    month = "Mar";
                else if (fileNameOnly.Contains("April") || fileNameOnly.Contains("Apr"))
                    month = "Apr";
                else if (fileNameOnly.Contains("May"))
                    month = "May";
                else
                {
                    Dts.Events.FireError(0, "Month Not Found",
                        $"Could not extract month from: {fileNameOnly}",
                        string.Empty, 0);
                    Dts.TaskResult = (int)ScriptResults.Failure;
                    return;
                }

                // ============================================
                // STEP 6: BUILD SHEET NAME WITH $ (FOR EXCEL)
                // ============================================
                string sheetNameTimesheet = month + "$";

                // ============================================
                // STEP 7: SET ALL VARIABLES
                // ============================================
                Dts.Variables["User::FullFilePath"].Value = fullPath;
                Dts.Variables["User::EmployeeName"].Value = employeeName;
                Dts.Variables["User::EmployeeID"].Value = employeeID;
                Dts.Variables["User::Month"].Value = month;
                Dts.Variables["User::SheetName"].Value = sheetNameTimesheet;
                Dts.Variables["User::SheetNameTimesheet"].Value = sheetNameTimesheet;

                // ============================================
                // STEP 8: LOGGING
                // ============================================
                Dts.Events.FireInformation(0, "Extract Info",
                    $"Employee: {employeeName} (ID: {employeeID}) | Month: {month} | Sheet: {sheetNameTimesheet}",
                    string.Empty, 0, ref boolVariable);

                Dts.TaskResult = (int)ScriptResults.Success;
            }
            catch (Exception ex)
            {
                Dts.Events.FireError(0, "Script Error",
                    $"Error: {ex.Message}",
                    string.Empty, 0);
                Dts.TaskResult = (int)ScriptResults.Failure;
            }
        }

        #region ScriptResults declaration
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion
    }
}]]></ProjectItem>
