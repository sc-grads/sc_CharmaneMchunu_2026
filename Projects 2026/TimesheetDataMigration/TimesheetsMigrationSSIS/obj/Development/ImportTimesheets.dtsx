              <ProjectItem
                Name="ScriptMain.cs"
                Encoding="UTF8"><![CDATA[#region Namespaces
using System;
using System.Data;
using System.Data.SqlClient;
using Microsoft.SqlServer.Dts.Runtime;
#endregion

namespace ST_MoveDataToMain
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        private bool fireAgain = false;

        public void Main()
        {
            try
            {
                Dts.Events.FireInformation(0, "Move Data",
                    "🚀 Starting ETL migration...", "", 0, ref fireAgain);

                string connectionString = BuildFreshConnectionString();

                using (SqlConnection conn = new SqlConnection(connectionString))
                {
                    conn.Open();
                    Dts.Events.FireInformation(0, "Move Data",
                        "🔌 Database connected", "", 0, ref fireAgain);

                    // Check if staging has data
                    int stagingCount = GetStagingCount(conn);

                    if (stagingCount == 0)
                    {
                        Dts.Events.FireInformation(0, "Move Data",
                            "⚠️ No data in staging to process!", "", 0, ref fireAgain);
                        Dts.TaskResult = (int)ScriptResults.Success;
                        return;
                    }

                    Dts.Events.FireInformation(0, "Move Data",
                        $"📊 Records in staging: {stagingCount}", "", 0, ref fireAgain);

                    // ================================================================
                    // DIRECT SQL - NO STORED PROCEDURES
                    // ================================================================
                    string sql = @"
                        DECLARE @BatchID INT;
                        DECLARE @BatchName NVARCHAR(200);
                        DECLARE @InsertedRows INT;
                        DECLARE @LeaveRows INT;
                        DECLARE @Context VARBINARY(128);

                        SET @BatchName = 'Staging_to_Main_' + CONVERT(NVARCHAR(20), GETDATE(), 112);

                        -- Start batch (BatchID is IDENTITY, auto-generated)
                        INSERT INTO dbo.MigrationBatch (
                            BatchName, 
                            StartDateTime, 
                            StatusCode, 
                            CreatedBy
                        ) VALUES (
                            @BatchName, 
                            GETUTCDATE(), 
                            'RUNNING', 
                            'SSIS_ETL'
                        );
                        
                        SET @BatchID = SCOPE_IDENTITY();
                        SET @Context = CAST(@BatchID AS VARBINARY(128));
                        SET CONTEXT_INFO @Context;

                        -- ============================================================
                        -- Move data to TimesheetEntry
                        -- ============================================================
                        INSERT INTO dbo.TimesheetEntry (
                            EmployeeID, WorkDate, Client, ProjectName, Description,
                            BillableType, TotalHours, TotalHoursOriginal, StartTime, EndTime,
                            Comments, IsLeave, LeaveType, CreatedDate, ModifiedDate, IsDeleted
                        )
                        SELECT 
                            EmployeeID,
                            TRY_CAST(Date AS DATE),
                            NULLIF(Client, ''),
                            NULLIF(ProjectName, ''),
                            NULLIF(Description, ''),
                            NULLIF(BillableType, ''),
                            TRY_CAST(TotalHours AS DECIMAL(10,2)),
                            TotalHours,
                            TRY_CAST(StartTime AS TIME),
                            TRY_CAST(EndTime AS TIME),
                            NULLIF(Comments, ''),
                            CASE WHEN UPPER(IsLeave) IN ('YES','Y','1') THEN 1 ELSE 0 END,
                            CASE WHEN UPPER(IsLeave) IN ('YES','Y','1') AND LeaveType IS NOT NULL AND LeaveType != '' AND LeaveType != 'NULL' THEN LeaveType ELSE NULL END,
                            GETDATE(), NULL, 0
                        FROM dbo.StagingTimesheet
                        WHERE IsProcessed = 0
                          AND EmployeeID IS NOT NULL
                          AND TRY_CAST(Date AS DATE) IS NOT NULL;

                        SET @InsertedRows = @@ROWCOUNT;

                        -- ============================================================
                        -- Move data to Leave
                        -- ============================================================
                        INSERT INTO dbo.Leave (
                            EmployeeID, LeaveType, StartDate, EndDate, LeaveDays,
                            Comments, IsApproved, CreatedDate, ModifiedDate
                        )
                        SELECT 
                            EmployeeID, LeaveType, TRY_CAST(Date AS DATE), TRY_CAST(Date AS DATE),
                            1, NULLIF(Comments, ''), 1, GETDATE(), NULL
                        FROM dbo.StagingTimesheet
                        WHERE IsProcessed = 0
                          AND UPPER(IsLeave) IN ('YES','Y','1')
                          AND LeaveType IS NOT NULL AND LeaveType != '' AND LeaveType != 'NULL'
                          AND LeaveType NOT LIKE '%Public%' AND LeaveType != 'Public Holiday'
                          AND TRY_CAST(Date AS DATE) IS NOT NULL;

                        SET @LeaveRows = @@ROWCOUNT;

                        -- ============================================================
                        -- Mark staging as processed
                        -- ============================================================
                        UPDATE dbo.StagingTimesheet
                        SET IsProcessed = 1, ProcessedDate = GETDATE()
                        WHERE IsProcessed = 0;

                        -- ============================================================
                        -- Update batch statistics
                        -- ============================================================
                        UPDATE dbo.MigrationBatch
                        SET TotalRecordsProcessed = TotalRecordsProcessed + @InsertedRows + @LeaveRows,
                            TotalRecordsInserted = TotalRecordsInserted + @InsertedRows
                        WHERE BatchID = @BatchID;

                        -- ============================================================
                        -- Complete batch
                        -- ============================================================
                        UPDATE dbo.MigrationBatch
                        SET EndDateTime = GETUTCDATE(),
                            StatusCode = 'SUCCESS'
                        WHERE BatchID = @BatchID;

                        -- Clear context info
                        SET CONTEXT_INFO 0x00000000;

                        -- Return results
                        SELECT 
                            @BatchID AS BatchID,
                            @InsertedRows AS TimesheetEntriesInserted,
                            @LeaveRows AS LeaveRecordsInserted;
                    ";

                    using (SqlCommand cmd = new SqlCommand(sql, conn))
                    {
                        cmd.CommandTimeout = 600;
                        using (SqlDataReader reader = cmd.ExecuteReader())
                        {
                            if (reader.Read())
                            {
                                int batchID = Convert.ToInt32(reader["BatchID"]);
                                int insertedRows = Convert.ToInt32(reader["TimesheetEntriesInserted"]);
                                int leaveRows = Convert.ToInt32(reader["LeaveRecordsInserted"]);

                                Dts.Events.FireInformation(0, "Move Data",
                                    $"✅ TimesheetEntry loaded: {insertedRows} rows", "", 0, ref fireAgain);
                                Dts.Events.FireInformation(0, "Move Data",
                                    $"✅ Leave loaded: {leaveRows} rows", "", 0, ref fireAgain);
                                Dts.Events.FireInformation(0, "Move Data",
                                    $"✅ Batch {batchID} completed successfully!", "", 0, ref fireAgain);
                            }
                        }
                    }
                }

                Dts.TaskResult = (int)ScriptResults.Success;
            }
            catch (SqlException sqlEx)
            {
                Dts.Events.FireError(0, "Move Data",
                    $"❌ SQL Error: {sqlEx.Message} (Number: {sqlEx.Number})", "", 0);
                Dts.TaskResult = (int)ScriptResults.Failure;
            }
            catch (Exception ex)
            {
                Dts.Events.FireError(0, "Move Data",
                    $"❌ Transaction failed: {ex.Message}", "", 0);
                Dts.TaskResult = (int)ScriptResults.Failure;
            }
        }

        #region Helper Methods

        private string BuildFreshConnectionString()
        {
            try
            {
                if (Dts.Connections.Contains("TimesheetConnection"))
                {
                    ConnectionManager cm = Dts.Connections["TimesheetConnection"];
                    object rawConnection = cm.AcquireConnection(Dts.Transaction);
                    string connString = cm.ConnectionString;
                    cm.ReleaseConnection(rawConnection);

                    if (!string.IsNullOrEmpty(connString))
                    {
                        return CleanConnectionString(connString);
                    }
                }

                return "Data Source=localhost;Initial Catalog=TimesheetDB;Integrated Security=SSPI;Connection Reset=True;Pooling=False;";
            }
            catch
            {
                return "Data Source=localhost;Initial Catalog=TimesheetDB;Integrated Security=SSPI;Connection Reset=True;Pooling=False;";
            }
        }

        private string CleanConnectionString(string connString)
        {
            if (string.IsNullOrEmpty(connString)) return connString;

            string[] removeKeywords = { "Provider=", "Auto Translate=", "Persist Security Info=", "OLE DB Services=" };
            foreach (string keyword in removeKeywords)
            {
                if (connString.Contains(keyword))
                {
                    string[] parts = connString.Split(';');
                    var cleanParts = new System.Collections.Generic.List<string>();
                    foreach (string part in parts)
                    {
                        if (!part.Trim().StartsWith(keyword, StringComparison.OrdinalIgnoreCase))
                        {
                            cleanParts.Add(part);
                        }
                    }
                    connString = string.Join(";", cleanParts);
                }
            }

            if (!connString.Contains("Data Source="))
                connString = "Data Source=localhost;" + connString;
            if (!connString.Contains("Integrated Security="))
                connString += ";Integrated Security=SSPI";
            if (!connString.Contains("Initial Catalog="))
                connString += ";Initial Catalog=TimesheetDB";
            if (!connString.Contains("Connection Reset="))
                connString += ";Connection Reset=True";
            if (!connString.Contains("Pooling="))
                connString += ";Pooling=False";

            return connString;
        }

        private int GetStagingCount(SqlConnection conn)
        {
            using (SqlCommand cmd = new SqlCommand(
                "SELECT COUNT(*) FROM dbo.StagingTimesheet WHERE IsProcessed = 0", conn))
            {
                return Convert.ToInt32(cmd.ExecuteScalar());
            }
        }

        #endregion

        enum ScriptResults
        {
            Success = DTSExecResult.Success,
            Failure = DTSExecResult.Failure
        }
    }
}]]></ProjectItem>
