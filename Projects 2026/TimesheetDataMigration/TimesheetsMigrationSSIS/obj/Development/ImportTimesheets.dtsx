          <ProjectItem
            Name="ScriptMain.cs"
            Encoding="UTF8"><![CDATA[#region Namespaces
using System;
using System.Data;
using Microsoft.SqlServer.Dts.Runtime;
using System.Windows.Forms;
#endregion

namespace ST_CreateDatabase
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        private bool boolVariable;

        public void Main()
        {
            try
            {
                // ============================================
                // PART 1: GENERATE BATCH ID
                // ============================================

                // Generate a unique BatchID for this run
                string batchId = Guid.NewGuid().ToString();
                Dts.Variables["User::BatchID"].Value = batchId;

                Dts.Events.FireInformation(0, "Initialize",
                    $"BatchID: {batchId} generated",
                    string.Empty, 0, ref boolVariable);

                // ============================================
                // PART 2: CREATE DATABASE SQL
                // ============================================

                // SQL to create TimesheetDB if it doesn't exist
                string createDatabaseSQL = @"
IF NOT EXISTS (SELECT * FROM sys.databases WHERE name = 'TimesheetDB')
BEGIN
    CREATE DATABASE TimesheetDB;
    PRINT '========================================';
    PRINT 'Database TimesheetDB created successfully.';
    PRINT '========================================';
END
ELSE
BEGIN
    PRINT '========================================';
    PRINT 'Database TimesheetDB already exists.';
    PRINT '========================================';
END

-- Switch to TimesheetDB
USE TimesheetDB;
GO

-- Print current database
PRINT 'Current database: ' + DB_NAME();
GO";

                Dts.Variables["User::CreateDatabaseSQL"].Value = createDatabaseSQL;

                // ============================================
                // PART 3: LOGGING
                // ============================================

                Dts.Events.FireInformation(0, "Create Database SQL",
                    "Database creation script prepared successfully",
                    string.Empty, 0, ref boolVariable);

                Dts.TaskResult = (int)ScriptResults.Success;
            }
            catch (Exception ex)
            {
                Dts.Events.FireError(0, "Script Error",
                    $"Error: {ex.Message}",
                    string.Empty, 0);
                Dts.TaskResult = (int)ScriptResults.Failure;
            }
        }

        #region ScriptResults declaration
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion
    }
}]]></ProjectItem>
