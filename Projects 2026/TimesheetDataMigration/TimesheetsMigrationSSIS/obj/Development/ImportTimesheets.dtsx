  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\Create Database"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Creates TimesheetDB database"
      DTS:DTSID="{44D02495-27B6-4F7C-BD49-B0BD7618BC05}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Create Database"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{C1FC2EBB-68B4-4BE8-9C60-9A21F0C6C7E0}"
          SQLTask:SqlStatementSource="-- =============================================&#xA;-- CREATE DATABASE IF NOT EXISTS&#xA;-- =============================================&#xA;IF NOT EXISTS (SELECT * FROM sys.databases WHERE name = 'TimesheetDB')&#xA;BEGIN&#xA;    CREATE DATABASE TimesheetDB;&#xA;    PRINT 'Database TimesheetDB created successfully.';&#xA;END&#xA;ELSE&#xA;BEGIN&#xA;    PRINT 'Database TimesheetDB already exists.';&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Create Tables"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{675AEBA2-DF89-47E3-81CC-D5D7034B4483}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Create Tables"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{162FBE0A-C9D2-4D5C-B10A-713428FCAD7D}"
          SQLTask:SqlStatementSource="USE TimesheetDB;&#xA;GO&#xA;&#xA;-- =============================================&#xA;-- DROP TABLES (if they exist)&#xA;-- =============================================&#xA;DROP TABLE IF EXISTS AuditLog;&#xA;DROP TABLE IF EXISTS Leave;&#xA;DROP TABLE IF EXISTS TimesheetEntry;&#xA;DROP TABLE IF EXISTS EmployeeDetails;&#xA;DROP TABLE IF EXISTS StagingTimesheet;&#xA;GO&#xA;&#xA;-- =============================================&#xA;-- CREATE ALL TABLES&#xA;-- =============================================&#xA;&#xA;-- 1. EMPLOYEE DETAILS&#xA;CREATE TABLE dbo.EmployeeDetails&#xA;(&#xA;    EmployeeID INT IDENTITY(1001,1) PRIMARY KEY,&#xA;    EmployeeName NVARCHAR(100) NOT NULL,&#xA;    EmployeeSurname NVARCHAR(100) NOT NULL,&#xA;    CreatedDate DATETIME DEFAULT GETDATE()&#xA;);&#xA;PRINT '✅ Table EmployeeDetails created.';&#xA;GO&#xA;&#xA;-- 2. STAGING TIMESHEET&#xA;CREATE TABLE dbo.StagingTimesheet&#xA;(&#xA;    StagingID INT IDENTITY(1,1) PRIMARY KEY,&#xA;    EmployeeID INT NOT NULL,&#xA;    Date NVARCHAR(255),&#xA;    DayOfWeek NVARCHAR(255),&#xA;    Client NVARCHAR(255),&#xA;    ProjectName NVARCHAR(255),&#xA;    Description NVARCHAR(255),&#xA;    BillableType NVARCHAR(255),&#xA;    Comments NVARCHAR(255),&#xA;    TotalHours NVARCHAR(255),&#xA;    StartTime NVARCHAR(255),&#xA;    EndTime NVARCHAR(255),&#xA;    IsLeave NVARCHAR(255),&#xA;    LeaveType NVARCHAR(255),&#xA;    Month NVARCHAR(255),&#xA;    SourceFile NVARCHAR(255),&#xA;    OvertimeHours NVARCHAR(255),&#xA;    LoadDate DATETIME DEFAULT GETDATE()&#xA;);&#xA;PRINT '✅ Table StagingTimesheet created.';&#xA;GO&#xA;&#xA;-- 3. TIMESHEET ENTRY (WITH TotalHours as NVARCHAR to keep original format)&#xA;CREATE TABLE dbo.TimesheetEntry&#xA;(&#xA;    EntryID INT IDENTITY(1,1) PRIMARY KEY,&#xA;    EmployeeID INT NOT NULL,&#xA;    WorkDate DATE,&#xA;    Client NVARCHAR(200),&#xA;    ProjectName NVARCHAR(500),&#xA;    Description NVARCHAR(2000),&#xA;    BillableType NVARCHAR(50),&#xA;    TotalHours NVARCHAR(20),  -- Keep original HH:MM:SS format&#xA;    StartTime NVARCHAR(20),&#xA;    EndTime NVARCHAR(20),&#xA;    Comments NVARCHAR(2000),&#xA;    IsLeave BIT DEFAULT 0,&#xA;    CreatedDate DATETIME DEFAULT GETDATE(),&#xA;    &#xA;    CONSTRAINT FK_TimesheetEntry_Employee &#xA;        FOREIGN KEY(EmployeeID) &#xA;        REFERENCES dbo.EmployeeDetails(EmployeeID)&#xA;);&#xA;PRINT '✅ Table TimesheetEntry created (TotalHours keeps original format).';&#xA;GO&#xA;&#xA;-- 4. LEAVE&#xA;CREATE TABLE dbo.Leave&#xA;(&#xA;    LeaveID INT IDENTITY(1,1) PRIMARY KEY,&#xA;    EmployeeID INT NOT NULL,&#xA;    LeaveType NVARCHAR(50),&#xA;    StartDate DATE,&#xA;    EndDate DATE,&#xA;    LeaveDays DECIMAL(10,2),&#xA;    Comments NVARCHAR(500),&#xA;    CreatedDate DATETIME DEFAULT GETDATE(),&#xA;    &#xA;    CONSTRAINT FK_Leave_Employee &#xA;        FOREIGN KEY(EmployeeID) &#xA;        REFERENCES dbo.EmployeeDetails(EmployeeID)&#xA;);&#xA;PRINT '✅ Table Leave created.';&#xA;GO&#xA;&#xA;-- 5. AUDIT LOG (WITHOUT EmployeeID)&#xA;CREATE TABLE dbo.AuditLog&#xA;(&#xA;    AuditID INT IDENTITY(1,1) PRIMARY KEY,&#xA;    ActionType NVARCHAR(50),&#xA;    TableName NVARCHAR(100),&#xA;    Description NVARCHAR(500),&#xA;    ActionDate DATETIME DEFAULT GETDATE()&#xA;);&#xA;PRINT '✅ Table AuditLog created.';&#xA;GO&#xA;&#xA;-- =============================================&#xA;-- CREATE INDEXES&#xA;-- =============================================&#xA;CREATE INDEX IX_TimesheetEntry_EmployeeID ON TimesheetEntry (EmployeeID);&#xA;CREATE INDEX IX_TimesheetEntry_WorkDate ON TimesheetEntry (WorkDate);&#xA;CREATE INDEX IX_Leave_EmployeeID ON Leave (EmployeeID);&#xA;PRINT '✅ Indexes created.';&#xA;GO&#xA;&#xA;-- =============================================&#xA;-- INSERT EMPLOYEES&#xA;-- =============================================&#xA;INSERT INTO EmployeeDetails (EmployeeName, EmployeeSurname)&#xA;VALUES &#xA;('Buhle', 'Mukhuba'),&#xA;('Charmane', 'Mchunu'),&#xA;('Jabulane', 'Poulo'),&#xA;('Kayden', 'Padayachee'),&#xA;('Lwazisile', 'Mhlambi'),&#xA;('Rushil', 'Jivan'),&#xA;('Shriya', 'Hariparsad'),&#xA;('Teolan', 'Govender');&#xA;PRINT '✅ Employees inserted.';&#xA;GO&#xA;&#xA;-- =============================================&#xA;-- VERIFY&#xA;-- =============================================&#xA;SELECT 'EmployeeDetails' as TableName, COUNT(*) as Count FROM EmployeeDetails&#xA;UNION ALL&#xA;SELECT 'StagingTimesheet', COUNT(*) FROM StagingTimesheet&#xA;UNION ALL&#xA;SELECT 'TimesheetEntry', COUNT(*) FROM TimesheetEntry&#xA;UNION ALL&#xA;SELECT 'Leave', COUNT(*) FROM Leave&#xA;UNION ALL&#xA;SELECT 'AuditLog', COUNT(*) FROM AuditLog;&#xA;GO&#xA;&#xA;PRINT '========================================';&#xA;PRINT '✅ ALL TABLES CREATED SUCCESSFULLY!';&#xA;PRINT '========================================';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
